PORT=XXXX
NEXT_PUBLIC_BACKEND_URL=http://localhost:XXXX

# ── Public landing page ───────────────────────────────────────────────────────
# What the public landing page shows. Comma-separated, in display order.
#
# The product is offered in two markets — Kenya and the United States — so these
# default to those two. The other jurisdiction profiles still exist as dormant
# config; listing one here would advertise a market the product does not price.
#
# NEXT_PUBLIC_LANDING_MARKETS — ISO-3166-1 alpha-2 market codes. Drives the
# hero market switcher, the footer chips and the demo market tabs. The profiles
# themselves live in `frontend/components/landing/data/landingData.ts` (a copy of
# `backend/src/prisma/jurisdictions.ts` — the frontend must not import backend
# source). An unknown code is dropped with a console warning and the rest still
# render.
#
# NEXT_PUBLIC_LANDING_CURRENCIES — ISO-4217 codes for the pricing currency
# switcher. One per currency the enabled markets bill in. Leave the line out and
# the currencies the enabled markets bill in are used instead.
#
# NEXT_PUBLIC_* values are inlined at build time — change them and rebuild.
NEXT_PUBLIC_LANDING_MARKETS=KE,US
NEXT_PUBLIC_LANDING_CURRENCIES=KES,USD

# ── Demo data seed ────────────────────────────────────────────────────────────
# Read by `npm run db:seed:demo` and `npx prisma db seed` only. Leave every one
# of them unset and the seed behaves exactly as before.
#
# NEXT_DEMO_COUNTRY — the *primary* market, by ISO-3166-1 alpha-2. It is the market
# that gets the two full demo organizations (Rohi with the whole dataset,
# Westhill as the starter). Every other market gets a market organization
# instead. Default: KE.
#
# NEXT_DEMO_COUNTRIES — the markets to seed, comma-separated ISO-3166-1 alpha-2
# codes. Default: KE,US (the two markets the product sells into). Every
# jurisdiction profile still seeds when named explicitly, so a subset like
# KE,ZA,IN works too. An unknown code fails the seed loudly rather than being
# silently skipped.
#
# NEXT_DEMO_MODE=multi — additionally creates the "Transatlantic Property Group"
# enterprise organization with a Nairobi branch and a New York branch.
#
# NEXT_DEMO_COUNTRY=KE
# NEXT_DEMO_COUNTRIES=KE,US
# NEXT_DEMO_MODE=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
