// This is your Prisma schema file for Real Estate Property Management SaaS
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// SYSTEM & AUDIT
// ============================================

// Organization/Tenant model - represents each company/organization in the system
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique // For URL identification

  // Subdomain configuration
  subdomain    String? @unique // e.g., "company1" from company1.tuhame.co.ke
  customDomain String? @unique // e.g., "app.company1.com"

  isActive Boolean @default(true)

  // Subscription
  plan          String @default("FREE") // FREE, STARTER, PROFESSIONAL, ENTERPRISE
  maxUsers      Int    @default(3)
  maxProperties Int    @default(10)

  // Branding (optional white-label)
  logoUrl      String?
  primaryColor String?

  // Contact
  contactEmail String?
  contactPhone String?

  // Legal & tax profile
  legalName String?
  taxId     String?

  // ── Tax jurisdiction ────────────────────────────────────────────────────
  // The rules engine is country-agnostic: nothing in the code assumes Kenya.
  // An organization declares where it is taxed, and the `TaxRule` rows for that
  // jurisdiction do the rest. `taxCountryCode` is ISO-3166-1 alpha-2 (KE, GB,
  // DE, US, ...); `taxRegionCode` is the optional sub-national level that many
  // countries actually tax by (US state, German Bundesland, Brazilian estado).
  taxCountryCode        String? @db.Char(2)
  taxRegionCode         String?
  // VAT/GST/sales-tax registration number, printed on invoices where the law
  // requires it. Separate from `taxId`, which is the company registration.
  taxRegistrationNumber String?

  // Regional defaults (System Settings) — money amounts still carry their
  // own currency per record; these are the org-level defaults.
  currency String @default("KES")
  timezone String @default("Africa/Nairobi")

  // Relationships
  users                      User[]
  properties                 Property[]
  tenants                    Tenant[]
  landlords                  Landlord[]
  leases                     RentalAgreement[]
  moveOutRequests            MoveOutRequest[]
  invoices                   Invoice[]
  payments                   Payment[]
  receipts                   Receipt[]
  auditLogs                  AuditLog[]
  branches                   Branch[]
  roles                      Role[]
  documents                  Document[]
  leads                      Lead[]
  contacts                   Contact[]
  communicationLogs          CommunicationLog[]
  saleTransactions           SaleTransaction[]
  commissions                Commission[]
  leaseTemplates             LeaseTemplate[]
  inspectionReports          InspectionReport[]
  tenantRequests             TenantRequest[]
  ownerStatements            OwnerStatement[]
  landlordPayouts            LandlordPayout[]
  landlordCharges            LandlordCharge[]
  accounts                   Account[]
  journalEntries             JournalEntry[]
  customerCredits            CustomerCredit[]
  paymentRefunds             PaymentRefund[]
  creditNotes                CreditNote[]
  taxRules                   TaxRule[]
  suppliers                  Supplier[]
  supplierBills              SupplierBill[]
  billPayments               BillPayment[]
  supplierCredits            SupplierCredit[]
  recurringBillingRuns       RecurringBillingRun[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  notificationChannelConfigs NotificationChannelConfig[]
  // Module 18 — Workflow Engine
  workflowDefinitions        WorkflowDefinition[]
  workflowInstances          WorkflowInstance[]
  workflowDelegations        WorkflowDelegation[]
  // Module 9 — Maintenance
  workOrders                 WorkOrder[]
  workOrderTasks             WorkOrderTask[]
  assets                     Asset[]
  pmSchedules                PreventiveMaintenanceSchedule[]
  pmRuns                     PreventiveMaintenanceRun[]
  // Module 10 — Procurement
  purchaseRequests           PurchaseRequest[]
  purchaseRequestLines       PurchaseRequestLine[]
  rfqs                       Rfq[]
  rfqInvitations             RfqInvitation[]
  rfqQuotes                  RfqQuote[]
  rfqQuoteLines              RfqQuoteLine[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderLines         PurchaseOrderLine[]
  goodsReceipts              GoodsReceipt[]
  goodsReceiptLines          GoodsReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([subdomain])
  @@map("organizations")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String
  lastName  String
  phone     String?

  // Authentication
  passwordHash String

  // Role & Permissions
  role UserRole @default(USER)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Tenant portal identity (Module 5, auth work in Module 1).
  //
  // Set only for self-service portal logins: such a user is a *resident* of
  // exactly one tenant record, and every /portal endpoint derives its scope
  // from this link rather than from anything the client sends. Staff users
  // leave it null and keep organization-scoped access.
  portalTenantId String?
  portalTenant   Tenant? @relation("TenantPortalUsers", fields: [portalTenantId], references: [id], onDelete: SetNull)
  isActive       Boolean @default(true)
  emailVerified  Boolean @default(false)

  // Audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Password reset flow
  resetPasswordToken   String? // hashed token for password reset
  resetPasswordExpires DateTime?

  // TOTP multi-factor auth (mfaSecret holds the base32 TOTP seed; only
  // populated while mfaEnabled is true)
  mfaSecret  String?
  mfaEnabled Boolean @default(false)

  auditLogs               AuditLog[]
  sessions                Session[]
  roleAssignments         RoleAssignment[]
  uploadedDocuments       Document[]
  assignedLeads           Lead[]                   @relation("UserAssignedLeads")
  loggedCommunications    CommunicationLog[]       @relation("UserLoggedCommunications")
  sales                   SaleTransaction[]        @relation("UserSales")
  commissions             Commission[]             @relation("UserCommissions")
  approvedCommissions     Commission[]             @relation("UserApprovedCommissions")
  approvedDeductions      MoveOutDeduction[]
  completedInspections    InspectionReport[]
  refundedMoveOuts        MoveOutRequest[]
  decidedTenantRequests   TenantRequest[]          @relation("UserDecidedTenantRequests")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // Module 18 — Workflow Engine: every "who did what to this approval" pointer.
  startedWorkflows       WorkflowInstance[]   @relation("UserStartedWorkflows")
  assignedWorkflowSteps  WorkflowStep[]       @relation("UserAssignedWorkflowSteps")
  actedWorkflowSteps     WorkflowStep[]       @relation("UserActedWorkflowSteps")
  workflowEventActors    WorkflowEvent[]      @relation("UserWorkflowEventActors")
  workflowEventDelegates WorkflowEvent[]      @relation("UserWorkflowEventDelegates")
  delegatedApprovalsOut  WorkflowDelegation[] @relation("UserWorkflowDelegatedFrom")
  delegatedApprovalsIn   WorkflowDelegation[] @relation("UserWorkflowDelegatedTo")

  // Module 9 — Maintenance: who is on the job, who raised it, who ticked a task.
  assignedWorkOrders      WorkOrder[]                     @relation("UserAssignedWorkOrders")
  raisedWorkOrders        WorkOrder[]                     @relation("UserRaisedWorkOrders")
  completedWorkOrderTasks WorkOrderTask[]                 @relation("UserCompletedWorkOrderTasks")
  assignedPmSchedules     PreventiveMaintenanceSchedule[] @relation("UserPmSchedules")

  // Module 10 — Procurement: who asked, who raised the RFQ, who raised the
  // order, who signed for the goods, who decided the request.
  requestedPurchaseRequests PurchaseRequest[] @relation("UserRequestedPurchases")
  decidedPurchaseRequests   PurchaseRequest[] @relation("UserDecidedPurchaseRequests")
  raisedRfqs                Rfq[]             @relation("UserRaisedRfqs")
  raisedPurchaseOrders      PurchaseOrder[]   @relation("UserRaisedPurchaseOrders")
  receivedPurchaseOrders    GoodsReceipt[]    @relation("UserReceivedPurchaseOrders")

  // Status
  @@index([portalTenantId])
  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([resetPasswordToken])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROPERTY_MANAGER
  // Added in Module 5: the seeded Leasing Officer role had no UserRole counterpart,
  // so it could be granted permissions but never held. See master doc issue 48.
  LEASING_OFFICER
  ACCOUNTANT
  // Module 9: the seeded Maintenance Manager and Technician roles had the same
  // problem — permissions nobody could hold, and a work order with nobody to
  // assign it to. Same fix as LEASING_OFFICER, for the same reason.
  MAINTENANCE_MANAGER
  TECHNICIAN
  // Module 10: the seeded Procurement Officer role had exactly the same hole as
  // Leasing Officer and the two maintenance roles — permissions nobody could
  // hold, and a purchase request with nobody who is allowed to raise the RFQ.
  PROCUREMENT_OFFICER
  USER
}

model AuditLog {
  id String @id @default(cuid())

  // The acting user. Nullable so that deleting a user does not fail on
  // audit rows (an accountant cleaning up a departing colleague, for
  // example). The actor's identity remains preserved in `details`.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Tenant scoping: the organization the acting user belonged to at the
  // time of the action. NULL for platform-level actions (SUPER_ADMIN).
  // Denormalized on purpose so audit queries can filter by tenant without
  // a join through the entity being audited.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  action   String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity   String // Property, Unit, Lease, Invoice, etc.
  entityId String // The ID of the affected record

  details String? @db.Text // JSON or text description of changes

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Server-side session record backing the httpOnly auth cookie.
// Revoking a session (logout / revoke-others / password reset) sets
// revokedAt; the JWT strategy rejects any token whose jti maps to a
// revoked or expired session, which makes "kill this device" and
// "kill all other devices" real rather than cosmetic.
model Session {
  id     String @id @default(cuid())
  jti    String @unique // JWT "id" claim; one row per issued token
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Denormalized for cheap audit/session reporting; sourced from the user
  // at login time.
  organizationId String?

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Organization branch/office (Module 1: Core Platform). Tenant-scoped.
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  code    String?
  address String?
  city    String?
  phone   String?
  email   String?

  isActive Boolean @default(true)

  properties Property[]
  leads      Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("branches")
}

// Structured RBAC role. `organizationId = null` marks a system role
// (available to every organization); non-null marks an org-specific role.
// `permissions` is a JSON document of the shape:
//   { "all": boolean?, "modules": { "<module>": { "view": b, "create": b, "update": b, "delete": b } } }
// where <module> is one of: properties, units, landlords, tenants, leases,
// moveouts, invoices, payments, receipts, users, audit, settings,
// organizations, branches, documents.
model Role {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false)
  permissions Json

  assignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([name])
  @@map("roles")
}

// User ↔ Role link (table `user_roles`). The model is not named `UserRole`
// because that name is already taken by the legacy `UserRole` enum.
model RoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// Document center (Module 1: Core Platform). Polymorphic: entityType/entityId
// point at any tenant entity (Property, Unit, Tenant, Invoice, ...).
// `fileUrl` is the storage key/URL resolved by the configured storage driver
// (local disk by default, S3/MinIO when STORAGE_DRIVER=s3).
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String
  sizeBytes  Int    @default(0)

  // Re-uploading the same file for the same (entityType, entityId, fileName)
  // creates a new row with version = max + 1 instead of overwriting.
  version Int @default(1)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ============================================
// CORE ENTITIES (LANDLORDS & PROPERTIES)
// ============================================

model Landlord {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  status           TenantStatus @default(ACTIVE)
  email            String?
  phone            String?
  alternativePhone String?

  // Address
  address    String? @db.Text
  city       String?
  country    String?
  postalCode String?

  // Banking Details
  bankName      String?
  bankBranch    String?
  accountName   String?
  accountNumber String?

  // Tax Information
  taxPin        String?
  vatRegistered Boolean @default(false)

  // Management agreement (Module 6). The fee is deducted from the owner
  // statement: PERCENTAGE applies `managementFeeRate` (a percentage) to the rent
  // actually collected in the period, FIXED deducts `managementFeeAmount` once
  // per statement period.
  managementFeeType   ManagementFeeType @default(PERCENTAGE)
  managementFeeRate   Decimal           @default(0) @db.Decimal(5, 2)
  managementFeeAmount Decimal           @default(0) @db.Decimal(14, 2)

  // Free-form owner notes / instructions for whoever runs the account
  notes String? @db.Text

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
  properties      Property[]
  invoices        Invoice[]
  receipts        Receipt[]
  credits         CustomerCredit[] @relation("LandlordCredits")
  creditNotes     CreditNote[]     @relation("LandlordCreditNotes")
  ownerStatements OwnerStatement[]
  payouts         LandlordPayout[]
  charges         LandlordCharge[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([email])
  @@index([organizationId])
  @@map("landlords")
}

// ---------------------------------------------------------------------------
// Owner statements and payouts (Module 6: Landlord Management)
// ---------------------------------------------------------------------------

enum ManagementFeeType {
  PERCENTAGE
  FIXED
}

enum OwnerStatementStatus {
  DRAFT
  ISSUED
  SETTLED
  VOID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ChargeCategory {
  MAINTENANCE
  REPAIR
  UTILITIES
  INSURANCE
  TAX
  LEGAL
  OTHER
}

/// One period's owner account: what was collected, what it cost to run, what
/// the management fee was, and what is left to pay the owner.
///
/// Every money column is a frozen snapshot taken at generation time, and the
/// two `*Lines` columns hold the itemised breakdown. That is deliberate: an
/// ISSUED statement is a document the owner was sent, so it must keep
/// reconciling to its own lines even after an invoice or charge underneath it
/// is edited. Re-issuing means generating a new statement, not rewriting this.
model OwnerStatement {
  id              String        @id @default(cuid())
  statementNumber String        @unique
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId      String
  landlord        Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  currency    String   @default("KES")

  // Derived money (never typed in by hand).
  grossIncome    Decimal @db.Decimal(14, 2) // rent actually collected in the period
  expenses       Decimal @default(0) @db.Decimal(14, 2) // owner charges levied in the period
  managementFee  Decimal @default(0) @db.Decimal(14, 2)
  carriedForward Decimal @default(0) @db.Decimal(14, 2) // unpaid balance brought in from earlier statements
  netPayout      Decimal @db.Decimal(14, 2) // grossIncome - expenses - managementFee - carriedForward

  status   OwnerStatementStatus @default(DRAFT)
  issuedAt DateTime?
  notes    String?              @db.Text

  // Itemised snapshots: [{ ref, description, property, amount, ... }]
  incomeLines  Json
  expenseLines Json

  payouts LandlordPayout[]
  charges LandlordCharge[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  generatedBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("owner_statements")
}

/// Money leaving the company for an owner. v1 records the intent and its
/// outcome — the transfer itself is executed in the bank and the reference is
/// recorded here — because there is no banking integration to call.
model LandlordPayout {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId     String
  landlord       Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  // A payout usually settles one statement; a payout without one (arrears
  // catch-up, goodwill payment) is allowed.
  ownerStatementId String?
  ownerStatement   OwnerStatement? @relation(fields: [ownerStatementId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("KES")
  method   PaymentMethod @default(BANK_TRANSFER)
  status   PayoutStatus  @default(PENDING)

  reference     String? // bank transfer / cheque reference
  scheduledFor  DateTime?
  paidAt        DateTime?
  failureReason String?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([ownerStatementId])
  @@index([status])
  @@map("landlord_payouts")
}

/// A cost charged to an owner: repairs carried out, utilities the company
/// advanced, insurance, legal fees. Deducted from the next owner statement.
///
/// Deliberately not a general `Expense` table — Finance & Accounting (Module 7)
/// owns the general ledger and will own expenses. This is the owner-facing
/// slice of that idea: only amounts actually charged to a landlord, so an
/// owner statement can be built today without pretending the GL exists.
model LandlordCharge {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId     String
  landlord       Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  category    ChargeCategory
  description String
  amount      Decimal        @db.Decimal(14, 2)
  chargeDate  DateTime       @default(now())

  // Set once the charge has been rolled into an ISSUED statement; it then
  // belongs to that statement and must not be edited or deleted.
  ownerStatementId String?
  ownerStatement   OwnerStatement? @relation(fields: [ownerStatementId], references: [id], onDelete: SetNull)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([chargeDate])
  @@index([ownerStatementId])
  @@map("landlord_charges")
}

model Property {
  id           String    @id @default(cuid())
  code         String    @unique // Property Code
  name         String // Property Name
  dateAcquired DateTime? // Date Acquired
  lrNumber     String? // LR Number (Land Registry Number)

  // Lifecycle status (Module 2). Distinct from `type`/`category`, which
  // classify the asset. ARCHIVED hides the property from default listings.
  status PropertyStatus @default(ACTIVE)

  agencyRole    String? // Managing | Letting | Both
  category      String?
  type          String?
  specification String? // Multi-unit/Multi-Space

  // Location & Address
  country    String?
  estateArea String? // Estate/Area
  areaRegion String? // Area/Region
  roadStreet String? // Road/Street

  // Property Classification
  multiStoryType String? // Multi Story Type
  numberOfFloors Int? // No. Of Floors

  // Geographic Coordinates
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Notes & Contact Info
  notes               String? @db.Text // Property notes/description
  specificContactInfo String? @db.Text // Specific contact information

  // Relationships
  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Owning branch/office (Module 1 Branch → Module 2 Property). Nullable so
  // properties created before branches existed keep working.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Leads that asked about this property (Module 3 CRM).
  leads Lead[] @relation("PropertyLeads")

  // Open sales against this property (Module 4).
  sales SaleTransaction[] @relation("PropertySales")

  // Accounting & Billing Configuration
  accountLedgerType     String? // e.g., "Property Control Ledger in GL"
  primaryBankAccount    String? // Primary Bank/Account/Operating Account
  alternativeTaxPin     String? // Alternative Tax PIN
  propertyWorkingTaxPin String? // Property Working Tax PIN
  invoicePaymentInfo    String? @db.Text
  holderPaymentTerms    String? @db.Text

  // MPESA Configuration
  mpesaPropertyPayNumber   String?
  disableMpesaStkPush      Boolean @default(false)
  disableMpesaStkNarration Boolean @default(false)

  // Counters
  tenantReceiptAccountCodeCounter Int? @default(0)

  // Rent Penalty Configuration
  lpgExempted       Boolean @default(false)
  penaltyChargeMode String? // Penalty Charge Mode
  penaltyDay        Int? // Penalty Day

  // Landlord Banking Details
  landlordDrawerBank    String?
  landlordBankBranch    String?
  landlordAccountName   String?
  landlordAccountNumber String?

  // Communication Preferences
  exemptAllSms     Boolean @default(false)
  exemptInvoiceSms Boolean @default(false)
  exemptGeneralSms Boolean @default(false)
  exemptHagueSms   Boolean @default(false)
  exemptBalanceSms Boolean @default(false)

  exemptAllEmail     Boolean @default(false)
  exemptInvoiceEmail Boolean @default(false)
  exemptGeneralEmail Boolean @default(false)
  exemptReceiptEmail Boolean @default(false)
  exemptBalanceEmail Boolean @default(false)

  // Other Preferences
  excludeInTwoSummaryReport Boolean @default(false)

  // Related entities
  units            Unit[]
  standingCharges  PropertyStandingCharge[]
  securityDeposits PropertySecurityDeposit[]
  amenities        PropertyAmenity[]
  landlordCharges  LandlordCharge[]
  // Module 9: the equipment this building actually owns, and the faults found
  // against it. Both are SetNull on the way in, so retiring a property row does
  // not delete its maintenance history.
  assets           Asset[]
  workOrders       WorkOrder[]               @relation("PropertyWorkOrders")

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([landlordId])
  @@index([code])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@map("properties")
}

// Lifecycle status of a property record (Module 2: Property Management).
enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================
// UNITS & SPACES
// ============================================

model Unit {
  id       String  @id @default(cuid())
  code     String  @unique // Unit/Space No.
  name     String // Unit Name/Number
  sequence Int? // Unit Sequence
  type     String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Pricing
  quotedPrice     Decimal? @db.Decimal(10, 2)
  baseRent        Decimal? @db.Decimal(10, 2) // Market Rent
  basePerUnitArea Decimal? @db.Decimal(10, 2)
  currency        String   @default("KES")

  // Area/Space Management
  areaSqFt   Decimal? @db.Decimal(10, 2)
  chargePlan String?

  // Unit Details & Specifications
  floor            Int?
  bedrooms         Int? // Bedroom(s)
  bathrooms        Int? // Bathroom(s)
  furnished        Boolean @default(false)
  outSourceParking String? // Out Source/Parking

  // Ownership
  ownerOccupied Boolean @default(false)

  // Utility Account & Billing Numbers
  electricityAcno    String?
  waterAcno          String?
  electricityMeethno String?
  waterMeethno       String?

  // Letting Details
  takeOnLettingDate DateTime?

  // Tenant/Resident Code Counter
  tenantResidentCodeCounter Int? @default(0)

  // Notes
  apartmentNotes String? @db.Text

  // Status
  status UnitStatus @default(VACANT)

  // Relationships
  rentalAgreements RentalAgreement[]
  serviceCharges   UnitServiceCharge[]
  meterNumbers     UnitMeterNumber[]
  features         UnitFeature[]
  inspections      InspectionReport[]
  // Module 9: faults reported against this unit, plus any unit-level equipment.
  workOrders       WorkOrder[]
  assets           Asset[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([propertyId])
  @@index([status])
  @@map("units")
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model UnitServiceCharge {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  serviceUtilityAmenity String // Service/Charge/Utility/Amenity name
  costPerArea           Decimal? @db.Decimal(10, 2)
  totalCost             Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@map("unit_service_charges")
}

model UnitMeterNumber {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  meterNo      String
  readingSetup String? // Reading setup configuration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@map("unit_meter_numbers")
}

model UnitFeature {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name        String
  featureType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@map("unit_features")
}

// Structured amenities (Module 2). Replaces free-text amenity blobs so the
// list UI can filter/search on them; `category` groups them (e.g. "Security",
// "Parking", "Utilities") for report grouping.
model PropertyAmenity {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name     String
  category String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("property_amenities")
}

// ============================================
// CHARGES & DEPOSITS
// ============================================

model PropertyStandingCharge {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  chargeUtility    String // Charge/Utility name
  chargeMode       String // Billing mode
  billingCurrency  String   @default("KES")
  costPerArea      Decimal? @db.Decimal(10, 2)
  chargeValue      Decimal  @db.Decimal(10, 2)
  vatRate          Decimal? @db.Decimal(5, 2) // VAT percentage
  excludesWithRent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_standing_charges")
}

model PropertySecurityDeposit {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  month               String // Month identifier
  value               Decimal @db.Decimal(10, 2)
  ofRentBillingAmount Boolean @default(false)
  ofInitialRent       Boolean @default(false)
  ofLastEscalation    Boolean @default(false)
  excludesWithRent    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_security_deposits")
}

// ============================================
// TENANTS & LEASES
// ============================================

model Tenant {
  id            String @id @default(cuid())
  accountNumber String @unique // Account Number
  code          String @unique

  // Tenant Type & Personal Info
  tenantType String? // Individual, Corporate, etc.
  surname    String // Surname
  otherNames String? // Other Name(s)
  gender     String? // Gender

  // Status
  status TenantStatus @default(ACTIVE)

  // Contact Information
  email            String?
  phone            String // Mobile Number
  town             String?
  sendMobileNumber Boolean @default(false)

  // Identification & Tax
  idNoRegNo String? // ID No./REG No.
  taxPin    String? // Tax PIN

  // Address
  postalAddress String? @db.Text
  postalCode    String?
  country       String?

  // Photo
  photoUrl String? // URL to uploaded photo

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // CRM link (Module 3). A Tenant stays its own table — it is the lease party
  // with an account number, tax PIN and rent history — and is linked to the
  // shared people directory so contact history is visible from the tenant and
  // vice versa. One contact maps to at most one tenant.
  contactId String?  @unique
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Self-service portal logins that belong to this tenant.
  portalUsers User[] @relation("TenantPortalUsers")

  // Requests the resident submitted through the portal.
  requests TenantRequest[]

  // Relationships
  rentalAgreements  RentalAgreement[]
  emergencyContacts TenantEmergencyContact[]
  receipts          Receipt[]
  moveOutRequests   MoveOutRequest[]
  credits           CustomerCredit[]         @relation("TenantCredits")
  notifications     Notification[]           @relation("TenantNotifications")
  creditNotes       CreditNote[]             @relation("TenantCreditNotes")
  // Module 9: maintenance issues this resident reported. SetNull rather than
  // Cascade — a resident record is financial history and outlives their tenancy.
  workOrders        WorkOrder[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountNumber])
  @@index([code])
  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@map("tenants")
}

model TenantEmergencyContact {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactName  String
  relationship String?
  phone        String?
  email        String?

  // Priority (1 = primary, 2 = secondary)
  priority Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_emergency_contacts")
}

model RentalAgreement {
  id   String @id @default(cuid())
  code String @unique

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Agreement Type
  agreementType AgreementType @default(RENTAL)

  // Agreement Terms
  startDate  DateTime
  endDate    DateTime?
  rentAmount Decimal   @db.Decimal(10, 2)
  currency   String    @default("KES")
  paymentDay Int       @default(1)

  // Term Duration
  termMonths Int? // Lease term in months (null for rental)

  // Security Deposit
  securityDeposit Decimal? @db.Decimal(10, 2)

  // Lease-specific fields (commercial)
  escalationRate   Decimal? @db.Decimal(5, 2) // % increase per year
  escalationMonth  Int? // Month when rent escalates
  noticePeriodDays Int? // Notice period for termination

  // Status
  status AgreementStatus @default(DRAFT)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
  invoices        Invoice[]
  payments        Payment[]
  commissions     Commission[]
  moveOutRequests MoveOutRequest[]

  // Renewal chain (Module 5): a renewed lease points at its successor and the
  // successor points back, so the full history of a unit's tenancies is one
  // query instead of a date-range reconstruction.
  renewedToId   String?          @unique
  renewedTo     RentalAgreement? @relation("LeaseRenewals", fields: [renewedToId], references: [id], onDelete: SetNull)
  renewedFromId String?
  renewedFrom   RentalAgreement? @relation("LeaseRenewals")

  // Inspections attached to this tenancy (move-in, periodic, move-out)
  inspections InspectionReport[]

  // Resident requests raised against this tenancy
  tenantRequests TenantRequest[]

  // Audit fields
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  activatedAt      DateTime?
  terminatedAt     DateTime?
  terminatedReason String?
  expiredAt        DateTime?
  depositRefunded  Boolean   @default(false)

  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([organizationId])
  @@map("rental_agreements")
}

// Itemised deductions against a tenant's deposit. The refund is derived from
// these rows rather than typed in, so the number is always auditable: deposit
// − Σ(deductions) − unpaid rent.
model MoveOutDeduction {
  id               String         @id @default(cuid())
  moveOutRequestId String
  moveOutRequest   MoveOutRequest @relation(fields: [moveOutRequestId], references: [id], onDelete: Cascade)

  category    DeductionCategory
  description String
  amount      Decimal           @db.Decimal(10, 2)

  approvedById String?
  approvedBy   User?   @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moveOutRequestId])
  @@index([category])
  @@map("move_out_deductions")
}

enum DeductionCategory {
  DAMAGE
  CLEANING
  UNPAID_RENT
  LATE_FEE
  UTILITY
  REPAIRS
  OTHER
}

// Move-in / periodic / move-out condition report. Photos attach through the
// Document Center (entityType = 'InspectionReport'), not a bespoke upload path.
enum InspectionType {
  MOVE_IN
  PERIODIC
  MOVE_OUT
  ANNUAL
}

enum InspectionStatus {
  DRAFT
  COMPLETED
  VOID
}

enum ConditionRating {
  GOOD
  FAIR
  POOR
  DAMAGED
}

model InspectionReport {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  type   InspectionType
  status InspectionStatus @default(DRAFT)

  scheduledDate DateTime
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  notes String? @db.Text

  items InspectionItem[]

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([rentalAgreementId])
  @@index([status])
  @@index([organizationId])
  @@map("inspection_reports")
}

model InspectionItem {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  area      String // "Kitchen", "Bathroom", "Walls"…
  item      String // what was checked
  condition ConditionRating
  notes     String?         @db.Text

  // Estimated cost to put right, and whether the tenant is liable for it.
  estimatedCost  Decimal? @db.Decimal(10, 2)
  requiresAction Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("inspection_items")
}

// Reusable lease terms (Module 5). Applying a template prefills the create
// form; the saved agreement is always a full row, never a reference back here.
model LeaseTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  agreementType AgreementType @default(RENTAL)

  rentAmount       Decimal? @db.Decimal(10, 2)
  currency         String   @default("KES")
  securityDeposit  Decimal? @db.Decimal(10, 2)
  termMonths       Int?
  noticePeriodDays Int      @default(30)
  escalationRate   Decimal? @db.Decimal(5, 2)
  paymentDay       Int      @default(1)

  termsBody String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
  @@map("lease_templates")
}

model MoveOutRequest {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAgreementId   String
  rentalAgreement     RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)
  moveoutDate         DateTime
  approvalDate        DateTime?
  approvedBy          String? // User ID who approved
  status              MoveOutStatus   @default(PENDING)
  depositRefunded     Boolean         @default(false)
  depositRefundAmount Decimal?        @db.Decimal(10, 2)
  notes               String?         @db.Text

  // Itemised deductions behind the refund (Module 5) — the refund is derived,
  // never typed in.
  deductions   MoveOutDeduction[]
  refundedAt   DateTime?
  refundedById String?
  refundedBy   User?              @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([rentalAgreementId])
  @@index([status])
  @@index([organizationId])
  @@map("move_out_requests")
}

enum AgreementType {
  LEASE // Commercial - long term
  RENTAL // Residential - monthly
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum MoveOutStatus {
  PENDING
  APPROVED
  // Added in Module 5: the refund is a real settlement step, so a move-out that
  // has been paid out is COMPLETED rather than merely APPROVED.
  COMPLETED
  REJECTED
}

// ============================================
// CRM (LEADS, CONTACTS, COMMUNICATIONS)
// ============================================

// Where a lead came from. WEBSITE/FACEBOOK are the two automated sources the
// public webhook feeds; WHATSAPP is manual until a Business API integration
// exists.
enum LeadSource {
  WEBSITE
  FACEBOOK
  WHATSAPP
  WALK_IN
  REFERRAL
  OTHER
}

// Pipeline stage. WON/LOST are terminal: a lead in either state cannot be
// moved again without reopening it (see leads.service).
enum LeadStage {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Who is asking. The CRM target sketch only carried `source`/`status`; a lead
  // without contact details cannot be worked, so the enquiry details live on
  // the lead until it is converted to a Contact.
  firstName String
  lastName  String?
  email     String?
  phone     String?
  message   String? @db.Text

  source       LeadSource @default(OTHER)
  sourceDetail String? // e.g. website form name, Facebook page, referrer

  stage      LeadStage @default(NEW)
  lostReason String?

  // What they are interested in, and who owns the follow-up.
  interestedPropertyId String?
  interestedProperty   Property? @relation("PropertyLeads", fields: [interestedPropertyId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedAgentId String?
  assignedAgent   User?   @relation("UserAssignedLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // Set once the lead is converted: the contact it became, and when.
  contactId   String?
  contact     Contact?  @relation("LeadContact", fields: [contactId], references: [id], onDelete: SetNull)
  convertedAt DateTime?

  communications CommunicationLog[]
  sales          SaleTransaction[]  @relation("LeadSales")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([organizationId])
  @@index([stage])
  @@index([source])
  @@index([assignedAgentId])
  @@index([interestedPropertyId])
  @@index([email])
  @@map("leads")
}

enum ContactType {
  BUYER
  TENANT
  LANDLORD
  INVESTOR
  AGENT
  LAWYER
}

// The shared people directory used across leasing and sales. Deliberately
// separate from `Tenant`: a tenant is a lease party with its own account
// number, tax PIN and rent history, whereas a contact is just a person we
// talk to. They are linked via `Tenant.contactId`.
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type      ContactType @default(BUYER)
  firstName String
  lastName  String

  email   String?
  phone   String?
  company String?
  notes   String? @db.Text

  isActive Boolean @default(true)

  leads          Lead[]             @relation("LeadContact")
  sales          SaleTransaction[]  @relation("ContactSales")
  communications CommunicationLog[]
  tenant         Tenant?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([email])
  @@map("contacts")
}

enum CommChannel {
  EMAIL
  SMS
  WHATSAPP
  CALL
  NOTE
  MEETING
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

// Every conversation artefact against a contact (or a lead that has not been
// converted yet). Nothing is sent anywhere yet — Modules 18 (Notifications)
// and the WhatsApp/e-mail integrations are the senders; this is the record.
model CommunicationLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel   CommChannel
  direction CommDirection @default(OUTBOUND)
  subject   String?
  content   String?       @db.Text
  outcome   String? // for calls: "answered", "no answer", "rescheduled…"

  occurredAt DateTime @default(now())

  loggedById String?
  loggedBy   User?   @relation("UserLoggedCommunications", fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([occurredAt])
  @@map("communication_logs")
}

// ============================================
// TENANT REQUESTS (self-service, approved by staff)
// ============================================

// What a resident can *ask* for in the portal. A request never changes a lease
// by itself: it is decided by staff, and approval delegates to the same
// services staff would have called by hand.
enum TenantRequestType {
  RENEWAL
  MOVE_OUT
  PAYMENT_PLAN
  MAINTENANT
  LEASE_AMENDMENT
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model TenantRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  type   TenantRequestType
  status TenantRequestStatus @default(PENDING)

  // What the resident asked for, snapshotted at submission so a later change
  // to the lease cannot rewrite their request.
  payload Json

  preferredDate DateTime?

  // Set when a move-out date falls inside the lease's notice period: a flag for
  // staff to decide on, not a refusal — the resident is allowed to ask.
  earlyNotice Boolean @default(false)

  note String? @db.Text

  // Staff decision
  decidedById  String?
  decidedBy    User?     @relation("UserDecidedTenantRequests", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?   @db.Text

  // What the approval actually did, so the queue stays auditable.
  result Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([tenantId, status])
  @@index([rentalAgreementId])
  @@map("tenant_requests")
}

// ============================================
// SALES MANAGEMENT
// ============================================

// A property sale moves strictly forward through these stages; CANCELLED is
// reachable from any stage before HANDOVER. The transition rules (which gates
// each move) live in `modules/sales/sale-stage.ts`.
enum SaleStage {
  QUOTATION
  OFFER
  RESERVATION
  AGREEMENT
  PAYMENT
  HANDOVER
  CANCELLED
}

enum InstallmentStatus {
  SCHEDULED
  INVOICED
  PAID
  OVERDUE
  WAIVED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model SaleTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code String @unique // Sale reference, e.g. SALE-2026-0001

  // What is being sold. `Restrict`: a property with an open sale cannot be
  // deleted out from under it.
  propertyId String
  property   Property @relation("PropertySales", fields: [propertyId], references: [id], onDelete: Restrict)

  // Snapshot of the property name/title at the time the sale was opened, so a
  // renamed or archived property does not rewrite history.
  propertyTitle String?

  // Buyer comes from the CRM contacts directory (Module 3).
  buyerContactId String?
  buyerContact   Contact? @relation("ContactSales", fields: [buyerContactId], references: [id], onDelete: SetNull)

  // Lead this sale came from, when it started in the CRM pipeline.
  leadId String?
  lead   Lead?   @relation("LeadSales", fields: [leadId], references: [id], onDelete: SetNull)

  // Primary agent. Additional agents are rows in `Commission` (split support).
  agentUserId String?
  agent       User?   @relation("UserSales", fields: [agentUserId], references: [id], onDelete: SetNull)

  stage SaleStage @default(QUOTATION)

  // Money
  askingPrice   Decimal? @db.Decimal(14, 2)
  agreedPrice   Decimal? @db.Decimal(14, 2)
  bookingFee    Decimal? @db.Decimal(14, 2)
  depositAmount Decimal? @db.Decimal(14, 2)
  currency      String   @default("KES")

  // Commission basis for this sale, as a percentage of the agreed price.
  // Individual splits are stored on `Commission.splitPercentage`.
  commissionRate Decimal? @db.Decimal(5, 2)

  // Stage dates, stamped when the sale enters each stage (audit trail)
  quotationDate      DateTime?
  offerDate          DateTime?
  reservationDate    DateTime?
  agreementDate      DateTime?
  paymentDate        DateTime?
  handoverDate       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  notes String? @db.Text

  installments SaleInstallment[]
  commissions  Commission[]
  invoices     Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([organizationId])
  @@index([stage])
  @@index([propertyId])
  @@index([buyerContactId])
  @@map("sale_transactions")
}

// An agreed payment schedule. `invoiceId` is the Finance invoice raised for
// the installment — installment billing reuses `InvoicesService` rather than
// duplicating invoicing logic.
model SaleInstallment {
  id                String          @id @default(cuid())
  saleTransactionId String
  saleTransaction   SaleTransaction @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)

  sequence    Int // 1-based position in the schedule
  description String // e.g. "Deposit", "Second instalment"
  amount      Decimal           @db.Decimal(14, 2)
  dueDate     DateTime
  status      InstallmentStatus @default(SCHEDULED)
  invoiceId   String?           @unique
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paidAt      DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([saleTransactionId, sequence])
  @@index([saleTransactionId])
  @@index([status])
  @@map("sale_installments")
}

// Commission earned on a sale (or, for the leasing side that the schema also
// allows, on a rental agreement). `splitPercentage` is the agent's share of
// the sale's commission; the rows for one sale are expected to add up to 100.
model Commission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleTransactionId String?
  saleTransaction   SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)

  // The leasing side of the same commission concept. Module 5 wires this up.
  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  agentUserId String
  agent       User   @relation("UserCommissions", fields: [agentUserId], references: [id], onDelete: Restrict)

  amount          Decimal  @db.Decimal(14, 2)
  splitPercentage Decimal? @db.Decimal(5, 2)
  currency        String   @default("KES")

  // What the commission was earned on: the sale price, the booking fee, a
  // referral, or an agent's cut of another agent's deal.
  basis String @default("SALE")

  status CommissionStatus @default(PENDING)
  notes  String?          @db.Text

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("UserApprovedCommissions", fields: [approvedById], references: [id], onDelete: SetNull)

  paidAt  DateTime?
  paidRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([saleTransactionId])
  @@index([agentUserId])
  @@index([status])
  @@map("commissions")
}

// ============================================
// BILLING & PAYMENTS
// ============================================

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  // Landlord (recipient of invoice) - replaces lease reference
  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)

  // Keep rental agreement reference for backward compatibility and property tracking
  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  // Sale instalment link (Module 4). Sale invoices are raised by the Sales
  // module through `InvoicesService` and classified with
  // `transactionClass = 'SALE'`; they are not rental invoices.
  saleTransactionId String?
  saleTransaction   SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)

  // Invoice Details
  issueDate   DateTime @default(now())
  dueDate     DateTime
  amount      Decimal  @db.Decimal(10, 2)
  vatAmount   Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")

  // Transaction classification for accounting
  transactionClass String? // Transaction Class - for accounting classification

  // Accounts receivable for general ledger integration
  acReceivable String? // A/C Receivable - accounts receivable account // TODO Should be connected to another tabled

  // Billing address information
  billTo String? @db.Text // Bill To - billing address

  // Multi-currency support
  spotRate Decimal? @db.Decimal(10, 4) // Spot Rate - exchange rate for multi-currency

  // Purchase order tracking
  lpoNumber String? // LPO # - purchase order number

  // Digital signature tracking
  signOnEfims Boolean @default(false) // Sign On eFims - digital signature indicator

  // Payment instructions
  paymentInfo String? @db.Text // Payment Info - payment instructions

  // Terms and conditions
  termsConditions String? @db.Text // Terms & Conditions - invoice terms

  // Additional notes
  memo String? @db.Text // Memo - additional notes

  // Status
  status InvoiceStatus @default(PENDING)

  // Recurring billing (Module 7): the period this invoice bills for, e.g.
  // "2026-10". Set only by the generator, and unique per lease — so a second run
  // of the same period cannot produce a duplicate rent bill, which is the whole
  // reason a scheduler needs one. Null on every manually raised invoice.
  billingPeriod String?

  // Payment tracking
  paidAmount    Decimal @default(0) @db.Decimal(10, 2)
  balanceAmount Decimal @db.Decimal(10, 2)

  // Tax provenance (Module 7 rules engine). `amount`/`vatAmount`/`totalAmount`
  // remain the single source of truth for the money; these record what the
  // engine decided and under whose jurisdiction, so a document issued in one
  // country is not silently re-read under another's rules.
  taxJurisdiction   String? // e.g. "KE", "US-CA" — snapshotted at issue
  taxBasis          TaxBasis?
  /// Per-rule totals, e.g. [{ "code": "VAT", "rate": 16, "amount": 1600,
  /// "account": "2100" }]. JSON so a jurisdiction with three tax types does not
  /// need a migration to invoice its fourth.
  taxSummary        Json?
  // Withholding tax collected on the invoice is deducted from what we remit,
  // never added to what the customer owes.
  taxWithheldAmount Decimal   @default(0) @db.Decimal(10, 2)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
  invoiceItems       InvoiceItem[]
  payments           Payment[]
  creditApplications CreditApplication[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]

  // Audit fields
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  saleInstallment SaleInstallment?

  @@unique([rentalAgreementId, billingPeriod])
  @@index([rentalAgreementId])
  @@index([saleTransactionId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Revenue/Expense item classification for accounting
  revenueExpenseItem String? // Revenue/Expense Item - for accounting categorization

  // Description of the line item (maps to "Particular" in form)
  description String // Particular - description of the line item

  // Income account for general ledger integration
  incomeAccount String? // Income Account - for general ledger integration

  // Quantity and pricing
  quantity  Decimal @default(1) @db.Decimal(10, 2) // Qty - quantity of items
  unitPrice Decimal @db.Decimal(10, 2) // Unit Cost - price per unit

  // Line total
  amount Decimal @db.Decimal(10, 2) // Line Total - total amount for this line

  // Tax information
  vatRate   Decimal? @db.Decimal(5, 2) // Tax Rate - VAT percentage
  vatAmount Decimal? @db.Decimal(10, 2) // Tax Amount - calculated VAT amount

  // Tax rule snapshot (Module 7 rules engine). The rate and amount above are
  // what the invoice was issued with; these record *which* rule produced them,
  // so an invoice dated under an old rate stays explicable after the rule
  // changes, and a mixed-tax invoice says which line was which.
  taxRuleId    String?
  taxRule      TaxRule?      @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  taxCode      String? // e.g. "VAT", "GST", "WHT" — snapshotted so the document
  // is readable even if the rule is renamed or deleted
  taxBasis     TaxBasis?
  taxTreatment TaxTreatment?

  // Additional classification
  className String? // Class - additional classification for reporting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Receipt {
  id              String          @id @default(cuid())
  receiptId       String          @unique // Receipt ID
  receiptType     ReceiptType     @default(ApplyToInvoice)
  receiptCategory ReceiptCategory @default(Rent)

  // Common fields
  receivedFrom   String
  paymentMethod  PaymentMethod
  depositIntoAc  String?
  refNo          String?
  chequeNo       String?
  chequeDate     DateTime?
  recordingDate  DateTime      @default(now())
  amountReceived Decimal       @db.Decimal(10, 2)
  notes          String?       @db.Text

  // Rent receipt specific fields
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId         String?
  landlord           Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)
  recordDate         DateTime?
  bankingDate        DateTime?
  paymentRefNo       String?
  amountVatInclusive Boolean   @default(true)
  receiptTo          ReceiptTo @default(Landlord)
  drtOrDrf           DRTOrDRF  @default(DepositRefund)
  memo               String?   @db.Text
  paymentBank        String?
  currency           String    @default("KES")
  spotRate           Decimal?  @db.Decimal(10, 4)

  // Relationships
  payments     Payment[]
  receiptLines ReceiptLine[]

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  recordedBy String?

  @@index([tenantId])
  @@index([landlordId])
  @@index([receiptType])
  @@index([receiptCategory])
  @@index([recordingDate])
  @@index([paymentMethod])
  @@index([organizationId])
  @@map("receipts")
}

enum ReceiptCategory {
  Rent
  General
  Refund
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  // Payment Details
  paymentDate DateTime @default(now())
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")
  spotRate    Decimal? @db.Decimal(10, 4) // Spot Rate

  // Payment Method
  paymentMethod    PaymentMethod
  paymentReference String? // Ref No. (Bank ref, M-Pesa code, etc.)

  // Payment Parties
  payee    String?
  paidFrom String?
  paidTo   String?

  // Payment Type
  paymentType PaymentType @default(ApplyToBill)

  // Cheque details
  chequeNumber String?
  chequeDate   DateTime?

  // MPESA specific
  mpesaReceiptNumber String?
  mpesaPhoneNumber   String?

  // Notes and Attachments
  notes       String? @db.Text
  attachments String? // JSON or comma-separated file paths

  // Reversal bookkeeping (Module 7). A payment applied in error is reversed,
  // never deleted: the row stays so the history of what was once applied to an
  // invoice remains auditable, and the GL entry is posted in reverse.
  isReversed Boolean   @default(false)
  reversedAt DateTime?
  reversedBy String?

  // Module 8: how much of this payment has been pointed at an invoice. A
  // payment that arrives without one stays at 0 until `allocate` runs, and the
  // remainder becomes customer credit rather than being lost.
  appliedAmount Decimal @default(0) @db.Decimal(12, 2)

  // Module 8: refunds and the credits that overpayments create.
  refunds       PaymentRefund[]
  allocations   PaymentAllocation[]
  sourceCredits CustomerCredit[]    @relation("CreditSourcePayments")

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  recordedBy String?

  @@index([rentalAgreementId])
  @@index([invoiceId])
  @@index([receiptId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([organizationId])
  @@map("payments")
}

/// Module 8 — Payments: what part of a payment settled which invoice.
///
/// Without this the only record of the split is `Invoice.paidAmount`, and the
/// moment money comes back (a refund) or a payment is over-applied, the true
/// figure cannot be recovered: a 5,000 payment against a 3,000 invoice is 3,000
/// paid and 2,000 on credit, but `Payment.amount` says 5,000. Every figure the
/// invoice shows is derived from these rows, so the split survives refunds and
/// reversals.
model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  createdBy String?

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum PaymentType {
  ApplyToBill
  CashPayment
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MPESA
  CARD
  OTHER
}

enum ReceiptType {
  ApplyToInvoice
  CashReceipt
}

enum ReceiptTo {
  Landlord
  GeneralLedger
}

enum DRTOrDRF {
  DirectReceipt
  DepositRefund
}

/// Chart of accounts (Module 7 — Finance & Accounting). One row per
/// organization: accounts are tenant-scoped so two organizations never share
/// (or can read) each other's ledger structure. `code` is unique per
/// organization, `type` drives the trial balance grouping.
model Account {
  id          String      @id @default(cuid())
  code        String
  name        String
  type        AccountType
  subtype     String?
  description String?     @db.Text

  // Normal balance of the account, used when rendering balances and when
  // validating manual journal entries.
  normalBalance BalanceSide @default(DEBIT)

  // System accounts (cash on hand, bank, AR, VAT payable, rent revenue, ...)
  // are seeded per organization and cannot be deleted — they are the target of
  // auto-posted entries. Custom accounts added by an accountant can be removed.
  isSystem Boolean @default(false)

  // Postable accounts accept journal lines; header/parent accounts (e.g.
  // "Current Assets" grouping) do not.
  isPostable Boolean @default(true)

  isActive Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BalanceSide {
  DEBIT
  CREDIT
}

/// A double-entry journal entry. Routine transactions (invoice issued, payment
/// received) are auto-posted by `AccountingService`; entries created manually
/// carry `source = MANUAL`.
model JournalEntry {
  id          String @id @default(cuid())
  entryNumber String

  entryDate DateTime @default(now())

  memo      String? @db.Text
  reference String?

  source JournalEntrySource @default(MANUAL)

  /// Free-form pointer back to the business record that caused the entry, e.g.
  /// { "type": "INVOICE", "id": "clx...", "number": "INV-202601-0001" }.
  /// Stored as JSON so new source types do not need a migration.
  sourceRef Json?

  status JournalEntryStatus @default(POSTED)

  /// Reversal bookkeeping — a reversed entry keeps its lines and points at the
  /// reversing entry instead of being deleted, so history stays auditable.
  reversedByEntryId String?       @unique
  reversedByEntry   JournalEntry? @relation("EntryReversal", fields: [reversedByEntryId], references: [id], onDelete: SetNull)
  reversesEntryId   String?       @unique
  reversesEntry     JournalEntry? @relation("EntryReversal")

  postedBy String?
  postedAt DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([entryDate])
  @@index([source])
  @@map("journal_entries")
}

enum JournalEntrySource {
  MANUAL
  INVOICE
  PAYMENT
  RECEIPT
  LEASE
  CREDIT_NOTE
  PAYOUT
  REFUND
  BILL
  BILL_PAYMENT
  OPENING_BALANCE
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

/// One side of a journal entry. Exactly one of debit/credit is non-zero; the
/// entry as a whole must balance (see `AccountingService.postEntry`).
model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String? @db.Text

  // Entity the line belongs to, for per-tenant/landlord/property reporting.
  memo String? @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// Module 8 — Payments: money the customer is owed back.
///
/// A credit arises whenever money arrives that no invoice needs: an
/// overpayment on an invoice, an unallocated receipt, a goodwill gesture, or
/// the unspent part of a payment that was later refunded. Without this, an
/// overpaid tenant's money simply vanishes from the system.
///
/// `amount` is what was granted, `appliedAmount` what has since been consumed
/// against invoices — the usable balance is the difference. Credits are spent
/// oldest-invoice-first by `CreditsService`.
model CustomerCredit {
  id            String  @id @default(cuid())
  amount        Decimal @db.Decimal(12, 2)
  appliedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("KES")

  reason String? @db.Text

  source CustomerCreditSource @default(MANUAL)

  /// The payment that generated this credit, when it came from one.
  sourcePaymentId String?
  sourcePayment   Payment? @relation("CreditSourcePayments", fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  // Who the credit belongs to. At least one of these (or `customerName`) is
  // set: credit is meaningless if you cannot say whose it is.
  tenantId     String?
  tenant       Tenant?   @relation("TenantCredits", fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId   String?
  landlord     Landlord? @relation("LandlordCredits", fields: [landlordId], references: [id], onDelete: SetNull)
  customerName String?

  status CreditStatus @default(OPEN)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  applications CreditApplication[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("customer_credits")
}

enum CustomerCreditSource {
  OVERPAYMENT
  UNALLOCATED_RECEIPT
  GOODWILL
  REFUND_UNSPENT
  MANUAL
}

enum CreditStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  VOID
}

/// One consumption of a credit against one invoice. Kept as rows (not a
/// counter alone) so "which invoice did this credit pay?" is answerable.
model CreditApplication {
  id       String         @id @default(cuid())
  creditId String
  credit   CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  appliedAt DateTime @default(now())
  appliedBy String?

  @@index([creditId])
  @@index([invoiceId])
  @@map("credit_applications")
}

/// A refund of money already received. `Payment` rows are never edited or
/// deleted to represent money going back — this records the direction explicitly
/// and links to the credit note the refund produces, so the audit trail reads
/// "they paid, we refunded", not "the payment never happened".
model PaymentRefund {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  reason String  @db.Text

  refundReference String?
  processedAt     DateTime @default(now())
  processedBy     String?

  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@map("payment_refunds")
}

/// Module 8 — Payments: a document reducing what a customer owes. Issued
/// automatically when a payment is refunded, and available on its own for
/// write-offs and corrections. Applying a credit note leaves a credit balance
/// rather than pushing a negative amount onto an invoice.
model CreditNote {
  id               String @id @default(cuid())
  creditNoteNumber String @unique

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The invoice this note reduces. Null for a goodwill/advance note.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  refund PaymentRefund?

  tenantId   String?
  tenant     Tenant?   @relation("TenantCreditNotes", fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId String?
  landlord   Landlord? @relation("LandlordCreditNotes", fields: [landlordId], references: [id], onDelete: SetNull)

  issueDate DateTime @default(now())

  reason String  @db.Text
  notes  String? @db.Text

  subtotal    Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String  @default("KES")

  status CreditNoteStatus @default(ISSUED)

  lines CreditNoteLine[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@map("credit_notes")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  vatRate   Decimal? @db.Decimal(5, 2)
  vatAmount Decimal? @db.Decimal(12, 2)

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

/// Module 7 — Finance & Accounting: the configurable tax rules engine.
///
/// Tax is configuration, not code. An organization says where it operates and
/// its accountant records the tax types that apply there; nothing in the
/// codebase assumes a country, a currency, or that "VAT at 16%" is a constant.
/// Renaming `code`, changing a rate, or adding a jurisdiction is a data change.
///
/// One rule = one tax type for a period. Multiple rules may be active at once
/// (VAT plus a withholding tax, or a standard and a reduced rate), which is why
/// calculation is a small pipeline rather than a single multiplication.
model TaxRule {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String? @db.Text

  // ISO-3166-1 alpha-2 country the rule belongs to (KE, GB, DE, ...). A null
  // country means the rule is the organization's fallback for anywhere it
  // trades without a more specific match.
  countryCode String? @db.Char(2)

  // Optional sub-national level (US state, German Bundesland, ...). When set,
  // the rule only applies to an organization whose `taxRegionCode` matches.
  regionCode String?

  /// How this tax relates to the stated price.
  ///
  /// `INCLUSIVE` — the price already contains the tax (a €119 VAT-inclusive
  /// rate is 100 + 19), which is how most consumer sales are advertised.
  /// `EXCLUSIVE` — tax is added on top of the price.
  ///
  /// Some jurisdictions are mixed (goods exclusive, services inclusive), so
  /// this is per rule and not a global switch.
  basis TaxBasis @default(EXCLUSIVE)

  /// Tax charged on top of another tax (EU-style compound VAT, or an Indian
  /// GST-on-service-fee). `compoundOnRuleId` names the rule it stacks onto;
  /// the engine rejects a compound rule with nothing to compound on.
  isCompound       Boolean   @default(false)
  compoundOnRuleId String?
  compoundOnRule   TaxRule?  @relation("CompoundTax", fields: [compoundOnRuleId], references: [id], onDelete: SetNull)
  compoundsOn      TaxRule[] @relation("CompoundTax")

  /// Percentage rate, four decimal places so reduced and fractional rates
  /// (7.7% Brazil ISS, 5% reduced VAT) are exact. Stored as a percentage, not
  /// a fraction: 16.0000 means 16%.
  rate Decimal @db.Decimal(7, 4)

  /// Where the collected tax lands in the ledger. Without it the engine posts
  /// every tax to 2100 (VAT payable), which silently merges a withholding tax
  /// into VAT and makes the trial balance a lie.
  ledgerAccountCode String? @default("2100")

  /// Whether the tax is shown as its own line on an invoice (sales tax) or is
  /// withheld from the customer's payment and never billed to them
  /// (withholding tax).
  treatment TaxTreatment @default(CHARGED)

  /// Which kind of charge this rate is for. `'*'` (the default) applies
  /// everywhere. A jurisdiction with a standard and a reduced rate — Germany's
  /// 19% and 7% VAT — sets both to `'*'` plus one category, and an invoice line
  /// tagged with that category gets the reduced rate instead of both. Matching
  /// is by the line's `revenueExpenseItem`, falling back to `'*'`.
  appliesToCategory String @default("*")

  /// Effective window. Two rules may exist for the same country/code with
  /// different windows so a rate change is data, not a migration — and an
  /// invoice dated inside the old window keeps the old rate.
  validFrom DateTime  @default(now())
  validTo   DateTime?

  isActive Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  // Identity of a rule: one tax, in one place, for one line category, from one
  // date. `appliesToCategory` is part of it because a standard and a reduced
  // rate of the same tax are two rules with the same code and different
  // categories.
  @@unique([organizationId, code, countryCode, regionCode, appliesToCategory, validFrom])
  @@index([organizationId])
  @@index([countryCode])
  @@map("tax_rules")
}

enum TaxBasis {
  EXCLUSIVE
  INCLUSIVE
}

enum TaxTreatment {
  /// Added to the invoice as a visible line the customer pays.
  CHARGED
  /// Deducted by us when paying the supplier/authority; the customer never
  /// sees it on an invoice.
  WITHHELD
}

/// Module 7 — Finance & Accounting: the accounts payable side.
///
/// The mirror of what already exists for receivables, and deliberately built on
/// the same primitives: money never moves without a `PaymentAllocation`-style
/// record saying which bill it settled, an invoice-like bill's money columns are
/// derived rather than decremented, and correcting anything posts a reversal
/// rather than editing history. A supplier who overpays us is owed money, which
/// is the same shape as a tenant who overpaid us — `SupplierCredit` is the
/// payable-side counterpart of `CustomerCredit`.
model Supplier {
  id   String @id @default(cuid())
  code String @unique
  name String

  status SupplierStatus @default(ACTIVE)

  email   String?
  phone   String?
  address String? @db.Text
  city    String?
  country String?

  /// VAT/GST registration — printed on bills where the law requires it.
  taxPin        String?
  vatRegistered Boolean @default(false)

  /// Terms in days, used to derive `dueDate` from the bill date.
  paymentTermsDays Int?

  bankName      String?
  bankBranch    String?
  accountName   String?
  accountNumber String?

  notes String? @db.Text

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  bills   SupplierBill[]
  credits SupplierCredit[]

  // Module 10 — Procurement. The doc's `Supplier` had only a name and a phone;
  // the fields below are the ones a buyer actually needs, added here rather than
  // as a parallel vendor table because a bill and a purchase order that point at
  // two different "supplier" records is how an AP total goes wrong.
  /// What this supplier supplies, so the RFQ picker can offer relevant vendors
  /// rather than every electrician in the city for a request for office chairs.
  category SupplierCategory?

  /// A human rating (1–5) kept alongside the derived performance figures in
  /// `Supplier.performance` — a buyer's judgement and the numbers are different
  /// things, and only one of them is a calculation.
  rating Int?

  /// Contract window, for the suppliers under an annual agreement rather than
  /// bought from ad hoc.
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractReference String?

  rfqInvitations RfqInvitation[]
  rfqQuotes      RfqQuote[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([name])
  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// What a supplier supplies. Narrower and deliberately different from both
/// `PurchaseCategory` (what is being bought this time) and `BillCategory` (which
/// expense account the invoice lands in): a plumber is a SUPPLIER_CATEGORY once
/// and stays one, while the category of any particular job from them is
/// decided by the requester.
enum SupplierCategory {
  PLUMBING
  ELECTRICAL
  MECHANICAL
  BUILDING_MATERIALS
  FURNITURE
  IT_AND_TECH
  CLEANING
  SECURITY
  PEST_CONTROL
  LANDSCAPING
  PROFESSIONAL_SERVICES
  GENERAL
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

/// What kind of cost a bill is, so the right expense account is used without
/// anyone having to remember an account code. `other` falls back to 5900.
enum BillCategory {
  MAINTENANCE
  UTILITIES
  INSURANCE
  PROFESSIONAL
  MARKETING
  OFFICE
  SALARIES
  TAX
  OTHER
}

model SupplierBill {
  id         String @id @default(cuid())
  billNumber String

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// The supplier's own invoice/reference number, so a bill can be traced back
  /// to the document it came from.
  supplierReference String?

  billDate DateTime @default(now())
  dueDate  DateTime

  currency String @default("KES")

  category BillCategory @default(OTHER)

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  paidAmount    Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount Decimal @db.Decimal(14, 2)

  status BillStatus @default(OPEN)

  /// Tax provenance, mirroring invoices: the bill snapshots what the rules
  /// decided so a later rule change cannot rewrite a document already paid.
  taxJurisdiction String?
  taxSummary      Json?

  /// Snapshot of the expense lines, so a VOID or corrected bill still explains
  /// itself after the supplier's own references change.
  lineSnapshot Json?

  notes String? @db.Text

  lines              SupplierBillLine[]
  payments           BillPayment[]
  creditApplications SupplierCreditApplication[]

  // Module 10 — Procurement. A bill raised from a purchase order points back at
  // it. Named, because `SupplierBill` also has no relation of this name today and
  // the back-reference has to be unambiguous from both sides.
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderBill")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  voidedAt DateTime?

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id     String       @id @default(cuid())
  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  description String

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(14, 2)

  taxRate   Decimal? @db.Decimal(7, 4)
  taxAmount Decimal? @db.Decimal(12, 2)
  taxCode   String?

  /// Optional explicit expense account for this line. Validated against the
  /// chart when posted, so a typo cannot produce an entry that fails at the
  /// ledger.
  expenseAccountCode String?

  createdAt DateTime @default(now())

  @@index([billId])
  @@map("supplier_bill_lines")
}

/// Money paid to a supplier. Kept separate from `Payment`, which is the
/// receivable-side record: a bill payment settles `SupplierBill`, not an
/// `Invoice`, and conflating them is how an AP total ends up wrong.
model BillPayment {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("KES")

  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?       @db.Text

  /// How much of this payment is pointed at an invoice-equivalent bill; the
  /// remainder is credit owed back to us by the supplier.
  appliedAmount Decimal @default(0) @db.Decimal(14, 2)

  isReversed Boolean   @default(false)
  reversedAt DateTime?
  reversedBy String?

  createdAt DateTime @default(now())
  createdBy String?

  // Supplier credit this payment created as an overpayment.
  sourceCredits SupplierCredit[] @relation("CreditSourcePayments")

  @@index([organizationId])
  @@index([billId])
  @@index([paymentDate])
  @@map("bill_payments")
}

/// What a supplier owes us back — we overpaid, or returned goods. Spent against
/// their next bills, oldest first, exactly as `CustomerCredit` is.
model SupplierCredit {
  id            String  @id @default(cuid())
  amount        Decimal @db.Decimal(14, 2)
  appliedAmount Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("KES")

  reason String?              @db.Text
  source SupplierCreditSource @default(OVERPAYMENT)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// The overpaying payment this credit came from. Reversing that payment has
  /// to unwind the credit too, or the supplier keeps a credit balance that no
  /// longer corresponds to any money.
  sourcePaymentId String?
  sourcePayment   BillPayment? @relation("CreditSourcePayments", fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  status CreditStatus @default(OPEN)

  applications SupplierCreditApplication[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_credits")
}

enum SupplierCreditSource {
  OVERPAYMENT
  UNALLOCATED
  GOODWILL
  MANUAL
}

model SupplierCreditApplication {
  id       String         @id @default(cuid())
  creditId String
  credit   SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  appliedAt DateTime @default(now())
  appliedBy String?

  @@index([creditId])
  @@index([billId])
  @@map("supplier_credit_applications")
}

/// One execution of the recurring billing job, kept so an operator can answer
/// "did rent go out this month?" without reading logs. Failures are recorded
/// per lease rather than aborting the run: one bad lease must not stop the other
/// two hundred from being billed.
/// Module 17 — Notifications: one row per message, per channel.
///
/// One message to three channels is three rows, not one row with three
/// booleans: each channel is delivered and failed independently, and one
/// provider being down must not lose the others. `dedupeKey` is what stops a
/// daily job sending the same reminder every morning — with the unique index
/// below, "already sent today" is a database fact rather than a check the
/// scheduler has to remember to do.
model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// A staff recipient. Portal residents have no login of their own, so a
  /// notification to a resident is addressed by `tenantId` instead.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation("TenantNotifications", fields: [tenantId], references: [id], onDelete: Cascade)

  type     NotificationType
  channel  NotificationChannel  @default(IN_APP)
  priority NotificationPriority @default(NORMAL)

  title String
  body  String @db.Text

  /// Where the reader goes if this is surfaced in the app.
  actionUrl String?

  /// What the message is about, so a list can group and link without
  /// re-parsing the body.
  entityType String?
  entityId   String?

  status NotificationStatus @default(PENDING)

  /// Stable key for "this exact reminder, for this day". Null disables dedupe.
  dedupeKey String?

  sentAt       DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey, channel])
  @@index([userId, readAt])
  @@index([tenantId, readAt])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  RENT_DUE
  RENT_OVERDUE
  LEASE_EXPIRING
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_WITHDRAWN
  MAINTENANCE_UPDATE
  APPROVAL_REQUESTED
  // Module 18: the two facts an approval queue needs to tell apart — a decision
  // was made on a request, or a level blew its SLA and moved up a level.
  APPROVAL_DECIDED
  APPROVAL_ESCALATED
  OWNER_STATEMENT_READY
  PAYOUT_PAID
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  /// Never suppressed by a user's opt-out — a tenant being overcharged or a
  /// lease ending is not something they can consent to missing.
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Deliberately not sent: no provider configured, or the recipient opted out
  /// and the message is not critical. Distinct from FAILED so an operator can
  /// tell "we chose not to" from "we tried and it broke".
  SUPPRESSED
}

/// Module 17 — Notifications: which provider sends a channel, and with what
/// credentials.
///
/// One row per channel per organization, which is what enforces "only one
/// provider active at a time" — there is no second row to activate. Credentials
/// are stored **encrypted**, never in plaintext: an admin panel that writes
/// secrets to a readable column has turned every database backup into a
/// credential leak.
model NotificationChannelConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  /// Which vendor to use: TWILIO or AFRICAS_TALKING for SMS. Stored as a string
  /// rather than an enum so a third provider can be added by registering it in
  /// the service without a migration.
  provider String

  /// AES-256-GCM ciphertext of the provider's credentials, as JSON.
  credentialsEncrypted String @db.Text

  /// Non-secret settings (sender id, sender name, region). Safe to read.
  settings Json?

  isActive Boolean @default(false)

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, channel])
  @@index([organizationId])
  @@map("notification_channel_configs")
}

/// Per-recipient channel preferences. A missing row means "all channels on",
/// which is the right default: nobody has opted in to being opted out of.
model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  type  NotificationType
  inApp Boolean          @default(true)
  email Boolean          @default(true)
  sms   Boolean          @default(true)
  push  Boolean          @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([organizationId])
  @@map("notification_preferences")
}

model RecurringBillingRun {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The day the run was for, e.g. "2026-10-01".
  billingDate   DateTime
  /// The period billed, e.g. "2026-10".
  billingPeriod String

  invoicesCreated Int @default(0)
  leasesSkipped   Int @default(0)
  leasesFailed    Int @default(0)

  /// Per-lease outcome, including why a lease was skipped or what it failed on.
  details Json?

  status       RecurringRunStatus @default(COMPLETED)
  errorMessage String?            @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  triggeredBy String? // null for the scheduled run

  @@index([organizationId])
  @@index([billingPeriod])
  @@map("recurring_billing_runs")
}

enum RecurringRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  date         DateTime
  invNo        String?
  particular   String
  invoiceTotal Decimal  @db.Decimal(10, 2)
  prevReceipts Decimal  @default(0) @db.Decimal(10, 2)
  amtDue       Decimal  @db.Decimal(10, 2)
  payment      Decimal  @db.Decimal(10, 2)
  newBalance   Decimal  @db.Decimal(10, 2)
  whtTax       Decimal  @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptId])
  @@map("receipt_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 18 — Workflow Engine
//
// Multi-step approvals as configuration, not code. The reason this exists is
// that "who signs off a refund, and when" is a policy an organization decides
// and changes; hardcoding it into a finance service means every customer gets
// our policy. The engine knows nothing about refunds, leases or work orders —
// it moves a request from one named approver to the next and reports the result.
// ─────────────────────────────────────────────────────────────────────────────

/// The policy: "for this kind of request, these are the approval levels, in
/// this order, with these conditions".
///
/// `organizationId = null` marks a **system default** available to every
/// organization (seeded by the platform); a non-null value is that
/// organization's own policy and shadows the default. Resolution is
/// org-specific-first, then system default, highest `priority` wins.
///
/// `steps` is the ordered template, one entry per level:
///   { "name": "Finance review",
///     "approverKind": "ROLE",            // or "USER"
///     "approverRole": "Accountant",      // matched against system role names
///     "approverUserId": null,            // required when approverKind = USER
///     "condition": { "field": "amount", "op": "gt", "value": 50000 },
///     "escalateAfterHours": 24,
///     "escalateToUserId": null }
/// A level whose `condition` is false is skipped rather than blocking, which is
/// how "director approval only above 50,000" is expressed.
model WorkflowDefinition {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// What kind of request this governs: "REFUND", "EXPENSE", "LEASE",
  /// "PURCHASE_ORDER", "WORK_ORDER", "PAYOUT", ... Free-form on purpose — a new
  /// entity type is a definition row, not a migration.
  entityType String

  name        String
  description String? @db.Text

  steps Json

  isActive Boolean @default(true)

  /// Tie-breaker when more than one definition matches. Higher wins.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances WorkflowInstance[]

  @@index([organizationId, entityType])
  @@index([entityType])
  @@map("workflow_definitions")
}

/// One request travelling through a definition. `context` is the payload the
/// caller supplied (the amount, the reason, whatever the completion handler
/// needs) and is also what step `condition`s are evaluated against.
///
/// `workflowDefinitionId` is nullable **on purpose**: deleting a policy must not
/// delete approvals that are already in flight. The instance keeps its own copy
/// of what it is doing, and a running approval survives its definition being
/// retired.
model WorkflowInstance {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workflowDefinitionId String?
  workflowDefinition   WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String

  /// Denormalized one-liner for the approvals inbox, so the queue does not have
  /// to join back into whatever table the entity lives in.
  entityLabel String?

  /// Frozen copy of the definition's steps as they were when this started.
  /// Editing a policy must not rewrite the approvals already raised under it.
  steps Json

  /// What the caller asked for — the amount, the reason, whatever the completion
  /// handler needs — and what every step `condition` is evaluated against.
  /// Frozen with the instance, so a later change to the record cannot quietly
  /// move an approval across a threshold.
  context Json

  status      WorkflowInstanceStatus @default(IN_PROGRESS)
  currentStep Int                    @default(0)

  finalComment String? @db.Text

  startedById String?
  startedBy   User?   @relation("UserStartedWorkflows", fields: [startedById], references: [id], onDelete: SetNull)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepInstances WorkflowStep[]
  events        WorkflowEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([startedById])
  @@map("workflow_instances")
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  /// The current level blew its SLA and the decision was handed to somebody
  /// higher up. Still actionable — an escalated approval is a late approval, not
  /// a dead one.
  ESCALATED
  APPROVED
  REJECTED
  CANCELLED
}

/// One materialized approval level of an instance. This is a row rather than
/// JSON because the inbox has to answer "what is waiting on me", and delegation
/// and escalation have to survive a process restart.
model WorkflowStep {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepIndex Int
  name      String

  approverKind   WorkflowApproverKind @default(ROLE)
  /// Set when approverKind = USER.
  approverUserId String?
  /// Set when approverKind = ROLE. Matched against `Role.name` and the legacy
  /// `UserRole` enum value, case-insensitively, because role names are still
  /// not mapped onto the enum (master doc issue 51).
  approverRole   String?

  status WorkflowStepStatus @default(PENDING)

  /// When the level's SLA expires and the sweep escalates it.
  dueAt            DateTime?
  escalatedAt      DateTime?
  /// Who the level escalates to once overdue. Null = flag only.
  escalateToUserId String?

  /// The decision, and who made it. `actedById` differs from the assignee when
  /// somebody acted under a delegation, which is worth being able to see.
  actedById            String?
  actedAt              DateTime?
  actedViaDelegationId String?
  comment              String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actedBy            User?               @relation("UserActedWorkflowSteps", fields: [actedById], references: [id], onDelete: SetNull)
  approverUser       User?               @relation("UserAssignedWorkflowSteps", fields: [approverUserId], references: [id], onDelete: SetNull)
  actedViaDelegation WorkflowDelegation? @relation(fields: [actedViaDelegationId], references: [id], onDelete: SetNull)

  @@unique([instanceId, stepIndex])
  @@index([approverUserId, status])
  @@index([status, dueAt])
  @@map("workflow_steps")
}

enum WorkflowApproverKind {
  ROLE
  USER
}

enum WorkflowStepStatus {
  PENDING
  /// Waiting on somebody now.
  ACTIVE
  APPROVED
  REJECTED
  /// Past its SLA. Still decidable — see WorkflowInstanceStatus.ESCALATED.
  ESCALATED
  /// Its condition was false, so this level was never required.
  SKIPPED
}

/// The immutable trail: who asked, who decided, who escalated, who delegated,
/// with the comment each of those carried. `WorkflowStep` records only the
/// decision itself, which is not the same as a readable history.
model WorkflowEvent {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  type WorkflowEventType

  actorUserId String?

  /// Set when a delegate acted on the assignee's behalf.
  onBehalfOfUserId String?

  /// The delegation that authorised the delegate, when there was one.
  delegationId String?

  stepIndex Int?
  comment   String? @db.Text

  createdAt DateTime @default(now())

  actorUser      User?               @relation("UserWorkflowEventActors", fields: [actorUserId], references: [id], onDelete: SetNull)
  onBehalfOfUser User?               @relation("UserWorkflowEventDelegates", fields: [onBehalfOfUserId], references: [id], onDelete: SetNull)
  delegation     WorkflowDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@index([createdAt])
  @@map("workflow_events")
}

enum WorkflowEventType {
  STARTED
  APPROVED
  REJECTED
  ESCALATED
  DELEGATED
  CANCELLED
  SKIPPED
  /// No definition was configured, so the request went straight through. Kept
  /// explicitly rather than silently: "it was approved because nobody set up a
  /// policy" is a fact an auditor needs to be able to see.
  AUTO_APPROVED
}

/// "While I am on leave, Sarah approves what is waiting on me." Checked at the
/// moment of the decision, not when the task arrived, so a delegation created
/// after the fact still applies and one that has expired does not.
model WorkflowDelegation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("UserWorkflowDelegatedFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("UserWorkflowDelegatedTo", fields: [toUserId], references: [id], onDelete: Cascade)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  reason   String?   @db.Text

  createdAt DateTime @default(now())

  actedSteps WorkflowStep[]
  events     WorkflowEvent[]

  @@index([organizationId])
  @@index([fromUserId, toUserId])
  @@map("workflow_delegations")
}

// ============================================
// MAINTENANCE (Module 9)
// ============================================

/// The trade the job falls under. Drives nothing by itself — the point of
/// recording it is that "8 electrical faults this month" is the report an owner
/// asks for, and it is only answerable if every work order carries a category.
enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CLEANING
  PAINTING
  SECURITY
  OTHER
}

/// The documented pipeline: REQUESTED → INSPECTION → APPROVED → ASSIGNED →
/// IN_PROGRESS → COMPLETED → CLOSED. `CANCELLED` is the addition, and it is
/// deliberate: a reported fault that turns out to be a tenancy dispute or a
/// duplicate would otherwise have to be "completed" with a resolution note that
/// says nothing happened, which is a lie in the one field a tenant reads.
enum WorkOrderStatus {
  REQUESTED
  INSPECTION
  APPROVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

/// Emergency means "today", and the service derives the response deadline from
/// it rather than storing a second date somebody has to keep in step.
enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

/// Who raised it. Kept on the record rather than inferred from the tenant,
/// because a tenant-portal report and a caretaker's walk-in look identical
/// afterwards but are different facts for a dispute.
enum WorkOrderSource {
  STAFF
  TENANT_PORTAL
  TENANT_REQUEST
  PREVENTIVE
}

model WorkOrder {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human reference (`WO-2026-0007`), unique per organization — the codebase
  /// already numbers INVOICEs, RECEIPTs and credit notes this way, and a
  /// work order quoted over the phone needs one that is not a cuid.
  reference String

  title       String
  description String              @db.Text
  category    MaintenanceCategory
  priority    WorkOrderPriority   @default(NORMAL)
  status      WorkOrderStatus     @default(REQUESTED)
  source      WorkOrderSource     @default(STAFF)

  // Where the fault is. `propertyId` is the anchor: it is what the list filters
  /// on and what keeps a work order attributable when it is about a whole
  /// building (a lift, a generator) rather than one home. Nullable so a work
  /// order can be raised against an asset before anyone knows where it is.
  propertyId String?
  property   Property? @relation("PropertyWorkOrders", fields: [propertyId], references: [id], onDelete: SetNull)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  assignedTechnicianId String?
  assignedTechnician   User?   @relation("UserAssignedWorkOrders", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  /// How to get in — gate codes, "the neighbour has the only spare key".
  /// Written by whoever knows, because a technician standing outside a locked
  /// door is the most common cause of a wasted visit.
  accessInstructions String? @db.Text

  // Money. Decimal(12,2) like the other money columns in this schema, and
  // optional: the cost of an unapproved repair is genuinely unknown, and a
  // fabricated estimate is worse than a blank one.
  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  reportedAt   DateTime  @default(now())
  scheduledFor DateTime?
  inspectedAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?

  inspectionNote     String? @db.Text
  resolutionNote     String? @db.Text
  cancellationReason String? @db.Text

  /// Set when an approval was asked for (Module 18's engine, entity WORK_ORDER).
  /// The instance itself is found by (entityType, entityId); this is only the
  /// record that sign-off was requested at all, and when.
  approvalRequestedAt DateTime?

  // Preventive maintenance provenance. `pmDueOn` is the day the schedule fell
  // due, truncated to midnight, and (pmScheduleId, pmDueOn) is unique — the
  /// sweep can run twice, be run by hand, and be run by two instances, and the
  /// database is what stops the same service being raised twice for one period.
  // Both columns are nullable, and NULLs are distinct in a Postgres unique
  // index, so ordinary work orders never collide with each other.
  pmScheduleId String?
  pmSchedule   PreventiveMaintenanceSchedule? @relation(fields: [pmScheduleId], references: [id], onDelete: SetNull)
  pmDueOn      DateTime?

  raisedById String?
  raisedBy   User?   @relation("UserRaisedWorkOrders", fields: [raisedById], references: [id], onDelete: SetNull)

  tasks WorkOrderTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@unique([pmScheduleId, pmDueOn])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([assignedTechnicianId])
  @@map("work_orders")
}

/// A line of the job. The checklist a technician works through, and the record
/// of what was actually done — including on a preventive visit, where the
/// schedule's `checklist` is copied onto the work order so the historic visit
/// keeps the list it was performed against.
model WorkOrderTask {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description   String
  sortOrder     Int       @default(0)
  isDone        Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("UserCompletedWorkOrderTasks", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([workOrderId])
  @@map("work_order_tasks")
}

enum AssetType {
  ELEVATOR
  GENERATOR
  HVAC
  WATER_PUMP
  CCTV
  OTHER
}

/// Service state of the equipment itself, separate from its maintenance
/// schedule: an asset can be OUT_OF_SERVICE because it broke, or SERVICE_DUE
/// because the calendar says so, and the two call for different responses.
/// RETIRED is terminal and means "history only" — no new work orders, no new
/// preventive schedules, and no moving it back to service. It is a status
/// rather than a `retiredAt` date because a state machine has one source of
/// truth: two ways to say "we no longer own this" is how one of them rots.
enum AssetStatus {
  OPERATIONAL
  SERVICE_DUE
  OUT_OF_SERVICE
  RETIRED
}

/// The register of plant and equipment a property owns.
///
/// Deliberately not a spreadsheet: `retiredAt` is a date rather than a status
/// that can be toggled back and forth, because "we no longer own this lift" is
/// not a reversible fact, and a retired asset must not keep generating
/// preventive work orders.
model Asset {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Unit-level plant (a split AC, a washing machine) hangs off a unit too.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  type AssetType
  name String

  /// The tag painted on the machine. Unique per organization when present, so
  /// a technician can be told "GEN-01" instead of "the generator", but a
  /// property with untagged kit still accepts rows.
  assetTag     String?
  serialNumber String?
  manufacturer String?
  model        String?
  location     String?
  capacity     String?

  installedAt       DateTime?
  warrantyExpiresAt DateTime?

  status AssetStatus @default(OPERATIONAL)
  notes  String?     @db.Text

  workOrders  WorkOrder[]
  pmSchedules PreventiveMaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([propertyId])
  @@index([type])
  @@index([status])
  @@map("assets")
}

/// A recurring service interval for one asset — the generator that needs
/// running monthly whatever anybody asks for.
model PreventiveMaintenanceSchedule {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  /// Days between services. A frequency is the interval, not a list of future
  /// dates: `nextDueAt` is recomputed from the service that just happened, so
  /// a missed month does not shift every later month with it.
  frequencyDays Int

  /// Raise the work order this many days before it falls due, so there is time
  /// to book a contractor. 0 means "raise it on the day".
  leadTimeDays Int @default(0)

  /// The steps to perform, as an array of strings. Copied onto each generated
  /// work order rather than read at display time, so a historic visit keeps
  /// the list it was actually done against.
  checklist Json?

  assignedTechnicianId String?
  assignedTechnician   User?   @relation("UserPmSchedules", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  nextDueAt DateTime

  /// The last service the sweep actually raised, and when. Reporting on
  /// overdue plant needs "when was this last done", and deriving it from work
  /// orders means also deriving the ones that were cancelled and never done.
  lastRunAt DateTime?

  notes String? @db.Text

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assetId])
  @@index([active, nextDueAt])
  @@map("preventive_maintenance_schedules")
}

enum PmRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One sweep of the schedules, so "did the generator actually get serviced in
/// March?" is answerable from a record rather than from inference. Mirrors
/// `RecurringBillingRun` for the same reason: a job that might run twice needs
/// to be able to show that it ran, and what it decided not to do.
model PreventiveMaintenanceRun {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  runOn  DateTime
  status PmRunStatus @default(RUNNING)

  schedulesConsidered Int @default(0)
  workOrdersCreated   Int @default(0)
  schedulesSkipped    Int @default(0)
  schedulesFailed     Int @default(0)

  /// Per-schedule outcome, so a partial failure is diagnosable: which schedule,
  /// and why nothing was raised for it.
  details Json?

  triggeredBy  String?
  errorMessage String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([organizationId])
  @@index([runOn])
  @@map("preventive_maintenance_runs")
}

// ============================================
// Module 10 — Procurement
// ============================================

/// What a purchase request is for. Deliberately its own enum rather than a reuse
/// of `BillCategory`: the bill category answers "which expense account does this
/// land in", which is decided at *invoice* time by finance, while this answers
/// "what is being bought", which is what the requester picks months earlier. The
/// service maps between them when the purchase order becomes a bill, so a
/// request typed as EQUIPMENT still posts to whichever account the supplier's
/// bill belongs in.
enum PurchaseCategory {
  MAINTENANCE_PARTS
  EQUIPMENT
  FURNITURE
  IT_AND_TECH
  STATIONERY
  CLEANING
  SECURITY
  UTILITIES
  PROFESSIONAL_SERVICES
  OTHER
}

/// How urgently it is needed. Derived urgency (an `urgent` flag somebody sets)
/// is how a request for a spare part ends up sitting for a week.
enum PurchasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// The request lifecycle. DRAFT exists because nobody wants half-written
/// requests in the approval inbox, and CANCELLED is distinct from REJECTED
/// because "we do not want this" and "we did not approve this" are different
/// answers to give the requester.
enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A department's request for something to be bought. The lines are the reason
/// it exists: a request with no lines has nothing to compare quotations against,
/// so `PurchaseRequestLine` is required rather than a description blob.
model PurchaseRequest {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human reference (`PR-2026-0007`), unique per organization — the codebase
  /// already numbers invoices, receipts and work orders this way, and a request
  /// read out over the phone needs one that is not a cuid.
  reference String

  title       String
  description String?          @db.Text
  category    PurchaseCategory
  priority    PurchasePriority @default(NORMAL)

  status PurchaseRequestStatus @default(DRAFT)

  /// Free-text department ("Maintenance", "Front Office"). The doc's
  /// `departmentId` implies a department table that does not exist; a lookup
  /// table here would be a second organization-wide concept to keep in step for
  /// no reporting gain. Kept as text until a real departments table exists.
  department String?

  neededBy DateTime?

  /// What the requester expects to spend. Nullable on purpose: a request is
  /// often raised before anyone knows, and a fabricated estimate is worse than a
  /// blank — the same rule the work-order cost fields follow.
  estimatedAmount Decimal? @db.Decimal(14, 2)

  currency String @default("KES")

  requestedById String?
  requestedBy   User?   @relation("UserRequestedPurchases", fields: [requestedById], references: [id], onDelete: SetNull)

  /// Set when approval was requested through Module 18's engine (entity
  /// PURCHASE_REQUEST). The instance itself is found by (entityType, entityId).
  approvalRequestedAt DateTime?

  decisionNote    String? @db.Text
  rejectionReason String? @db.Text

  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("UserDecidedPurchaseRequests", fields: [decidedById], references: [id], onDelete: SetNull)

  lines  PurchaseRequestLine[]
  rfqs   Rfq[]
  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([requestedById])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  description   String
  specification String? @db.Text

  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal? @db.Decimal(14, 2)
  estimatedAmount Decimal? @db.Decimal(14, 2)

  sortOrder Int @default(0)

  /// Which quotations answered this line, so a comparison view can show "every
  /// supplier priced this" rather than only the ones who happened to name a
  /// matching description.
  quotes RfqQuoteLine[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([purchaseRequestId])
  @@map("purchase_request_lines")
}

/// The request-quotation round: "here is what we need, tell us what it costs".
/// It is separate from the request because one request commonly goes to several
/// suppliers, and the whole point is the comparison between their answers.
///
/// `CLOSED` and `CANCELLED` are both terminal and distinct, for the same reason
/// they are on `PurchaseOrderStatus`: a round that ran its course is history,
/// while a round that was called off needs a recorded reason.
enum RfqStatus {
  DRAFT
  ISSUED
  QUOTES_RECEIVED
  CLOSED
  AWARDED
  CANCELLED
}

model Rfq {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference String

  title String
  notes String? @db.Text

  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  status RfqStatus @default(DRAFT)

  currency String @default("KES")

  /// When quotations are wanted back. Compared on read, never stored as a
  /// separate overdue flag.
  quotesDueAt DateTime?

  issuedAt           DateTime?
  closedAt           DateTime?
  awardedAt          DateTime?
  cancellationReason String?   @db.Text

  /// The suppliers that were asked, as their own rows rather than an id array:
  /// the invitation is a record with a date and an outcome, and a
  /// `String[]` has nowhere to put "invited on Tuesday, never replied".
  invitations RfqInvitation[]
  quotes      RfqQuote[]

  awardedQuoteId String?   @unique
  awardedQuote   RfqQuote? @relation("AwardedRfqQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)

  raisedById String?
  raisedBy   User?   @relation("UserRaisedRfqs", fields: [raisedById], references: [id], onDelete: SetNull)

  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@index([purchaseRequestId])
  @@map("rfqs")
}

enum RfqInvitationStatus {
  INVITED
  QUOTED
  DECLINED
}

model RfqInvitation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status RfqInvitationStatus @default(INVITED)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  /// Why they said no. Required to decline — a supplier who stops answering is
  /// invisible otherwise, and one silently dropped supplier is how a
  /// single-source purchase happens without anybody deciding it.
  declineReason String? @db.Text

  @@unique([rfqId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("rfq_invitations")
}

enum QuoteStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED
  AWARDED
  WITHDRAWN
}

model RfqQuote {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status QuoteStatus @default(SUBMITTED)

  /// The supplier's own total, as stated. `totalAmount` is derived from the
  /// quote's own lines, so a comparison table can never show a total that
  /// disagrees with the lines under it.
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  currency String @default("KES")

  /// How long they can hold the price, and when they can deliver. Both are the
  /// comparison's whole justification for preferring one quote over another —
  /// the cheapest price for something needed next week is not the cheapest.
  leadTimeDays Int?
  validUntil   DateTime?

  notes String? @db.Text

  awardedFor Rfq? @relation("AwardedRfqQuote")

  lines  RfqQuoteLine[]
  orders PurchaseOrder[]

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rfqId, supplierId])
  @@index([organizationId])
  @@index([rfqId])
  @@index([supplierId])
  @@map("rfq_quotes")
}

model RfqQuoteLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quoteId String
  quote   RfqQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Which requested line this answers. Optional, because a supplier may quote
  /// for the whole job in one line, or split it differently — forcing a match
  /// would make honest quotations impossible to enter.
  purchaseRequestLineId String?
  purchaseRequestLine   PurchaseRequestLine? @relation(fields: [purchaseRequestLineId], references: [id], onDelete: SetNull)

  description String

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0)

  @@index([organizationId])
  @@index([quoteId])
  @@index([purchaseRequestLineId])
  @@map("rfq_quote_lines")
}

/// A purchase order lifecycle. ACCEPTED is the supplier's confirmation, and
/// RECEIVED is goods physically arriving — the two are separate because the
/// failure everybody hits is a PO marked delivered because the supplier sent an
/// invoice. `CLOSED` and `CANCELLED` are both terminal but distinct: a closed
/// order was fulfilled and paid, a cancelled one never happened and its reason
/// is the audit trail.
enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference String

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status PurchaseOrderStatus @default(DRAFT)

  /// What this order is for, copied from the request/RFQ rather than looked up
  /// through them: an order outlives the documents that produced it, and the
  /// bill created from it needs a category regardless of whether the PR is
  /// still around.
  category PurchaseCategory
  currency String           @default("KES")

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  orderDate        DateTime  @default(now())
  /// Promised delivery, used to derive "overdue" on read rather than storing a
  /// flag that would rot while the supplier is quiet.
  expectedDelivery DateTime?

  deliveryAddress String? @db.Text
  terms           String? @db.Text
  notes           String? @db.Text

  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   RfqQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  /// The bill finance raised against this order. The doc's task list asks for PO
  /// completion to create a `SupplierBill`; master doc issue 70 warned against
  /// adding a speculative `billId` before deciding the direction, and this is
  /// that decision — the *bill* records the order (so a paid bill can always
  /// say which order it settles), and the order points back at its latest bill
  /// for convenience. A supplier may invoice in instalments, so this is not
  /// unique.
  supplierBillId String?
  supplierBill   SupplierBill? @relation("PurchaseOrderBill", fields: [supplierBillId], references: [id], onDelete: SetNull)

  sentAt             DateTime?
  acceptedAt         DateTime?
  receivedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  raisedById String?
  raisedBy   User?   @relation("UserRaisedPurchaseOrders", fields: [raisedById], references: [id], onDelete: SetNull)

  lines      PurchaseOrderLine[]
  deliveries GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([rfqId])
  @@index([purchaseRequestId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  description   String
  specification String? @db.Text

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  /// Derived from the goods receipts, never decremented — a reversal or a
  /// short delivery must not be able to make a line look unreceived.
  receivedQuantity Decimal @default(0) @db.Decimal(10, 2)

  sortOrder Int @default(0)

  receiptLines GoodsReceiptLine[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

/// One delivery of goods against an order. Kept as rows rather than a boolean on
/// the line because goods arrive in instalments and a partial delivery that
/// overwrote the line would lose the history of what came when.
model GoodsReceipt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receivedAt DateTime @default(now())

  /// The supplier's delivery note or waybill number.
  deliveryNote String?

  conditionNote String? @db.Text

  receivedById String?
  receivedBy   User?   @relation("UserReceivedPurchaseOrders", fields: [receivedById], references: [id], onDelete: SetNull)

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  quantity Decimal @db.Decimal(10, 2)

  /// Stock-in is Module 11's job. Until that module exists this column is
  /// deliberately null rather than a fake flag: the receipt records that goods
  /// arrived, and Module 11 fills in what happened to the stock. See master doc
  /// issue 70 for why no speculative link was added instead.
  inventoryItemId   String?
  stockInRecordedAt DateTime?

  @@index([organizationId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}
