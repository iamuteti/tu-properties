// This is your Prisma schema file for Real Estate Property Management SaaS
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// SYSTEM & AUDIT
// ============================================

// Organization/Tenant model - represents each company/organization in the system
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique // For URL identification

  // Subdomain configuration
  subdomain    String? @unique // e.g., "company1" from company1.tuhame.co.ke
  customDomain String? @unique // e.g., "app.company1.com"

  isActive Boolean @default(true)

  // Subscription
  plan          String @default("FREE") // FREE, STARTER, PROFESSIONAL, ENTERPRISE
  maxUsers      Int    @default(3)
  maxProperties Int    @default(10)

  // Branding (optional white-label)
  logoUrl      String?
  primaryColor String?

  // Contact
  contactEmail String?
  contactPhone String?

  // Legal & tax profile
  legalName String?
  taxId     String?

  // ── Tax jurisdiction ────────────────────────────────────────────────────
  // The rules engine is country-agnostic: nothing in the code assumes Kenya.
  // An organization declares where it is taxed, and the `TaxRule` rows for that
  // jurisdiction do the rest. `taxCountryCode` is ISO-3166-1 alpha-2 (KE, GB,
  // DE, US, ...); `taxRegionCode` is the optional sub-national level that many
  // countries actually tax by (US state, German Bundesland, Brazilian estado).
  taxCountryCode        String? @db.Char(2)
  taxRegionCode         String?
  // VAT/GST/sales-tax registration number, printed on invoices where the law
  // requires it. Separate from `taxId`, which is the company registration.
  taxRegistrationNumber String?

  // ── Payroll jurisdiction (Module 12) ───────────────────────────────────
  // Deliberately separate from `taxCountryCode`/`taxRegionCode` above. They are
  // usually the same and are usually worth inheriting, but they are not
  // *always* the same: a group registered for tax in one country routinely
  // employs staff in another, and statutory payroll in Kenya says almost nothing
  // about how those staff must be treated. Falling back to the tax jurisdiction
  // keeps the common case to zero fields while letting the divergent case be said
  // out loud. ISO-3166-1 alpha-2 plus the optional sub-national level, exactly as
  // above, for exactly the same reason.
  payrollCountryCode String? @db.Char(2)
  payrollRegionCode  String?

  /// BCP-47 tag (`en-KE`, `de-DE`, `fr-FR`) used to format payslips, payslip
  /// dates and any number this organization shows its staff.
  ///
  /// Stored, not assumed: 47 call sites across the frontend hardcode `en-KE`,
  /// which is a pre-existing flaw this module does not copy and, for payslips,
  /// actively fixes — an employee's payslip is the one document they may be
  /// contractually entitled to receive in their own language. `null` means "let
  /// the runtime decide", which is the correct behaviour and not an omission.
  /// Full UI translation is app-wide work and is NOT in this module's scope; see
  /// master doc issue 88.
  defaultLocale String? @db.VarChar(35)

  /// Which weekdays are non-working, as ISO day-of-week numbers where Monday is
  /// 1 and Sunday is 7 (so the ISO week reads left-to-right). Empty means
  /// Monday-to-Friday. Stored rather than assumed because "Saturday" is not a
  /// universal non-working day — it is a non-working day in much of the Gulf and
  /// India and a working day in much of Europe — and a weekend day silently
  /// changes how many days of annual leave a request costs.
  weekendDays Int[] @default([6, 7])

  // Regional defaults (System Settings) — money amounts still carry their
  // own currency per record; these are the org-level defaults.
  currency String @default("KES")
  timezone String @default("Africa/Nairobi")

  // Relationships
  users                      User[]
  properties                 Property[]
  tenants                    Tenant[]
  landlords                  Landlord[]
  leases                     RentalAgreement[]
  moveOutRequests            MoveOutRequest[]
  invoices                   Invoice[]
  payments                   Payment[]
  receipts                   Receipt[]
  auditLogs                  AuditLog[]
  branches                   Branch[]
  roles                      Role[]
  documents                  Document[]
  leads                      Lead[]
  contacts                   Contact[]
  communicationLogs          CommunicationLog[]
  saleTransactions           SaleTransaction[]
  commissions                Commission[]
  leaseTemplates             LeaseTemplate[]
  inspectionReports          InspectionReport[]
  tenantRequests             TenantRequest[]
  ownerStatements            OwnerStatement[]
  landlordPayouts            LandlordPayout[]
  landlordCharges            LandlordCharge[]
  accounts                   Account[]
  journalEntries             JournalEntry[]
  customerCredits            CustomerCredit[]
  paymentRefunds             PaymentRefund[]
  creditNotes                CreditNote[]
  taxRules                   TaxRule[]
  // Module 12 — HR & Payroll
  employees                  Employee[]
  payrollRules               PayrollRule[]
  payComponents              PayComponent[]
  leavePolicies              LeavePolicy[]
  holidays                   Holiday[]
  leaveRequests              LeaveRequest[]
  payrollRuns                PayrollRun[]
  payslips                   Payslip[]
  suppliers                  Supplier[]
  supplierBills              SupplierBill[]
  billPayments               BillPayment[]
  supplierCredits            SupplierCredit[]
  recurringBillingRuns       RecurringBillingRun[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  notificationChannelConfigs NotificationChannelConfig[]
  // Module 18 — Workflow Engine
  workflowDefinitions        WorkflowDefinition[]
  workflowInstances          WorkflowInstance[]
  workflowDelegations        WorkflowDelegation[]
  // Module 9 — Maintenance
  workOrders                 WorkOrder[]
  workOrderTasks             WorkOrderTask[]
  assets                     Asset[]
  pmSchedules                PreventiveMaintenanceSchedule[]
  pmRuns                     PreventiveMaintenanceRun[]
  // Module 10 — Procurement
  purchaseRequests           PurchaseRequest[]
  purchaseRequestLines       PurchaseRequestLine[]
  rfqs                       Rfq[]
  rfqInvitations             RfqInvitation[]
  rfqQuotes                  RfqQuote[]
  rfqQuoteLines              RfqQuoteLine[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderLines         PurchaseOrderLine[]
  goodsReceipts              GoodsReceipt[]
  goodsReceiptLines          GoodsReceiptLine[]
  // Module 11 — Inventory
  inventoryItems             InventoryItem[]
  warehouses                 Warehouse[]
  stockMovements             StockMovement[]
  // Module 13 — Facilities
  facilities                 Facility[]
  facilityBookings           FacilityBooking[]
  facilityBlackouts          FacilityBlackout[]
  accessCards                AccessCard[]
  visitors                   Visitor[]
visitorVisits              VisitorVisit[]
  // Module 14 — Utilities
  utilityMeters              UtilityMeter[]
  utilityRates               UtilityRate[]
  utilityCharges             UtilityCharge[]
  meterReadings              MeterReading[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([subdomain])
  @@map("organizations")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String
  lastName  String
  phone     String?

  // Authentication
  passwordHash String

  // Role & Permissions
  role UserRole @default(USER)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Tenant portal identity (Module 5, auth work in Module 1).
  //
  // Set only for self-service portal logins: such a user is a *resident* of
  // exactly one tenant record, and every /portal endpoint derives its scope
  // from this link rather than from anything the client sends. Staff users
  // leave it null and keep organization-scoped access.
  portalTenantId String?
  portalTenant   Tenant? @relation("TenantPortalUsers", fields: [portalTenantId], references: [id], onDelete: SetNull)
  isActive       Boolean @default(true)
  emailVerified  Boolean @default(false)

  // Audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Password reset flow
  resetPasswordToken   String? // hashed token for password reset
  resetPasswordExpires DateTime?

  // TOTP multi-factor auth (mfaSecret holds the base32 TOTP seed; only
  // populated while mfaEnabled is true)
  mfaSecret  String?
  mfaEnabled Boolean @default(false)

  auditLogs               AuditLog[]
  sessions                Session[]
  roleAssignments         RoleAssignment[]
  uploadedDocuments       Document[]
  assignedLeads           Lead[]                   @relation("UserAssignedLeads")
  loggedCommunications    CommunicationLog[]       @relation("UserLoggedCommunications")
  sales                   SaleTransaction[]        @relation("UserSales")
  commissions             Commission[]             @relation("UserCommissions")
  approvedCommissions     Commission[]             @relation("UserApprovedCommissions")
  approvedDeductions      MoveOutDeduction[]
  completedInspections    InspectionReport[]
  refundedMoveOuts        MoveOutRequest[]
  decidedTenantRequests   TenantRequest[]          @relation("UserDecidedTenantRequests")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // Module 18 — Workflow Engine: every "who did what to this approval" pointer.
  startedWorkflows       WorkflowInstance[]   @relation("UserStartedWorkflows")
  assignedWorkflowSteps  WorkflowStep[]       @relation("UserAssignedWorkflowSteps")
  actedWorkflowSteps     WorkflowStep[]       @relation("UserActedWorkflowSteps")
  workflowEventActors    WorkflowEvent[]      @relation("UserWorkflowEventActors")
  workflowEventDelegates WorkflowEvent[]      @relation("UserWorkflowEventDelegates")
  delegatedApprovalsOut  WorkflowDelegation[] @relation("UserWorkflowDelegatedFrom")
  delegatedApprovalsIn   WorkflowDelegation[] @relation("UserWorkflowDelegatedTo")

  // Module 9 — Maintenance: who is on the job, who raised it, who ticked a task.
  assignedWorkOrders      WorkOrder[]                     @relation("UserAssignedWorkOrders")
  raisedWorkOrders        WorkOrder[]                     @relation("UserRaisedWorkOrders")
  completedWorkOrderTasks WorkOrderTask[]                 @relation("UserCompletedWorkOrderTasks")
  assignedPmSchedules     PreventiveMaintenanceSchedule[] @relation("UserPmSchedules")

  // Module 10 — Procurement: who asked, who raised the RFQ, who raised the
  // order, who signed for the goods, who decided the request.
  requestedPurchaseRequests PurchaseRequest[] @relation("UserRequestedPurchases")
  decidedPurchaseRequests   PurchaseRequest[] @relation("UserDecidedPurchaseRequests")
  raisedRfqs                Rfq[]             @relation("UserRaisedRfqs")
  raisedPurchaseOrders      PurchaseOrder[]   @relation("UserRaisedPurchaseOrders")
  receivedPurchaseOrders    GoodsReceipt[]    @relation("UserReceivedPurchaseOrders")

  // Module 11 — Inventory: who booked stock in, out, adjusted or moved it.
  // Every one of those is a fact about a person, not about the item.
  recordedStockMovements StockMovement[] @relation("UserRecordedStockMovements")

  // Module 12 — HR. Exactly one direction, enforced by `Employee.userId`'s
  // unique constraint: a login and an employment record are separate things (a
  // caretaker may have no login at all; a property manager may be an employee
  // *and* hold a role that grants far more than self-service), and joining them
  // one-to-many would let one person be two employees.
  employeeRecord Employee?

  // Module 13 — Facilities. Who took the booking, who decided it, who issued the
  // card, who is being visited, who signed the visitor in.
  facilityBookingsMade   FacilityBooking[] @relation("UserMadeFacilityBookings")
  facilityBookingsDecided FacilityBooking[] @relation("UserDecidedFacilityBookings")
  facilityBlackouts       FacilityBlackout[] @relation("UserFacilityBlackouts")
  accessCards            AccessCard[]      @relation("UserAccessCards")
  hostedVisits           VisitorVisit[]    @relation("HostUserVisits")
preApprovedVisits      VisitorVisit[]    @relation("UserPreApprovedVisits")
  // Module 14 — Utilities. Who keyed in the reading, who raised the charge.
  meterReadings            MeterReading[]  @relation("UserMeterReadings")
  utilityChargesCreated    UtilityCharge[] @relation("UserUtilityCharges")

  // Status
  @@index([portalTenantId])
  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([resetPasswordToken])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROPERTY_MANAGER
  // Added in Module 5: the seeded Leasing Officer role had no UserRole counterpart,
  // so it could be granted permissions but never held. See master doc issue 48.
  LEASING_OFFICER
  ACCOUNTANT
  // Module 9: the seeded Maintenance Manager and Technician roles had the same
  // problem — permissions nobody could hold, and a work order with nobody to
  // assign it to. Same fix as LEASING_OFFICER, for the same reason.
  MAINTENANCE_MANAGER
  TECHNICIAN
  // Module 10: the seeded Procurement Officer role had exactly the same hole as
  // Leasing Officer and the two maintenance roles — permissions nobody could
  // hold, and a purchase request with nobody who is allowed to raise the RFQ.
  PROCUREMENT_OFFICER
  // Module 12: the seeded HR Manager role had exactly this problem — permissions
  // nobody could hold, and a role with no job behind it. Same hole as
  // LEASING_OFFICER (issue 48), the two maintenance roles (issue 67) and
  // PROCUREMENT_OFFICER (issue 75), now four instances deep.
  HR_MANAGER
  // Module 12: an employee is a person on the payroll who has a login to see
  // their OWN payslips and file their OWN leave request — and nothing else. The
  // seeded "Employee" role held permissions nobody could hold, which is the same
  // hole as LEASING_OFFICER (issue 48), the two maintenance roles (issue 67) and
  // PROCUREMENT_OFFICER (issue 75). Granting it anything wider than self-service
  // would be the mistake here: it is the one role guaranteed to be handed to
  // everybody eventually, and "everybody" is how salary data ends up readable by
  // the whole company.
  EMPLOYEE
  USER
}

model AuditLog {
  id String @id @default(cuid())

  // The acting user. Nullable so that deleting a user does not fail on
  // audit rows (an accountant cleaning up a departing colleague, for
  // example). The actor's identity remains preserved in `details`.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Tenant scoping: the organization the acting user belonged to at the
  // time of the action. NULL for platform-level actions (SUPER_ADMIN).
  // Denormalized on purpose so audit queries can filter by tenant without
  // a join through the entity being audited.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  action   String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity   String // Property, Unit, Lease, Invoice, etc.
  entityId String // The ID of the affected record

  details String? @db.Text // JSON or text description of changes

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Server-side session record backing the httpOnly auth cookie.
// Revoking a session (logout / revoke-others / password reset) sets
// revokedAt; the JWT strategy rejects any token whose jti maps to a
// revoked or expired session, which makes "kill this device" and
// "kill all other devices" real rather than cosmetic.
model Session {
  id     String @id @default(cuid())
  jti    String @unique // JWT "id" claim; one row per issued token
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Denormalized for cheap audit/session reporting; sourced from the user
  // at login time.
  organizationId String?

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Organization branch/office (Module 1: Core Platform). Tenant-scoped.
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  code    String?
  address String?
  city    String?
  phone   String?
  email   String?

  isActive Boolean @default(true)

  properties Property[]
  leads      Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("branches")
}

// Structured RBAC role. `organizationId = null` marks a system role
// (available to every organization); non-null marks an org-specific role.
// `permissions` is a JSON document of the shape:
//   { "all": boolean?, "modules": { "<module>": { "view": b, "create": b, "update": b, "delete": b } } }
// where <module> is one of: properties, units, landlords, tenants, leases,
// moveouts, invoices, payments, receipts, users, audit, settings,
// organizations, branches, documents.
model Role {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false)
  permissions Json

  assignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([name])
  @@map("roles")
}

// User ↔ Role link (table `user_roles`). The model is not named `UserRole`
// because that name is already taken by the legacy `UserRole` enum.
model RoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// Document center (Module 1: Core Platform). Polymorphic: entityType/entityId
// point at any tenant entity (Property, Unit, Tenant, Invoice, ...).
// `fileUrl` is the storage key/URL resolved by the configured storage driver
// (local disk by default, S3/MinIO when STORAGE_DRIVER=s3).
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String
  sizeBytes  Int    @default(0)

  // Re-uploading the same file for the same (entityType, entityId, fileName)
  // creates a new row with version = max + 1 instead of overwriting.
  version Int @default(1)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ============================================
// CORE ENTITIES (LANDLORDS & PROPERTIES)
// ============================================

model Landlord {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  status           TenantStatus @default(ACTIVE)
  email            String?
  phone            String?
  alternativePhone String?

  // Address
  address    String? @db.Text
  city       String?
  country    String?
  postalCode String?

  // Banking Details
  bankName      String?
  bankBranch    String?
  accountName   String?
  accountNumber String?

  // Tax Information
  taxPin        String?
  vatRegistered Boolean @default(false)

  // Management agreement (Module 6). The fee is deducted from the owner
  // statement: PERCENTAGE applies `managementFeeRate` (a percentage) to the rent
  // actually collected in the period, FIXED deducts `managementFeeAmount` once
  // per statement period.
  managementFeeType   ManagementFeeType @default(PERCENTAGE)
  managementFeeRate   Decimal           @default(0) @db.Decimal(5, 2)
  managementFeeAmount Decimal           @default(0) @db.Decimal(14, 2)

  // Free-form owner notes / instructions for whoever runs the account
  notes String? @db.Text

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
  properties      Property[]
  invoices        Invoice[]
  receipts        Receipt[]
  credits         CustomerCredit[] @relation("LandlordCredits")
  creditNotes     CreditNote[]     @relation("LandlordCreditNotes")
  ownerStatements OwnerStatement[]
  payouts         LandlordPayout[]
  charges         LandlordCharge[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([email])
  @@index([organizationId])
  @@map("landlords")
}

// ---------------------------------------------------------------------------
// Owner statements and payouts (Module 6: Landlord Management)
// ---------------------------------------------------------------------------

enum ManagementFeeType {
  PERCENTAGE
  FIXED
}

enum OwnerStatementStatus {
  DRAFT
  ISSUED
  SETTLED
  VOID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ChargeCategory {
  MAINTENANCE
  REPAIR
  UTILITIES
  INSURANCE
  TAX
  LEGAL
  OTHER
}

/// One period's owner account: what was collected, what it cost to run, what
/// the management fee was, and what is left to pay the owner.
///
/// Every money column is a frozen snapshot taken at generation time, and the
/// two `*Lines` columns hold the itemised breakdown. That is deliberate: an
/// ISSUED statement is a document the owner was sent, so it must keep
/// reconciling to its own lines even after an invoice or charge underneath it
/// is edited. Re-issuing means generating a new statement, not rewriting this.
model OwnerStatement {
  id              String        @id @default(cuid())
  statementNumber String        @unique
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId      String
  landlord        Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  currency    String   @default("KES")

  // Derived money (never typed in by hand).
  grossIncome    Decimal @db.Decimal(14, 2) // rent actually collected in the period
  expenses       Decimal @default(0) @db.Decimal(14, 2) // owner charges levied in the period
  managementFee  Decimal @default(0) @db.Decimal(14, 2)
  carriedForward Decimal @default(0) @db.Decimal(14, 2) // unpaid balance brought in from earlier statements
  netPayout      Decimal @db.Decimal(14, 2) // grossIncome - expenses - managementFee - carriedForward

  status   OwnerStatementStatus @default(DRAFT)
  issuedAt DateTime?
  notes    String?              @db.Text

  // Itemised snapshots: [{ ref, description, property, amount, ... }]
  incomeLines  Json
  expenseLines Json

  payouts LandlordPayout[]
  charges LandlordCharge[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  generatedBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("owner_statements")
}

/// Money leaving the company for an owner. v1 records the intent and its
/// outcome — the transfer itself is executed in the bank and the reference is
/// recorded here — because there is no banking integration to call.
model LandlordPayout {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId     String
  landlord       Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  // A payout usually settles one statement; a payout without one (arrears
  // catch-up, goodwill payment) is allowed.
  ownerStatementId String?
  ownerStatement   OwnerStatement? @relation(fields: [ownerStatementId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("KES")
  method   PaymentMethod @default(BANK_TRANSFER)
  status   PayoutStatus  @default(PENDING)

  reference     String? // bank transfer / cheque reference
  scheduledFor  DateTime?
  paidAt        DateTime?
  failureReason String?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([ownerStatementId])
  @@index([status])
  @@map("landlord_payouts")
}

/// A cost charged to an owner: repairs carried out, utilities the company
/// advanced, insurance, legal fees. Deducted from the next owner statement.
///
/// Deliberately not a general `Expense` table — Finance & Accounting (Module 7)
/// owns the general ledger and will own expenses. This is the owner-facing
/// slice of that idea: only amounts actually charged to a landlord, so an
/// owner statement can be built today without pretending the GL exists.
model LandlordCharge {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  landlordId     String
  landlord       Landlord      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  category    ChargeCategory
  description String
  amount      Decimal        @db.Decimal(14, 2)
  chargeDate  DateTime       @default(now())

  // Set once the charge has been rolled into an ISSUED statement; it then
  // belongs to that statement and must not be edited or deleted.
  ownerStatementId String?
  ownerStatement   OwnerStatement? @relation(fields: [ownerStatementId], references: [id], onDelete: SetNull)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([organizationId])
  @@index([landlordId])
  @@index([chargeDate])
  @@index([ownerStatementId])
  @@map("landlord_charges")
}

model Property {
  id           String    @id @default(cuid())
  code         String    @unique // Property Code
  name         String // Property Name
  dateAcquired DateTime? // Date Acquired
  lrNumber     String? // LR Number (Land Registry Number)

  // Lifecycle status (Module 2). Distinct from `type`/`category`, which
  // classify the asset. ARCHIVED hides the property from default listings.
  status PropertyStatus @default(ACTIVE)

  agencyRole    String? // Managing | Letting | Both
  category      String?
  type          String?
  specification String? // Multi-unit/Multi-Space

  // Location & Address
  country    String?
  estateArea String? // Estate/Area
  areaRegion String? // Area/Region
  roadStreet String? // Road/Street

  // Property Classification
  multiStoryType String? // Multi Story Type
  numberOfFloors Int? // No. Of Floors

  // Geographic Coordinates
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Notes & Contact Info
  notes               String? @db.Text // Property notes/description
  specificContactInfo String? @db.Text // Specific contact information

  // Relationships
  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Owning branch/office (Module 1 Branch → Module 2 Property). Nullable so
  // properties created before branches existed keep working.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Leads that asked about this property (Module 3 CRM).
  leads Lead[] @relation("PropertyLeads")

  // Open sales against this property (Module 4).
  sales SaleTransaction[] @relation("PropertySales")

  // Accounting & Billing Configuration
  accountLedgerType     String? // e.g., "Property Control Ledger in GL"
  primaryBankAccount    String? // Primary Bank/Account/Operating Account
  alternativeTaxPin     String? // Alternative Tax PIN
  propertyWorkingTaxPin String? // Property Working Tax PIN
  invoicePaymentInfo    String? @db.Text
  holderPaymentTerms    String? @db.Text

  // MPESA Configuration
  mpesaPropertyPayNumber   String?
  disableMpesaStkPush      Boolean @default(false)
  disableMpesaStkNarration Boolean @default(false)

  // Counters
  tenantReceiptAccountCodeCounter Int? @default(0)

  // Rent Penalty Configuration
  lpgExempted       Boolean @default(false)
  penaltyChargeMode String? // Penalty Charge Mode
  penaltyDay        Int? // Penalty Day

  // Landlord Banking Details
  landlordDrawerBank    String?
  landlordBankBranch    String?
  landlordAccountName   String?
  landlordAccountNumber String?

  // Communication Preferences
  exemptAllSms     Boolean @default(false)
  exemptInvoiceSms Boolean @default(false)
  exemptGeneralSms Boolean @default(false)
  exemptHagueSms   Boolean @default(false)
  exemptBalanceSms Boolean @default(false)

  exemptAllEmail     Boolean @default(false)
  exemptInvoiceEmail Boolean @default(false)
  exemptGeneralEmail Boolean @default(false)
  exemptReceiptEmail Boolean @default(false)
  exemptBalanceEmail Boolean @default(false)

  // Other Preferences
  excludeInTwoSummaryReport Boolean @default(false)

  // Related entities
  units            Unit[]
  standingCharges  PropertyStandingCharge[]
  securityDeposits PropertySecurityDeposit[]
  amenities        PropertyAmenity[]
  landlordCharges  LandlordCharge[]
  // Module 9: the equipment this building actually owns, and the faults found
  // against it. Both are SetNull on the way in, so retiring a property row does
  // not delete its maintenance history.
  assets           Asset[]
  workOrders       WorkOrder[]               @relation("PropertyWorkOrders")
  // Module 13 — Facilities. The bookable things this property owns, the cards
  // that open its doors, and the visitor log for its gate.
  facilities       Facility[]
  accessCards      AccessCard[]
visitorVisits    VisitorVisit[]
  // Module 14 — Utilities. `propertyId` on a meter is required precisely because
  // `Unit` has no `organizationId` (master doc issue 25): it is what makes
  // "every meter on this estate" answerable without joining through the unit.
  utilityMeters  UtilityMeter[]
  utilityRates   UtilityRate[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([landlordId])
  @@index([code])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@map("properties")
}

// Lifecycle status of a property record (Module 2: Property Management).
enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================
// UNITS & SPACES
// ============================================

model Unit {
  id       String  @id @default(cuid())
  code     String  @unique // Unit/Space No.
  name     String // Unit Name/Number
  sequence Int? // Unit Sequence
  type     String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Pricing
  quotedPrice     Decimal? @db.Decimal(10, 2)
  baseRent        Decimal? @db.Decimal(10, 2) // Market Rent
  basePerUnitArea Decimal? @db.Decimal(10, 2)
  currency        String   @default("KES")

  // Area/Space Management
  areaSqFt   Decimal? @db.Decimal(10, 2)
  chargePlan String?

  // Unit Details & Specifications
  floor            Int?
  bedrooms         Int? // Bedroom(s)
  bathrooms        Int? // Bathroom(s)
  furnished        Boolean @default(false)
  outSourceParking String? // Out Source/Parking

  // Ownership
  ownerOccupied Boolean @default(false)

  // Utility Account & Billing Numbers
  electricityAcno    String?
  waterAcno          String?
  electricityMeethno String?
  waterMeethno       String?

  // Letting Details
  takeOnLettingDate DateTime?

  // Tenant/Resident Code Counter
  tenantResidentCodeCounter Int? @default(0)

  // Notes
  apartmentNotes String? @db.Text

  // Status
  status UnitStatus @default(VACANT)

  // Relationships
  rentalAgreements RentalAgreement[]
serviceCharges   UnitServiceCharge[]
  features         UnitFeature[]
  inspections      InspectionReport[]
  // Module 9: faults reported against this unit, plus any unit-level equipment.
  workOrders       WorkOrder[]
  assets           Asset[]
  // Module 13 — Facilities. A unit-level access card (the fob that opens this
  // door and the parking bay outside it). `Unit` has no `organizationId`, so
  // scoping a card by its unit has to go through this relation — master doc
  // issue 25.
accessCards      AccessCard[]
  // Module 14 — Utilities. A sub-meter serves exactly one unit; a bulk meter has
  // no `unitId` at all, so `utilityMeters` here are the meters billed to *this*
  // unit and `utilityCharges` are this unit's share of whatever meters feed it.
  utilityMeters  UtilityMeter[]
  utilityCharges UtilityCharge[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([propertyId])
  @@index([status])
  @@map("units")
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model UnitServiceCharge {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  serviceUtilityAmenity String // Service/Charge/Utility/Amenity name
  costPerArea           Decimal? @db.Decimal(10, 2)
  totalCost             Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@map("unit_service_charges")
}

model UnitFeature {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name        String
  featureType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@map("unit_features")
}

// Structured amenities (Module 2). Replaces free-text amenity blobs so the
// list UI can filter/search on them; `category` groups them (e.g. "Security",
// "Parking", "Utilities") for report grouping.
model PropertyAmenity {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name     String
  category String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("property_amenities")
}

// ============================================
// CHARGES & DEPOSITS
// ============================================

model PropertyStandingCharge {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  chargeUtility    String // Charge/Utility name
  chargeMode       String // Billing mode
  billingCurrency  String   @default("KES")
  costPerArea      Decimal? @db.Decimal(10, 2)
  chargeValue      Decimal  @db.Decimal(10, 2)
  vatRate          Decimal? @db.Decimal(5, 2) // VAT percentage
  excludesWithRent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_standing_charges")
}

model PropertySecurityDeposit {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  month               String // Month identifier
  value               Decimal @db.Decimal(10, 2)
  ofRentBillingAmount Boolean @default(false)
  ofInitialRent       Boolean @default(false)
  ofLastEscalation    Boolean @default(false)
  excludesWithRent    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_security_deposits")
}

// ============================================
// TENANTS & LEASES
// ============================================

model Tenant {
  id            String @id @default(cuid())
  accountNumber String @unique // Account Number
  code          String @unique

  // Tenant Type & Personal Info
  tenantType String? // Individual, Corporate, etc.
  surname    String // Surname
  otherNames String? // Other Name(s)
  gender     String? // Gender

  // Status
  status TenantStatus @default(ACTIVE)

  // Contact Information
  email            String?
  phone            String // Mobile Number
  town             String?
  sendMobileNumber Boolean @default(false)

  // Identification & Tax
  idNoRegNo String? // ID No./REG No.
  taxPin    String? // Tax PIN

  // Address
  postalAddress String? @db.Text
  postalCode    String?
  country       String?

  // Photo
  photoUrl String? // URL to uploaded photo

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // CRM link (Module 3). A Tenant stays its own table — it is the lease party
  // with an account number, tax PIN and rent history — and is linked to the
  // shared people directory so contact history is visible from the tenant and
  // vice versa. One contact maps to at most one tenant.
  contactId String?  @unique
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Self-service portal logins that belong to this tenant.
  portalUsers User[] @relation("TenantPortalUsers")

  // Requests the resident submitted through the portal.
  requests TenantRequest[]

  // Relationships
  rentalAgreements  RentalAgreement[]
  emergencyContacts TenantEmergencyContact[]
  receipts          Receipt[]
  moveOutRequests   MoveOutRequest[]
  credits           CustomerCredit[]         @relation("TenantCredits")
  notifications     Notification[]           @relation("TenantNotifications")
  creditNotes       CreditNote[]             @relation("TenantCreditNotes")
  // Module 9: maintenance issues this resident reported. SetNull rather than
  // Cascade — a resident record is financial history and outlives their tenancy.
  workOrders        WorkOrder[]
  // Module 13 — Facilities. A resident books the clubhouse and the parking, a
  // contractor is on site as a visitor, and a resident may hold an access card.
  // All SetNull for the same reason as `workOrders`: none of these are the reason
  // the resident row exists.
  facilityBookings  FacilityBooking[]        @relation("TenantFacilityBookings")
  accessCards       AccessCard[]             @relation("TenantAccessCards")
  visitorVisits     VisitorVisit[]           @relation("HostTenantVisits")

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountNumber])
  @@index([code])
  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@map("tenants")
}

model TenantEmergencyContact {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactName  String
  relationship String?
  phone        String?
  email        String?

  // Priority (1 = primary, 2 = secondary)
  priority Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_emergency_contacts")
}

model RentalAgreement {
  id   String @id @default(cuid())
  code String @unique

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Agreement Type
  agreementType AgreementType @default(RENTAL)

  // Agreement Terms
  startDate  DateTime
  endDate    DateTime?
  rentAmount Decimal   @db.Decimal(10, 2)
  currency   String    @default("KES")
  paymentDay Int       @default(1)

  // Term Duration
  termMonths Int? // Lease term in months (null for rental)

  // Security Deposit
  securityDeposit Decimal? @db.Decimal(10, 2)

  // Lease-specific fields (commercial)
  escalationRate   Decimal? @db.Decimal(5, 2) // % increase per year
  escalationMonth  Int? // Month when rent escalates
  noticePeriodDays Int? // Notice period for termination

  // Status
  status AgreementStatus @default(DRAFT)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
invoices        Invoice[]
  // Module 14 — Utilities. Utility invoices raised against this lease.
  utilityCharges  UtilityCharge[]
  payments        Payment[]
  commissions     Commission[]
  moveOutRequests MoveOutRequest[]

  // Renewal chain (Module 5): a renewed lease points at its successor and the
  // successor points back, so the full history of a unit's tenancies is one
  // query instead of a date-range reconstruction.
  renewedToId   String?          @unique
  renewedTo     RentalAgreement? @relation("LeaseRenewals", fields: [renewedToId], references: [id], onDelete: SetNull)
  renewedFromId String?
  renewedFrom   RentalAgreement? @relation("LeaseRenewals")

  // Inspections attached to this tenancy (move-in, periodic, move-out)
  inspections InspectionReport[]

  // Resident requests raised against this tenancy
  tenantRequests TenantRequest[]

  // Audit fields
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  activatedAt      DateTime?
  terminatedAt     DateTime?
  terminatedReason String?
  expiredAt        DateTime?
  depositRefunded  Boolean   @default(false)

  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([organizationId])
  @@map("rental_agreements")
}

// Itemised deductions against a tenant's deposit. The refund is derived from
// these rows rather than typed in, so the number is always auditable: deposit
// − Σ(deductions) − unpaid rent.
model MoveOutDeduction {
  id               String         @id @default(cuid())
  moveOutRequestId String
  moveOutRequest   MoveOutRequest @relation(fields: [moveOutRequestId], references: [id], onDelete: Cascade)

  category    DeductionCategory
  description String
  amount      Decimal           @db.Decimal(10, 2)

  approvedById String?
  approvedBy   User?   @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moveOutRequestId])
  @@index([category])
  @@map("move_out_deductions")
}

enum DeductionCategory {
  DAMAGE
  CLEANING
  UNPAID_RENT
  LATE_FEE
  UTILITY
  REPAIRS
  OTHER
}

// Move-in / periodic / move-out condition report. Photos attach through the
// Document Center (entityType = 'InspectionReport'), not a bespoke upload path.
enum InspectionType {
  MOVE_IN
  PERIODIC
  MOVE_OUT
  ANNUAL
}

enum InspectionStatus {
  DRAFT
  COMPLETED
  VOID
}

enum ConditionRating {
  GOOD
  FAIR
  POOR
  DAMAGED
}

model InspectionReport {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  type   InspectionType
  status InspectionStatus @default(DRAFT)

  scheduledDate DateTime
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  notes String? @db.Text

  items InspectionItem[]

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([rentalAgreementId])
  @@index([status])
  @@index([organizationId])
  @@map("inspection_reports")
}

model InspectionItem {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  area      String // "Kitchen", "Bathroom", "Walls"…
  item      String // what was checked
  condition ConditionRating
  notes     String?         @db.Text

  // Estimated cost to put right, and whether the tenant is liable for it.
  estimatedCost  Decimal? @db.Decimal(10, 2)
  requiresAction Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("inspection_items")
}

// Reusable lease terms (Module 5). Applying a template prefills the create
// form; the saved agreement is always a full row, never a reference back here.
model LeaseTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  agreementType AgreementType @default(RENTAL)

  rentAmount       Decimal? @db.Decimal(10, 2)
  currency         String   @default("KES")
  securityDeposit  Decimal? @db.Decimal(10, 2)
  termMonths       Int?
  noticePeriodDays Int      @default(30)
  escalationRate   Decimal? @db.Decimal(5, 2)
  paymentDay       Int      @default(1)

  termsBody String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
  @@map("lease_templates")
}

model MoveOutRequest {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalAgreementId   String
  rentalAgreement     RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)
  moveoutDate         DateTime
  approvalDate        DateTime?
  approvedBy          String? // User ID who approved
  status              MoveOutStatus   @default(PENDING)
  depositRefunded     Boolean         @default(false)
  depositRefundAmount Decimal?        @db.Decimal(10, 2)
  notes               String?         @db.Text

  // Itemised deductions behind the refund (Module 5) — the refund is derived,
  // never typed in.
  deductions   MoveOutDeduction[]
  refundedAt   DateTime?
  refundedById String?
  refundedBy   User?              @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([rentalAgreementId])
  @@index([status])
  @@index([organizationId])
  @@map("move_out_requests")
}

enum AgreementType {
  LEASE // Commercial - long term
  RENTAL // Residential - monthly
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum MoveOutStatus {
  PENDING
  APPROVED
  // Added in Module 5: the refund is a real settlement step, so a move-out that
  // has been paid out is COMPLETED rather than merely APPROVED.
  COMPLETED
  REJECTED
}

// ============================================
// CRM (LEADS, CONTACTS, COMMUNICATIONS)
// ============================================

// Where a lead came from. WEBSITE/FACEBOOK are the two automated sources the
// public webhook feeds; WHATSAPP is manual until a Business API integration
// exists.
enum LeadSource {
  WEBSITE
  FACEBOOK
  WHATSAPP
  WALK_IN
  REFERRAL
  OTHER
}

// Pipeline stage. WON/LOST are terminal: a lead in either state cannot be
// moved again without reopening it (see leads.service).
enum LeadStage {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Who is asking. The CRM target sketch only carried `source`/`status`; a lead
  // without contact details cannot be worked, so the enquiry details live on
  // the lead until it is converted to a Contact.
  firstName String
  lastName  String?
  email     String?
  phone     String?
  message   String? @db.Text

  source       LeadSource @default(OTHER)
  sourceDetail String? // e.g. website form name, Facebook page, referrer

  stage      LeadStage @default(NEW)
  lostReason String?

  // What they are interested in, and who owns the follow-up.
  interestedPropertyId String?
  interestedProperty   Property? @relation("PropertyLeads", fields: [interestedPropertyId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedAgentId String?
  assignedAgent   User?   @relation("UserAssignedLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // Set once the lead is converted: the contact it became, and when.
  contactId   String?
  contact     Contact?  @relation("LeadContact", fields: [contactId], references: [id], onDelete: SetNull)
  convertedAt DateTime?

  communications CommunicationLog[]
  sales          SaleTransaction[]  @relation("LeadSales")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([organizationId])
  @@index([stage])
  @@index([source])
  @@index([assignedAgentId])
  @@index([interestedPropertyId])
  @@index([email])
  @@map("leads")
}

enum ContactType {
  BUYER
  TENANT
  LANDLORD
  INVESTOR
  AGENT
  LAWYER
}

// The shared people directory used across leasing and sales. Deliberately
// separate from `Tenant`: a tenant is a lease party with its own account
// number, tax PIN and rent history, whereas a contact is just a person we
// talk to. They are linked via `Tenant.contactId`.
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type      ContactType @default(BUYER)
  firstName String
  lastName  String

  email   String?
  phone   String?
  company String?
  notes   String? @db.Text

  isActive Boolean @default(true)

  leads          Lead[]             @relation("LeadContact")
  sales          SaleTransaction[]  @relation("ContactSales")
  communications CommunicationLog[]
  tenant         Tenant?
  // Module 13 — Facilities. A contact is the shared people directory, so a
  // contractor who books the clubhouse or a supplier engineer who is on site as a
  // visitor hangs off the same row a lead would.
  facilityBookings FacilityBooking[] @relation("ContactFacilityBookings")
  accessCards      AccessCard[]      @relation("ContactAccessCards")
  visitorVisits    VisitorVisit[]    @relation("HostContactVisits")
  visitorRecords   Visitor[]         @relation("VisitorContact")


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([email])
  @@map("contacts")
}

enum CommChannel {
  EMAIL
  SMS
  WHATSAPP
  CALL
  NOTE
  MEETING
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

// Every conversation artefact against a contact (or a lead that has not been
// converted yet). Nothing is sent anywhere yet — Modules 18 (Notifications)
// and the WhatsApp/e-mail integrations are the senders; this is the record.
model CommunicationLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel   CommChannel
  direction CommDirection @default(OUTBOUND)
  subject   String?
  content   String?       @db.Text
  outcome   String? // for calls: "answered", "no answer", "rescheduled…"

  occurredAt DateTime @default(now())

  loggedById String?
  loggedBy   User?   @relation("UserLoggedCommunications", fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([occurredAt])
  @@map("communication_logs")
}

// ============================================
// TENANT REQUESTS (self-service, approved by staff)
// ============================================

// What a resident can *ask* for in the portal. A request never changes a lease
// by itself: it is decided by staff, and approval delegates to the same
// services staff would have called by hand.
enum TenantRequestType {
  RENEWAL
  MOVE_OUT
  PAYMENT_PLAN
  MAINTENANT
  LEASE_AMENDMENT
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model TenantRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  type   TenantRequestType
  status TenantRequestStatus @default(PENDING)

  // What the resident asked for, snapshotted at submission so a later change
  // to the lease cannot rewrite their request.
  payload Json

  preferredDate DateTime?

  // Set when a move-out date falls inside the lease's notice period: a flag for
  // staff to decide on, not a refusal — the resident is allowed to ask.
  earlyNotice Boolean @default(false)

  note String? @db.Text

  // Staff decision
  decidedById  String?
  decidedBy    User?     @relation("UserDecidedTenantRequests", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?   @db.Text

  // What the approval actually did, so the queue stays auditable.
  result Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([tenantId, status])
  @@index([rentalAgreementId])
  @@map("tenant_requests")
}

// ============================================
// SALES MANAGEMENT
// ============================================

// A property sale moves strictly forward through these stages; CANCELLED is
// reachable from any stage before HANDOVER. The transition rules (which gates
// each move) live in `modules/sales/sale-stage.ts`.
enum SaleStage {
  QUOTATION
  OFFER
  RESERVATION
  AGREEMENT
  PAYMENT
  HANDOVER
  CANCELLED
}

enum InstallmentStatus {
  SCHEDULED
  INVOICED
  PAID
  OVERDUE
  WAIVED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model SaleTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code String @unique // Sale reference, e.g. SALE-2026-0001

  // What is being sold. `Restrict`: a property with an open sale cannot be
  // deleted out from under it.
  propertyId String
  property   Property @relation("PropertySales", fields: [propertyId], references: [id], onDelete: Restrict)

  // Snapshot of the property name/title at the time the sale was opened, so a
  // renamed or archived property does not rewrite history.
  propertyTitle String?

  // Buyer comes from the CRM contacts directory (Module 3).
  buyerContactId String?
  buyerContact   Contact? @relation("ContactSales", fields: [buyerContactId], references: [id], onDelete: SetNull)

  // Lead this sale came from, when it started in the CRM pipeline.
  leadId String?
  lead   Lead?   @relation("LeadSales", fields: [leadId], references: [id], onDelete: SetNull)

  // Primary agent. Additional agents are rows in `Commission` (split support).
  agentUserId String?
  agent       User?   @relation("UserSales", fields: [agentUserId], references: [id], onDelete: SetNull)

  stage SaleStage @default(QUOTATION)

  // Money
  askingPrice   Decimal? @db.Decimal(14, 2)
  agreedPrice   Decimal? @db.Decimal(14, 2)
  bookingFee    Decimal? @db.Decimal(14, 2)
  depositAmount Decimal? @db.Decimal(14, 2)
  currency      String   @default("KES")

  // Commission basis for this sale, as a percentage of the agreed price.
  // Individual splits are stored on `Commission.splitPercentage`.
  commissionRate Decimal? @db.Decimal(5, 2)

  // Stage dates, stamped when the sale enters each stage (audit trail)
  quotationDate      DateTime?
  offerDate          DateTime?
  reservationDate    DateTime?
  agreementDate      DateTime?
  paymentDate        DateTime?
  handoverDate       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  notes String? @db.Text

  installments SaleInstallment[]
  commissions  Commission[]
  invoices     Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([organizationId])
  @@index([stage])
  @@index([propertyId])
  @@index([buyerContactId])
  @@map("sale_transactions")
}

// An agreed payment schedule. `invoiceId` is the Finance invoice raised for
// the installment — installment billing reuses `InvoicesService` rather than
// duplicating invoicing logic.
model SaleInstallment {
  id                String          @id @default(cuid())
  saleTransactionId String
  saleTransaction   SaleTransaction @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)

  sequence    Int // 1-based position in the schedule
  description String // e.g. "Deposit", "Second instalment"
  amount      Decimal           @db.Decimal(14, 2)
  dueDate     DateTime
  status      InstallmentStatus @default(SCHEDULED)
  invoiceId   String?           @unique
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paidAt      DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([saleTransactionId, sequence])
  @@index([saleTransactionId])
  @@index([status])
  @@map("sale_installments")
}

// Commission earned on a sale (or, for the leasing side that the schema also
// allows, on a rental agreement). `splitPercentage` is the agent's share of
// the sale's commission; the rows for one sale are expected to add up to 100.
model Commission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleTransactionId String?
  saleTransaction   SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)

  // The leasing side of the same commission concept. Module 5 wires this up.
  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  agentUserId String
  agent       User   @relation("UserCommissions", fields: [agentUserId], references: [id], onDelete: Restrict)

  amount          Decimal  @db.Decimal(14, 2)
  splitPercentage Decimal? @db.Decimal(5, 2)
  currency        String   @default("KES")

  // What the commission was earned on: the sale price, the booking fee, a
  // referral, or an agent's cut of another agent's deal.
  basis String @default("SALE")

  status CommissionStatus @default(PENDING)
  notes  String?          @db.Text

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("UserApprovedCommissions", fields: [approvedById], references: [id], onDelete: SetNull)

  paidAt  DateTime?
  paidRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([saleTransactionId])
  @@index([agentUserId])
  @@index([status])
  @@map("commissions")
}

// ============================================
// BILLING & PAYMENTS
// ============================================

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  // Landlord (recipient of invoice) - replaces lease reference
  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)

  // Keep rental agreement reference for backward compatibility and property tracking
  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  // Sale instalment link (Module 4). Sale invoices are raised by the Sales
  // module through `InvoicesService` and classified with
  // `transactionClass = 'SALE'`; they are not rental invoices.
  saleTransactionId String?
saleTransaction   SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)

  // Utility consumption link (Module 14). Consumption invoices are raised by the
  // Utilities module through `InvoicesService` and classified with
  // `transactionClass = 'UTILITY'`. The FK lives on `UtilityCharge` rather than
  // here, because one invoice collects several charges (water, electricity, a
  // standing charge) - so the relation is one invoice to many charges, and only
  // one side of it needs a foreign key.
  utilityCharges UtilityCharge[]

  // Invoice Details
  issueDate   DateTime @default(now())
  dueDate     DateTime
  amount      Decimal  @db.Decimal(10, 2)
  vatAmount   Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")

  // Transaction classification for accounting
  transactionClass String? // Transaction Class - for accounting classification

  // Accounts receivable for general ledger integration
  acReceivable String? // A/C Receivable - accounts receivable account // TODO Should be connected to another tabled

  // Billing address information
  billTo String? @db.Text // Bill To - billing address

  // Multi-currency support
  spotRate Decimal? @db.Decimal(10, 4) // Spot Rate - exchange rate for multi-currency

  // Purchase order tracking
  lpoNumber String? // LPO # - purchase order number

  // Digital signature tracking
  signOnEfims Boolean @default(false) // Sign On eFims - digital signature indicator

  // Payment instructions
  paymentInfo String? @db.Text // Payment Info - payment instructions

  // Terms and conditions
  termsConditions String? @db.Text // Terms & Conditions - invoice terms

  // Additional notes
  memo String? @db.Text // Memo - additional notes

  // Status
  status InvoiceStatus @default(PENDING)

  // Recurring billing (Module 7): the period this invoice bills for, e.g.
  // "2026-10". Set only by the generator, and unique per lease — so a second run
  // of the same period cannot produce a duplicate rent bill, which is the whole
  // reason a scheduler needs one. Null on every manually raised invoice.
  billingPeriod String?

  // Payment tracking
  paidAmount    Decimal @default(0) @db.Decimal(10, 2)
  balanceAmount Decimal @db.Decimal(10, 2)

  // Tax provenance (Module 7 rules engine). `amount`/`vatAmount`/`totalAmount`
  // remain the single source of truth for the money; these record what the
  // engine decided and under whose jurisdiction, so a document issued in one
  // country is not silently re-read under another's rules.
  taxJurisdiction   String? // e.g. "KE", "US-CA" — snapshotted at issue
  taxBasis          TaxBasis?
  /// Per-rule totals, e.g. [{ "code": "VAT", "rate": 16, "amount": 1600,
  /// "account": "2100" }]. JSON so a jurisdiction with three tax types does not
  /// need a migration to invoice its fourth.
  taxSummary        Json?
  // Withholding tax collected on the invoice is deducted from what we remit,
  // never added to what the customer owes.
  taxWithheldAmount Decimal   @default(0) @db.Decimal(10, 2)

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relationships
  invoiceItems       InvoiceItem[]
  payments           Payment[]
  creditApplications CreditApplication[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]

  // Audit fields
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  saleInstallment SaleInstallment?

  @@unique([rentalAgreementId, billingPeriod])
  @@index([rentalAgreementId])
  @@index([saleTransactionId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Revenue/Expense item classification for accounting
  revenueExpenseItem String? // Revenue/Expense Item - for accounting categorization

  // Description of the line item (maps to "Particular" in form)
  description String // Particular - description of the line item

  // Income account for general ledger integration
  incomeAccount String? // Income Account - for general ledger integration

  // Quantity and pricing
  quantity  Decimal @default(1) @db.Decimal(10, 2) // Qty - quantity of items
  unitPrice Decimal @db.Decimal(10, 2) // Unit Cost - price per unit

  // Line total
  amount Decimal @db.Decimal(10, 2) // Line Total - total amount for this line

  // Tax information
  vatRate   Decimal? @db.Decimal(5, 2) // Tax Rate - VAT percentage
  vatAmount Decimal? @db.Decimal(10, 2) // Tax Amount - calculated VAT amount

  // Tax rule snapshot (Module 7 rules engine). The rate and amount above are
  // what the invoice was issued with; these record *which* rule produced them,
  // so an invoice dated under an old rate stays explicable after the rule
  // changes, and a mixed-tax invoice says which line was which.
  taxRuleId    String?
  taxRule      TaxRule?      @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  taxCode      String? // e.g. "VAT", "GST", "WHT" — snapshotted so the document
  // is readable even if the rule is renamed or deleted
  taxBasis     TaxBasis?
  taxTreatment TaxTreatment?

  // Additional classification
  className String? // Class - additional classification for reporting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Receipt {
  id              String          @id @default(cuid())
  receiptId       String          @unique // Receipt ID
  receiptType     ReceiptType     @default(ApplyToInvoice)
  receiptCategory ReceiptCategory @default(Rent)

  // Common fields
  receivedFrom   String
  paymentMethod  PaymentMethod
  depositIntoAc  String?
  refNo          String?
  chequeNo       String?
  chequeDate     DateTime?
  recordingDate  DateTime      @default(now())
  amountReceived Decimal       @db.Decimal(10, 2)
  notes          String?       @db.Text

  // Rent receipt specific fields
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId         String?
  landlord           Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)
  recordDate         DateTime?
  bankingDate        DateTime?
  paymentRefNo       String?
  amountVatInclusive Boolean   @default(true)
  receiptTo          ReceiptTo @default(Landlord)
  drtOrDrf           DRTOrDRF  @default(DepositRefund)
  memo               String?   @db.Text
  paymentBank        String?
  currency           String    @default("KES")
  spotRate           Decimal?  @db.Decimal(10, 4)

  // Relationships
  payments     Payment[]
  receiptLines ReceiptLine[]

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  recordedBy String?

  @@index([tenantId])
  @@index([landlordId])
  @@index([receiptType])
  @@index([receiptCategory])
  @@index([recordingDate])
  @@index([paymentMethod])
  @@index([organizationId])
  @@map("receipts")
}

enum ReceiptCategory {
  Rent
  General
  Refund
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  // Payment Details
  paymentDate DateTime @default(now())
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("KES")
  spotRate    Decimal? @db.Decimal(10, 4) // Spot Rate

  // Payment Method
  paymentMethod    PaymentMethod
  paymentReference String? // Ref No. (Bank ref, M-Pesa code, etc.)

  // Payment Parties
  payee    String?
  paidFrom String?
  paidTo   String?

  // Payment Type
  paymentType PaymentType @default(ApplyToBill)

  // Cheque details
  chequeNumber String?
  chequeDate   DateTime?

  // MPESA specific
  mpesaReceiptNumber String?
  mpesaPhoneNumber   String?

  // Notes and Attachments
  notes       String? @db.Text
  attachments String? // JSON or comma-separated file paths

  // Reversal bookkeeping (Module 7). A payment applied in error is reversed,
  // never deleted: the row stays so the history of what was once applied to an
  // invoice remains auditable, and the GL entry is posted in reverse.
  isReversed Boolean   @default(false)
  reversedAt DateTime?
  reversedBy String?

  // Module 8: how much of this payment has been pointed at an invoice. A
  // payment that arrives without one stays at 0 until `allocate` runs, and the
  // remainder becomes customer credit rather than being lost.
  appliedAmount Decimal @default(0) @db.Decimal(12, 2)

  // Module 8: refunds and the credits that overpayments create.
  refunds       PaymentRefund[]
  allocations   PaymentAllocation[]
  sourceCredits CustomerCredit[]    @relation("CreditSourcePayments")

  // Organization/Tenant association
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  recordedBy String?

  @@index([rentalAgreementId])
  @@index([invoiceId])
  @@index([receiptId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([organizationId])
  @@map("payments")
}

/// Module 8 — Payments: what part of a payment settled which invoice.
///
/// Without this the only record of the split is `Invoice.paidAmount`, and the
/// moment money comes back (a refund) or a payment is over-applied, the true
/// figure cannot be recovered: a 5,000 payment against a 3,000 invoice is 3,000
/// paid and 2,000 on credit, but `Payment.amount` says 5,000. Every figure the
/// invoice shows is derived from these rows, so the split survives refunds and
/// reversals.
model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  createdBy String?

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum PaymentType {
  ApplyToBill
  CashPayment
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MPESA
  CARD
  OTHER
}

enum ReceiptType {
  ApplyToInvoice
  CashReceipt
}

enum ReceiptTo {
  Landlord
  GeneralLedger
}

enum DRTOrDRF {
  DirectReceipt
  DepositRefund
}

/// Chart of accounts (Module 7 — Finance & Accounting). One row per
/// organization: accounts are tenant-scoped so two organizations never share
/// (or can read) each other's ledger structure. `code` is unique per
/// organization, `type` drives the trial balance grouping.
model Account {
  id          String      @id @default(cuid())
  code        String
  name        String
  type        AccountType
  subtype     String?
  description String?     @db.Text

  // Normal balance of the account, used when rendering balances and when
  // validating manual journal entries.
  normalBalance BalanceSide @default(DEBIT)

  // System accounts (cash on hand, bank, AR, VAT payable, rent revenue, ...)
  // are seeded per organization and cannot be deleted — they are the target of
  // auto-posted entries. Custom accounts added by an accountant can be removed.
  isSystem Boolean @default(false)

  // Postable accounts accept journal lines; header/parent accounts (e.g.
  // "Current Assets" grouping) do not.
  isPostable Boolean @default(true)

  isActive Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BalanceSide {
  DEBIT
  CREDIT
}

/// A double-entry journal entry. Routine transactions (invoice issued, payment
/// received) are auto-posted by `AccountingService`; entries created manually
/// carry `source = MANUAL`.
model JournalEntry {
  id          String @id @default(cuid())
  entryNumber String

  entryDate DateTime @default(now())

  memo      String? @db.Text
  reference String?

  source JournalEntrySource @default(MANUAL)

  /// Free-form pointer back to the business record that caused the entry, e.g.
  /// { "type": "INVOICE", "id": "clx...", "number": "INV-202601-0001" }.
  /// Stored as JSON so new source types do not need a migration.
  sourceRef Json?

  status JournalEntryStatus @default(POSTED)

  /// Reversal bookkeeping — a reversed entry keeps its lines and points at the
  /// reversing entry instead of being deleted, so history stays auditable.
  reversedByEntryId String?       @unique
  reversedByEntry   JournalEntry? @relation("EntryReversal", fields: [reversedByEntryId], references: [id], onDelete: SetNull)
  reversesEntryId   String?       @unique
  reversesEntry     JournalEntry? @relation("EntryReversal")

  postedBy String?
  postedAt DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([entryDate])
  @@index([source])
  @@map("journal_entries")
}

enum JournalEntrySource {
  MANUAL
  INVOICE
  PAYMENT
  RECEIPT
  LEASE
  CREDIT_NOTE
  PAYOUT
  REFUND
  BILL
  BILL_PAYMENT
  // Module 12 — HR & Payroll. Distinct from `MANUAL` on purpose: a payroll entry
  // posted by hand and a payroll entry the engine produced look identical in the
  // ledger, and the difference matters when somebody asks who paid this month's
  // salaries and whether the totals reconcile to the bank.
  PAYROLL
  OPENING_BALANCE
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

/// One side of a journal entry. Exactly one of debit/credit is non-zero; the
/// entry as a whole must balance (see `AccountingService.postEntry`).
model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String? @db.Text

  // Entity the line belongs to, for per-tenant/landlord/property reporting.
  memo String? @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// Module 8 — Payments: money the customer is owed back.
///
/// A credit arises whenever money arrives that no invoice needs: an
/// overpayment on an invoice, an unallocated receipt, a goodwill gesture, or
/// the unspent part of a payment that was later refunded. Without this, an
/// overpaid tenant's money simply vanishes from the system.
///
/// `amount` is what was granted, `appliedAmount` what has since been consumed
/// against invoices — the usable balance is the difference. Credits are spent
/// oldest-invoice-first by `CreditsService`.
model CustomerCredit {
  id            String  @id @default(cuid())
  amount        Decimal @db.Decimal(12, 2)
  appliedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("KES")

  reason String? @db.Text

  source CustomerCreditSource @default(MANUAL)

  /// The payment that generated this credit, when it came from one.
  sourcePaymentId String?
  sourcePayment   Payment? @relation("CreditSourcePayments", fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  // Who the credit belongs to. At least one of these (or `customerName`) is
  // set: credit is meaningless if you cannot say whose it is.
  tenantId     String?
  tenant       Tenant?   @relation("TenantCredits", fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId   String?
  landlord     Landlord? @relation("LandlordCredits", fields: [landlordId], references: [id], onDelete: SetNull)
  customerName String?

  status CreditStatus @default(OPEN)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  applications CreditApplication[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("customer_credits")
}

enum CustomerCreditSource {
  OVERPAYMENT
  UNALLOCATED_RECEIPT
  GOODWILL
  REFUND_UNSPENT
  MANUAL
}

enum CreditStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  VOID
}

/// One consumption of a credit against one invoice. Kept as rows (not a
/// counter alone) so "which invoice did this credit pay?" is answerable.
model CreditApplication {
  id       String         @id @default(cuid())
  creditId String
  credit   CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  appliedAt DateTime @default(now())
  appliedBy String?

  @@index([creditId])
  @@index([invoiceId])
  @@map("credit_applications")
}

/// A refund of money already received. `Payment` rows are never edited or
/// deleted to represent money going back — this records the direction explicitly
/// and links to the credit note the refund produces, so the audit trail reads
/// "they paid, we refunded", not "the payment never happened".
model PaymentRefund {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  reason String  @db.Text

  refundReference String?
  processedAt     DateTime @default(now())
  processedBy     String?

  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@map("payment_refunds")
}

/// Module 8 — Payments: a document reducing what a customer owes. Issued
/// automatically when a payment is refunded, and available on its own for
/// write-offs and corrections. Applying a credit note leaves a credit balance
/// rather than pushing a negative amount onto an invoice.
model CreditNote {
  id               String @id @default(cuid())
  creditNoteNumber String @unique

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The invoice this note reduces. Null for a goodwill/advance note.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  refund PaymentRefund?

  tenantId   String?
  tenant     Tenant?   @relation("TenantCreditNotes", fields: [tenantId], references: [id], onDelete: SetNull)
  landlordId String?
  landlord   Landlord? @relation("LandlordCreditNotes", fields: [landlordId], references: [id], onDelete: SetNull)

  issueDate DateTime @default(now())

  reason String  @db.Text
  notes  String? @db.Text

  subtotal    Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String  @default("KES")

  status CreditNoteStatus @default(ISSUED)

  lines CreditNoteLine[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@map("credit_notes")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  vatRate   Decimal? @db.Decimal(5, 2)
  vatAmount Decimal? @db.Decimal(12, 2)

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

/// Module 7 — Finance & Accounting: the configurable tax rules engine.
///
/// Tax is configuration, not code. An organization says where it operates and
/// its accountant records the tax types that apply there; nothing in the
/// codebase assumes a country, a currency, or that "VAT at 16%" is a constant.
/// Renaming `code`, changing a rate, or adding a jurisdiction is a data change.
///
/// One rule = one tax type for a period. Multiple rules may be active at once
/// (VAT plus a withholding tax, or a standard and a reduced rate), which is why
/// calculation is a small pipeline rather than a single multiplication.
model TaxRule {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String? @db.Text

  // ISO-3166-1 alpha-2 country the rule belongs to (KE, GB, DE, ...). A null
  // country means the rule is the organization's fallback for anywhere it
  // trades without a more specific match.
  countryCode String? @db.Char(2)

  // Optional sub-national level (US state, German Bundesland, ...). When set,
  // the rule only applies to an organization whose `taxRegionCode` matches.
  regionCode String?

  /// How this tax relates to the stated price.
  ///
  /// `INCLUSIVE` — the price already contains the tax (a €119 VAT-inclusive
  /// rate is 100 + 19), which is how most consumer sales are advertised.
  /// `EXCLUSIVE` — tax is added on top of the price.
  ///
  /// Some jurisdictions are mixed (goods exclusive, services inclusive), so
  /// this is per rule and not a global switch.
  basis TaxBasis @default(EXCLUSIVE)

  /// Tax charged on top of another tax (EU-style compound VAT, or an Indian
  /// GST-on-service-fee). `compoundOnRuleId` names the rule it stacks onto;
  /// the engine rejects a compound rule with nothing to compound on.
  isCompound       Boolean   @default(false)
  compoundOnRuleId String?
  compoundOnRule   TaxRule?  @relation("CompoundTax", fields: [compoundOnRuleId], references: [id], onDelete: SetNull)
  compoundsOn      TaxRule[] @relation("CompoundTax")

  /// Percentage rate, four decimal places so reduced and fractional rates
  /// (7.7% Brazil ISS, 5% reduced VAT) are exact. Stored as a percentage, not
  /// a fraction: 16.0000 means 16%.
  rate Decimal @db.Decimal(7, 4)

  /// Where the collected tax lands in the ledger. Without it the engine posts
  /// every tax to 2100 (VAT payable), which silently merges a withholding tax
  /// into VAT and makes the trial balance a lie.
  ledgerAccountCode String? @default("2100")

  /// Whether the tax is shown as its own line on an invoice (sales tax) or is
  /// withheld from the customer's payment and never billed to them
  /// (withholding tax).
  treatment TaxTreatment @default(CHARGED)

  /// Which kind of charge this rate is for. `'*'` (the default) applies
  /// everywhere. A jurisdiction with a standard and a reduced rate — Germany's
  /// 19% and 7% VAT — sets both to `'*'` plus one category, and an invoice line
  /// tagged with that category gets the reduced rate instead of both. Matching
  /// is by the line's `revenueExpenseItem`, falling back to `'*'`.
  appliesToCategory String @default("*")

  /// Effective window. Two rules may exist for the same country/code with
  /// different windows so a rate change is data, not a migration — and an
  /// invoice dated inside the old window keeps the old rate.
  validFrom DateTime  @default(now())
  validTo   DateTime?

  isActive Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  // Identity of a rule: one tax, in one place, for one line category, from one
  // date. `appliesToCategory` is part of it because a standard and a reduced
  // rate of the same tax are two rules with the same code and different
  // categories.
  @@unique([organizationId, code, countryCode, regionCode, appliesToCategory, validFrom])
  @@index([organizationId])
  @@index([countryCode])
  @@map("tax_rules")
}

enum TaxBasis {
  EXCLUSIVE
  INCLUSIVE
}

enum TaxTreatment {
  /// Added to the invoice as a visible line the customer pays.
  CHARGED
  /// Deducted by us when paying the supplier/authority; the customer never
  /// sees it on an invoice.
  WITHHELD
}

/// Module 7 — Finance & Accounting: the accounts payable side.
///
/// The mirror of what already exists for receivables, and deliberately built on
/// the same primitives: money never moves without a `PaymentAllocation`-style
/// record saying which bill it settled, an invoice-like bill's money columns are
/// derived rather than decremented, and correcting anything posts a reversal
/// rather than editing history. A supplier who overpays us is owed money, which
/// is the same shape as a tenant who overpaid us — `SupplierCredit` is the
/// payable-side counterpart of `CustomerCredit`.
model Supplier {
  id   String @id @default(cuid())
  code String @unique
  name String

  status SupplierStatus @default(ACTIVE)

  email   String?
  phone   String?
  address String? @db.Text
  city    String?
  country String?

  /// VAT/GST registration — printed on bills where the law requires it.
  taxPin        String?
  vatRegistered Boolean @default(false)

  /// Terms in days, used to derive `dueDate` from the bill date.
  paymentTermsDays Int?

  bankName      String?
  bankBranch    String?
  accountName   String?
  accountNumber String?

  notes String? @db.Text

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  bills   SupplierBill[]
  credits SupplierCredit[]

  // Module 10 — Procurement. The doc's `Supplier` had only a name and a phone;
  // the fields below are the ones a buyer actually needs, added here rather than
  // as a parallel vendor table because a bill and a purchase order that point at
  // two different "supplier" records is how an AP total goes wrong.
  /// What this supplier supplies, so the RFQ picker can offer relevant vendors
  /// rather than every electrician in the city for a request for office chairs.
  category SupplierCategory?

  /// A human rating (1–5) kept alongside the derived performance figures in
  /// `Supplier.performance` — a buyer's judgement and the numbers are different
  /// things, and only one of them is a calculation.
  rating Int?

  /// Contract window, for the suppliers under an annual agreement rather than
  /// bought from ad hoc.
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractReference String?

  rfqInvitations RfqInvitation[]
  rfqQuotes      RfqQuote[]
  purchaseOrders PurchaseOrder[]
  // Module 11 — Inventory: the vendor an item is normally bought from, so the
  // reorder suggestion can name one instead of asking a buyer to remember.
  suppliedItems  InventoryItem[] @relation("InventoryItemPreferredSupplier")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([name])
  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// What a supplier supplies. Narrower and deliberately different from both
/// `PurchaseCategory` (what is being bought this time) and `BillCategory` (which
/// expense account the invoice lands in): a plumber is a SUPPLIER_CATEGORY once
/// and stays one, while the category of any particular job from them is
/// decided by the requester.
enum SupplierCategory {
  PLUMBING
  ELECTRICAL
  MECHANICAL
  BUILDING_MATERIALS
  FURNITURE
  IT_AND_TECH
  CLEANING
  SECURITY
  PEST_CONTROL
  LANDSCAPING
  PROFESSIONAL_SERVICES
  GENERAL
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

/// What kind of cost a bill is, so the right expense account is used without
/// anyone having to remember an account code. `other` falls back to 5900.
enum BillCategory {
  MAINTENANCE
  UTILITIES
  INSURANCE
  PROFESSIONAL
  MARKETING
  OFFICE
  SALARIES
  TAX
  OTHER
}

model SupplierBill {
  id         String @id @default(cuid())
  billNumber String

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// The supplier's own invoice/reference number, so a bill can be traced back
  /// to the document it came from.
  supplierReference String?

  billDate DateTime @default(now())
  dueDate  DateTime

  currency String @default("KES")

  category BillCategory @default(OTHER)

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  paidAmount    Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount Decimal @db.Decimal(14, 2)

  status BillStatus @default(OPEN)

  /// Tax provenance, mirroring invoices: the bill snapshots what the rules
  /// decided so a later rule change cannot rewrite a document already paid.
  taxJurisdiction String?
  taxSummary      Json?

  /// Snapshot of the expense lines, so a VOID or corrected bill still explains
  /// itself after the supplier's own references change.
  lineSnapshot Json?

  notes String? @db.Text

  lines              SupplierBillLine[]
  payments           BillPayment[]
  creditApplications SupplierCreditApplication[]

  // Module 10 — Procurement. A bill raised from a purchase order points back at
  // it. Named, because `SupplierBill` also has no relation of this name today and
  // the back-reference has to be unambiguous from both sides.
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderBill")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  voidedAt DateTime?

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id     String       @id @default(cuid())
  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  description String

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(14, 2)

  taxRate   Decimal? @db.Decimal(7, 4)
  taxAmount Decimal? @db.Decimal(12, 2)
  taxCode   String?

  /// Optional explicit expense account for this line. Validated against the
  /// chart when posted, so a typo cannot produce an entry that fails at the
  /// ledger.
  expenseAccountCode String?

  createdAt DateTime @default(now())

  @@index([billId])
  @@map("supplier_bill_lines")
}

/// Money paid to a supplier. Kept separate from `Payment`, which is the
/// receivable-side record: a bill payment settles `SupplierBill`, not an
/// `Invoice`, and conflating them is how an AP total ends up wrong.
model BillPayment {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("KES")

  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?       @db.Text

  /// How much of this payment is pointed at an invoice-equivalent bill; the
  /// remainder is credit owed back to us by the supplier.
  appliedAmount Decimal @default(0) @db.Decimal(14, 2)

  isReversed Boolean   @default(false)
  reversedAt DateTime?
  reversedBy String?

  createdAt DateTime @default(now())
  createdBy String?

  // Supplier credit this payment created as an overpayment.
  sourceCredits SupplierCredit[] @relation("CreditSourcePayments")

  @@index([organizationId])
  @@index([billId])
  @@index([paymentDate])
  @@map("bill_payments")
}

/// What a supplier owes us back — we overpaid, or returned goods. Spent against
/// their next bills, oldest first, exactly as `CustomerCredit` is.
model SupplierCredit {
  id            String  @id @default(cuid())
  amount        Decimal @db.Decimal(14, 2)
  appliedAmount Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("KES")

  reason String?              @db.Text
  source SupplierCreditSource @default(OVERPAYMENT)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// The overpaying payment this credit came from. Reversing that payment has
  /// to unwind the credit too, or the supplier keeps a credit balance that no
  /// longer corresponds to any money.
  sourcePaymentId String?
  sourcePayment   BillPayment? @relation("CreditSourcePayments", fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  status CreditStatus @default(OPEN)

  applications SupplierCreditApplication[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_credits")
}

enum SupplierCreditSource {
  OVERPAYMENT
  UNALLOCATED
  GOODWILL
  MANUAL
}

model SupplierCreditApplication {
  id       String         @id @default(cuid())
  creditId String
  credit   SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  appliedAt DateTime @default(now())
  appliedBy String?

  @@index([creditId])
  @@index([billId])
  @@map("supplier_credit_applications")
}

/// One execution of the recurring billing job, kept so an operator can answer
/// "did rent go out this month?" without reading logs. Failures are recorded
/// per lease rather than aborting the run: one bad lease must not stop the other
/// two hundred from being billed.
/// Module 17 — Notifications: one row per message, per channel.
///
/// One message to three channels is three rows, not one row with three
/// booleans: each channel is delivered and failed independently, and one
/// provider being down must not lose the others. `dedupeKey` is what stops a
/// daily job sending the same reminder every morning — with the unique index
/// below, "already sent today" is a database fact rather than a check the
/// scheduler has to remember to do.
model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// A staff recipient. Portal residents have no login of their own, so a
  /// notification to a resident is addressed by `tenantId` instead.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation("TenantNotifications", fields: [tenantId], references: [id], onDelete: Cascade)

  type     NotificationType
  channel  NotificationChannel  @default(IN_APP)
  priority NotificationPriority @default(NORMAL)

  title String
  body  String @db.Text

  /// Where the reader goes if this is surfaced in the app.
  actionUrl String?

  /// What the message is about, so a list can group and link without
  /// re-parsing the body.
  entityType String?
  entityId   String?

  status NotificationStatus @default(PENDING)

  /// Stable key for "this exact reminder, for this day". Null disables dedupe.
  dedupeKey String?

  sentAt       DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey, channel])
  @@index([userId, readAt])
  @@index([tenantId, readAt])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  RENT_DUE
  RENT_OVERDUE
  LEASE_EXPIRING
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_WITHDRAWN
  MAINTENANCE_UPDATE
  APPROVAL_REQUESTED
  // Module 18: the two facts an approval queue needs to tell apart — a decision
  // was made on a request, or a level blew its SLA and moved up a level.
  APPROVAL_DECIDED
  APPROVAL_ESCALATED
  OWNER_STATEMENT_READY
  PAYOUT_PAID
  // Module 11 — Inventory: an item has fallen to (or below) its reorder level.
  // Distinct from anything else because the recipient is staff deciding to
  // spend money, not a resident waiting on the office.
  STOCK_LOW
  // Module 13 - Facilities. A booking decision is the resident's own booking, so
  // it is addressed to them; a visitor arriving and a card expiring are messages
  // the *office* needs, and they land on different screens.
  FACILITY_BOOKING_DECIDED
  VISITOR_ARRIVAL
  ACCESS_CARD_EXPIRING
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  /// Never suppressed by a user's opt-out — a tenant being overcharged or a
  /// lease ending is not something they can consent to missing.
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Deliberately not sent: no provider configured, or the recipient opted out
  /// and the message is not critical. Distinct from FAILED so an operator can
  /// tell "we chose not to" from "we tried and it broke".
  SUPPRESSED
}

/// Module 17 — Notifications: which provider sends a channel, and with what
/// credentials.
///
/// One row per channel per organization, which is what enforces "only one
/// provider active at a time" — there is no second row to activate. Credentials
/// are stored **encrypted**, never in plaintext: an admin panel that writes
/// secrets to a readable column has turned every database backup into a
/// credential leak.
model NotificationChannelConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  /// Which vendor to use: TWILIO or AFRICAS_TALKING for SMS. Stored as a string
  /// rather than an enum so a third provider can be added by registering it in
  /// the service without a migration.
  provider String

  /// AES-256-GCM ciphertext of the provider's credentials, as JSON.
  credentialsEncrypted String @db.Text

  /// Non-secret settings (sender id, sender name, region). Safe to read.
  settings Json?

  isActive Boolean @default(false)

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, channel])
  @@index([organizationId])
  @@map("notification_channel_configs")
}

/// Per-recipient channel preferences. A missing row means "all channels on",
/// which is the right default: nobody has opted in to being opted out of.
model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  type  NotificationType
  inApp Boolean          @default(true)
  email Boolean          @default(true)
  sms   Boolean          @default(true)
  push  Boolean          @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([organizationId])
  @@map("notification_preferences")
}

model RecurringBillingRun {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The day the run was for, e.g. "2026-10-01".
  billingDate   DateTime
  /// The period billed, e.g. "2026-10".
  billingPeriod String

  invoicesCreated Int @default(0)
  leasesSkipped   Int @default(0)
  leasesFailed    Int @default(0)

  /// Per-lease outcome, including why a lease was skipped or what it failed on.
  details Json?

  status       RecurringRunStatus @default(COMPLETED)
  errorMessage String?            @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  triggeredBy String? // null for the scheduled run

  @@index([organizationId])
  @@index([billingPeriod])
  @@map("recurring_billing_runs")
}

enum RecurringRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  date         DateTime
  invNo        String?
  particular   String
  invoiceTotal Decimal  @db.Decimal(10, 2)
  prevReceipts Decimal  @default(0) @db.Decimal(10, 2)
  amtDue       Decimal  @db.Decimal(10, 2)
  payment      Decimal  @db.Decimal(10, 2)
  newBalance   Decimal  @db.Decimal(10, 2)
  whtTax       Decimal  @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptId])
  @@map("receipt_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 18 — Workflow Engine
//
// Multi-step approvals as configuration, not code. The reason this exists is
// that "who signs off a refund, and when" is a policy an organization decides
// and changes; hardcoding it into a finance service means every customer gets
// our policy. The engine knows nothing about refunds, leases or work orders —
// it moves a request from one named approver to the next and reports the result.
// ─────────────────────────────────────────────────────────────────────────────

/// The policy: "for this kind of request, these are the approval levels, in
/// this order, with these conditions".
///
/// `organizationId = null` marks a **system default** available to every
/// organization (seeded by the platform); a non-null value is that
/// organization's own policy and shadows the default. Resolution is
/// org-specific-first, then system default, highest `priority` wins.
///
/// `steps` is the ordered template, one entry per level:
///   { "name": "Finance review",
///     "approverKind": "ROLE",            // or "USER"
///     "approverRole": "Accountant",      // matched against system role names
///     "approverUserId": null,            // required when approverKind = USER
///     "condition": { "field": "amount", "op": "gt", "value": 50000 },
///     "escalateAfterHours": 24,
///     "escalateToUserId": null }
/// A level whose `condition` is false is skipped rather than blocking, which is
/// how "director approval only above 50,000" is expressed.
model WorkflowDefinition {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// What kind of request this governs: "REFUND", "EXPENSE", "LEASE",
  /// "PURCHASE_ORDER", "WORK_ORDER", "PAYOUT", ... Free-form on purpose — a new
  /// entity type is a definition row, not a migration.
  entityType String

  name        String
  description String? @db.Text

  steps Json

  isActive Boolean @default(true)

  /// Tie-breaker when more than one definition matches. Higher wins.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances WorkflowInstance[]

  @@index([organizationId, entityType])
  @@index([entityType])
  @@map("workflow_definitions")
}

/// One request travelling through a definition. `context` is the payload the
/// caller supplied (the amount, the reason, whatever the completion handler
/// needs) and is also what step `condition`s are evaluated against.
///
/// `workflowDefinitionId` is nullable **on purpose**: deleting a policy must not
/// delete approvals that are already in flight. The instance keeps its own copy
/// of what it is doing, and a running approval survives its definition being
/// retired.
model WorkflowInstance {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workflowDefinitionId String?
  workflowDefinition   WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String

  /// Denormalized one-liner for the approvals inbox, so the queue does not have
  /// to join back into whatever table the entity lives in.
  entityLabel String?

  /// Frozen copy of the definition's steps as they were when this started.
  /// Editing a policy must not rewrite the approvals already raised under it.
  steps Json

  /// What the caller asked for — the amount, the reason, whatever the completion
  /// handler needs — and what every step `condition` is evaluated against.
  /// Frozen with the instance, so a later change to the record cannot quietly
  /// move an approval across a threshold.
  context Json

  status      WorkflowInstanceStatus @default(IN_PROGRESS)
  currentStep Int                    @default(0)

  finalComment String? @db.Text

  startedById String?
  startedBy   User?   @relation("UserStartedWorkflows", fields: [startedById], references: [id], onDelete: SetNull)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepInstances WorkflowStep[]
  events        WorkflowEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([startedById])
  @@map("workflow_instances")
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  /// The current level blew its SLA and the decision was handed to somebody
  /// higher up. Still actionable — an escalated approval is a late approval, not
  /// a dead one.
  ESCALATED
  APPROVED
  REJECTED
  CANCELLED
}

/// One materialized approval level of an instance. This is a row rather than
/// JSON because the inbox has to answer "what is waiting on me", and delegation
/// and escalation have to survive a process restart.
model WorkflowStep {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepIndex Int
  name      String

  approverKind   WorkflowApproverKind @default(ROLE)
  /// Set when approverKind = USER.
  approverUserId String?
  /// Set when approverKind = ROLE. Matched against `Role.name` and the legacy
  /// `UserRole` enum value, case-insensitively, because role names are still
  /// not mapped onto the enum (master doc issue 51).
  approverRole   String?

  status WorkflowStepStatus @default(PENDING)

  /// When the level's SLA expires and the sweep escalates it.
  dueAt            DateTime?
  escalatedAt      DateTime?
  /// Who the level escalates to once overdue. Null = flag only.
  escalateToUserId String?

  /// The decision, and who made it. `actedById` differs from the assignee when
  /// somebody acted under a delegation, which is worth being able to see.
  actedById            String?
  actedAt              DateTime?
  actedViaDelegationId String?
  comment              String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actedBy            User?               @relation("UserActedWorkflowSteps", fields: [actedById], references: [id], onDelete: SetNull)
  approverUser       User?               @relation("UserAssignedWorkflowSteps", fields: [approverUserId], references: [id], onDelete: SetNull)
  actedViaDelegation WorkflowDelegation? @relation(fields: [actedViaDelegationId], references: [id], onDelete: SetNull)

  @@unique([instanceId, stepIndex])
  @@index([approverUserId, status])
  @@index([status, dueAt])
  @@map("workflow_steps")
}

enum WorkflowApproverKind {
  ROLE
  USER
}

enum WorkflowStepStatus {
  PENDING
  /// Waiting on somebody now.
  ACTIVE
  APPROVED
  REJECTED
  /// Past its SLA. Still decidable — see WorkflowInstanceStatus.ESCALATED.
  ESCALATED
  /// Its condition was false, so this level was never required.
  SKIPPED
}

/// The immutable trail: who asked, who decided, who escalated, who delegated,
/// with the comment each of those carried. `WorkflowStep` records only the
/// decision itself, which is not the same as a readable history.
model WorkflowEvent {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  type WorkflowEventType

  actorUserId String?

  /// Set when a delegate acted on the assignee's behalf.
  onBehalfOfUserId String?

  /// The delegation that authorised the delegate, when there was one.
  delegationId String?

  stepIndex Int?
  comment   String? @db.Text

  createdAt DateTime @default(now())

  actorUser      User?               @relation("UserWorkflowEventActors", fields: [actorUserId], references: [id], onDelete: SetNull)
  onBehalfOfUser User?               @relation("UserWorkflowEventDelegates", fields: [onBehalfOfUserId], references: [id], onDelete: SetNull)
  delegation     WorkflowDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@index([createdAt])
  @@map("workflow_events")
}

enum WorkflowEventType {
  STARTED
  APPROVED
  REJECTED
  ESCALATED
  DELEGATED
  CANCELLED
  SKIPPED
  /// No definition was configured, so the request went straight through. Kept
  /// explicitly rather than silently: "it was approved because nobody set up a
  /// policy" is a fact an auditor needs to be able to see.
  AUTO_APPROVED
}

/// "While I am on leave, Sarah approves what is waiting on me." Checked at the
/// moment of the decision, not when the task arrived, so a delegation created
/// after the fact still applies and one that has expired does not.
model WorkflowDelegation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("UserWorkflowDelegatedFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("UserWorkflowDelegatedTo", fields: [toUserId], references: [id], onDelete: Cascade)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  reason   String?   @db.Text

  createdAt DateTime @default(now())

  actedSteps WorkflowStep[]
  events     WorkflowEvent[]

  @@index([organizationId])
  @@index([fromUserId, toUserId])
  @@map("workflow_delegations")
}

// ============================================
// MAINTENANCE (Module 9)
// ============================================

/// The trade the job falls under. Drives nothing by itself — the point of
/// recording it is that "8 electrical faults this month" is the report an owner
/// asks for, and it is only answerable if every work order carries a category.
enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CLEANING
  PAINTING
  SECURITY
  OTHER
}

/// The documented pipeline: REQUESTED → INSPECTION → APPROVED → ASSIGNED →
/// IN_PROGRESS → COMPLETED → CLOSED. `CANCELLED` is the addition, and it is
/// deliberate: a reported fault that turns out to be a tenancy dispute or a
/// duplicate would otherwise have to be "completed" with a resolution note that
/// says nothing happened, which is a lie in the one field a tenant reads.
enum WorkOrderStatus {
  REQUESTED
  INSPECTION
  APPROVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

/// Emergency means "today", and the service derives the response deadline from
/// it rather than storing a second date somebody has to keep in step.
enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

/// Who raised it. Kept on the record rather than inferred from the tenant,
/// because a tenant-portal report and a caretaker's walk-in look identical
/// afterwards but are different facts for a dispute.
enum WorkOrderSource {
  STAFF
  TENANT_PORTAL
  TENANT_REQUEST
  PREVENTIVE
}

model WorkOrder {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human reference (`WO-2026-0007`), unique per organization — the codebase
  /// already numbers INVOICEs, RECEIPTs and credit notes this way, and a
  /// work order quoted over the phone needs one that is not a cuid.
  reference String

  title       String
  description String              @db.Text
  category    MaintenanceCategory
  priority    WorkOrderPriority   @default(NORMAL)
  status      WorkOrderStatus     @default(REQUESTED)
  source      WorkOrderSource     @default(STAFF)

  // Where the fault is. `propertyId` is the anchor: it is what the list filters
  /// on and what keeps a work order attributable when it is about a whole
  /// building (a lift, a generator) rather than one home. Nullable so a work
  /// order can be raised against an asset before anyone knows where it is.
  propertyId String?
  property   Property? @relation("PropertyWorkOrders", fields: [propertyId], references: [id], onDelete: SetNull)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  assignedTechnicianId String?
  assignedTechnician   User?   @relation("UserAssignedWorkOrders", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  /// How to get in — gate codes, "the neighbour has the only spare key".
  /// Written by whoever knows, because a technician standing outside a locked
  /// door is the most common cause of a wasted visit.
  accessInstructions String? @db.Text

  // Money. Decimal(12,2) like the other money columns in this schema, and
  // optional: the cost of an unapproved repair is genuinely unknown, and a
  // fabricated estimate is worse than a blank one.
  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  reportedAt   DateTime  @default(now())
  scheduledFor DateTime?
  inspectedAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?

  inspectionNote     String? @db.Text
  resolutionNote     String? @db.Text
  cancellationReason String? @db.Text

  /// Set when an approval was asked for (Module 18's engine, entity WORK_ORDER).
  /// The instance itself is found by (entityType, entityId); this is only the
  /// record that sign-off was requested at all, and when.
  approvalRequestedAt DateTime?

  // Preventive maintenance provenance. `pmDueOn` is the day the schedule fell
  // due, truncated to midnight, and (pmScheduleId, pmDueOn) is unique — the
  /// sweep can run twice, be run by hand, and be run by two instances, and the
  /// database is what stops the same service being raised twice for one period.
  // Both columns are nullable, and NULLs are distinct in a Postgres unique
  // index, so ordinary work orders never collide with each other.
  pmScheduleId String?
  pmSchedule   PreventiveMaintenanceSchedule? @relation(fields: [pmScheduleId], references: [id], onDelete: SetNull)
  pmDueOn      DateTime?

  raisedById String?
  raisedBy   User?   @relation("UserRaisedWorkOrders", fields: [raisedById], references: [id], onDelete: SetNull)

  tasks WorkOrderTask[]

  // Module 11 — Inventory: what this job consumed from the store. The rows are
  // ordinary `StockMovement`s with a `workOrderId`, deliberately NOT a separate
  // "materials used" table — a second record of the same consumption is a second
  // number that can disagree with the stock balance.
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@unique([pmScheduleId, pmDueOn])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([assignedTechnicianId])
  @@map("work_orders")
}

/// A line of the job. The checklist a technician works through, and the record
/// of what was actually done — including on a preventive visit, where the
/// schedule's `checklist` is copied onto the work order so the historic visit
/// keeps the list it was performed against.
model WorkOrderTask {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description   String
  sortOrder     Int       @default(0)
  isDone        Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("UserCompletedWorkOrderTasks", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([workOrderId])
  @@map("work_order_tasks")
}

enum AssetType {
  ELEVATOR
  GENERATOR
  HVAC
  WATER_PUMP
  CCTV
  OTHER
}

/// Service state of the equipment itself, separate from its maintenance
/// schedule: an asset can be OUT_OF_SERVICE because it broke, or SERVICE_DUE
/// because the calendar says so, and the two call for different responses.
/// RETIRED is terminal and means "history only" — no new work orders, no new
/// preventive schedules, and no moving it back to service. It is a status
/// rather than a `retiredAt` date because a state machine has one source of
/// truth: two ways to say "we no longer own this" is how one of them rots.
enum AssetStatus {
  OPERATIONAL
  SERVICE_DUE
  OUT_OF_SERVICE
  RETIRED
}

/// The register of plant and equipment a property owns.
///
/// Deliberately not a spreadsheet: `retiredAt` is a date rather than a status
/// that can be toggled back and forth, because "we no longer own this lift" is
/// not a reversible fact, and a retired asset must not keep generating
/// preventive work orders.
model Asset {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Unit-level plant (a split AC, a washing machine) hangs off a unit too.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  type AssetType
  name String

  /// The tag painted on the machine. Unique per organization when present, so
  /// a technician can be told "GEN-01" instead of "the generator", but a
  /// property with untagged kit still accepts rows.
  assetTag     String?
  serialNumber String?
  manufacturer String?
  model        String?
  location     String?
  capacity     String?

  installedAt       DateTime?
  warrantyExpiresAt DateTime?

  status AssetStatus @default(OPERATIONAL)
  notes  String?     @db.Text

  workOrders  WorkOrder[]
  pmSchedules PreventiveMaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([propertyId])
  @@index([type])
  @@index([status])
  @@map("assets")
}

/// A recurring service interval for one asset — the generator that needs
/// running monthly whatever anybody asks for.
model PreventiveMaintenanceSchedule {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  /// Days between services. A frequency is the interval, not a list of future
  /// dates: `nextDueAt` is recomputed from the service that just happened, so
  /// a missed month does not shift every later month with it.
  frequencyDays Int

  /// Raise the work order this many days before it falls due, so there is time
  /// to book a contractor. 0 means "raise it on the day".
  leadTimeDays Int @default(0)

  /// The steps to perform, as an array of strings. Copied onto each generated
  /// work order rather than read at display time, so a historic visit keeps
  /// the list it was actually done against.
  checklist Json?

  assignedTechnicianId String?
  assignedTechnician   User?   @relation("UserPmSchedules", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  nextDueAt DateTime

  /// The last service the sweep actually raised, and when. Reporting on
  /// overdue plant needs "when was this last done", and deriving it from work
  /// orders means also deriving the ones that were cancelled and never done.
  lastRunAt DateTime?

  notes String? @db.Text

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assetId])
  @@index([active, nextDueAt])
  @@map("preventive_maintenance_schedules")
}

enum PmRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One sweep of the schedules, so "did the generator actually get serviced in
/// March?" is answerable from a record rather than from inference. Mirrors
/// `RecurringBillingRun` for the same reason: a job that might run twice needs
/// to be able to show that it ran, and what it decided not to do.
model PreventiveMaintenanceRun {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  runOn  DateTime
  status PmRunStatus @default(RUNNING)

  schedulesConsidered Int @default(0)
  workOrdersCreated   Int @default(0)
  schedulesSkipped    Int @default(0)
  schedulesFailed     Int @default(0)

  /// Per-schedule outcome, so a partial failure is diagnosable: which schedule,
  /// and why nothing was raised for it.
  details Json?

  triggeredBy  String?
  errorMessage String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([organizationId])
  @@index([runOn])
  @@map("preventive_maintenance_runs")
}

// ============================================
// Module 10 — Procurement
// ============================================

/// What a purchase request is for. Deliberately its own enum rather than a reuse
/// of `BillCategory`: the bill category answers "which expense account does this
/// land in", which is decided at *invoice* time by finance, while this answers
/// "what is being bought", which is what the requester picks months earlier. The
/// service maps between them when the purchase order becomes a bill, so a
/// request typed as EQUIPMENT still posts to whichever account the supplier's
/// bill belongs in.
enum PurchaseCategory {
  MAINTENANCE_PARTS
  EQUIPMENT
  FURNITURE
  IT_AND_TECH
  STATIONERY
  CLEANING
  SECURITY
  UTILITIES
  PROFESSIONAL_SERVICES
  OTHER
}

/// How urgently it is needed. Derived urgency (an `urgent` flag somebody sets)
/// is how a request for a spare part ends up sitting for a week.
enum PurchasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// The request lifecycle. DRAFT exists because nobody wants half-written
/// requests in the approval inbox, and CANCELLED is distinct from REJECTED
/// because "we do not want this" and "we did not approve this" are different
/// answers to give the requester.
enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A department's request for something to be bought. The lines are the reason
/// it exists: a request with no lines has nothing to compare quotations against,
/// so `PurchaseRequestLine` is required rather than a description blob.
model PurchaseRequest {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human reference (`PR-2026-0007`), unique per organization — the codebase
  /// already numbers invoices, receipts and work orders this way, and a request
  /// read out over the phone needs one that is not a cuid.
  reference String

  title       String
  description String?          @db.Text
  category    PurchaseCategory
  priority    PurchasePriority @default(NORMAL)

  status PurchaseRequestStatus @default(DRAFT)

  /// Free-text department ("Maintenance", "Front Office"). The doc's
  /// `departmentId` implies a department table that does not exist; a lookup
  /// table here would be a second organization-wide concept to keep in step for
  /// no reporting gain. Kept as text until a real departments table exists.
  department String?

  neededBy DateTime?

  /// What the requester expects to spend. Nullable on purpose: a request is
  /// often raised before anyone knows, and a fabricated estimate is worse than a
  /// blank — the same rule the work-order cost fields follow.
  estimatedAmount Decimal? @db.Decimal(14, 2)

  currency String @default("KES")

  requestedById String?
  requestedBy   User?   @relation("UserRequestedPurchases", fields: [requestedById], references: [id], onDelete: SetNull)

  /// Set when approval was requested through Module 18's engine (entity
  /// PURCHASE_REQUEST). The instance itself is found by (entityType, entityId).
  approvalRequestedAt DateTime?

  decisionNote    String? @db.Text
  rejectionReason String? @db.Text

  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("UserDecidedPurchaseRequests", fields: [decidedById], references: [id], onDelete: SetNull)

  lines  PurchaseRequestLine[]
  rfqs   Rfq[]
  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([requestedById])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  description   String
  specification String? @db.Text

  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal? @db.Decimal(14, 2)
  estimatedAmount Decimal? @db.Decimal(14, 2)

  sortOrder Int @default(0)

  /// Which quotations answered this line, so a comparison view can show "every
  /// supplier priced this" rather than only the ones who happened to name a
  /// matching description.
  quotes RfqQuoteLine[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([purchaseRequestId])
  @@map("purchase_request_lines")
}

/// The request-quotation round: "here is what we need, tell us what it costs".
/// It is separate from the request because one request commonly goes to several
/// suppliers, and the whole point is the comparison between their answers.
///
/// `CLOSED` and `CANCELLED` are both terminal and distinct, for the same reason
/// they are on `PurchaseOrderStatus`: a round that ran its course is history,
/// while a round that was called off needs a recorded reason.
enum RfqStatus {
  DRAFT
  ISSUED
  QUOTES_RECEIVED
  CLOSED
  AWARDED
  CANCELLED
}

model Rfq {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference String

  title String
  notes String? @db.Text

  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  status RfqStatus @default(DRAFT)

  currency String @default("KES")

  /// When quotations are wanted back. Compared on read, never stored as a
  /// separate overdue flag.
  quotesDueAt DateTime?

  issuedAt           DateTime?
  closedAt           DateTime?
  awardedAt          DateTime?
  cancellationReason String?   @db.Text

  /// The suppliers that were asked, as their own rows rather than an id array:
  /// the invitation is a record with a date and an outcome, and a
  /// `String[]` has nowhere to put "invited on Tuesday, never replied".
  invitations RfqInvitation[]
  quotes      RfqQuote[]

  awardedQuoteId String?   @unique
  awardedQuote   RfqQuote? @relation("AwardedRfqQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)

  raisedById String?
  raisedBy   User?   @relation("UserRaisedRfqs", fields: [raisedById], references: [id], onDelete: SetNull)

  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@index([purchaseRequestId])
  @@map("rfqs")
}

enum RfqInvitationStatus {
  INVITED
  QUOTED
  DECLINED
}

model RfqInvitation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status RfqInvitationStatus @default(INVITED)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  /// Why they said no. Required to decline — a supplier who stops answering is
  /// invisible otherwise, and one silently dropped supplier is how a
  /// single-source purchase happens without anybody deciding it.
  declineReason String? @db.Text

  @@unique([rfqId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("rfq_invitations")
}

enum QuoteStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED
  AWARDED
  WITHDRAWN
}

model RfqQuote {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status QuoteStatus @default(SUBMITTED)

  /// The supplier's own total, as stated. `totalAmount` is derived from the
  /// quote's own lines, so a comparison table can never show a total that
  /// disagrees with the lines under it.
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  currency String @default("KES")

  /// How long they can hold the price, and when they can deliver. Both are the
  /// comparison's whole justification for preferring one quote over another —
  /// the cheapest price for something needed next week is not the cheapest.
  leadTimeDays Int?
  validUntil   DateTime?

  notes String? @db.Text

  awardedFor Rfq? @relation("AwardedRfqQuote")

  lines  RfqQuoteLine[]
  orders PurchaseOrder[]

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rfqId, supplierId])
  @@index([organizationId])
  @@index([rfqId])
  @@index([supplierId])
  @@map("rfq_quotes")
}

model RfqQuoteLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quoteId String
  quote   RfqQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Which requested line this answers. Optional, because a supplier may quote
  /// for the whole job in one line, or split it differently — forcing a match
  /// would make honest quotations impossible to enter.
  purchaseRequestLineId String?
  purchaseRequestLine   PurchaseRequestLine? @relation(fields: [purchaseRequestLineId], references: [id], onDelete: SetNull)

  description String

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0)

  @@index([organizationId])
  @@index([quoteId])
  @@index([purchaseRequestLineId])
  @@map("rfq_quote_lines")
}

/// A purchase order lifecycle. ACCEPTED is the supplier's confirmation, and
/// RECEIVED is goods physically arriving — the two are separate because the
/// failure everybody hits is a PO marked delivered because the supplier sent an
/// invoice. `CLOSED` and `CANCELLED` are both terminal but distinct: a closed
/// order was fulfilled and paid, a cancelled one never happened and its reason
/// is the audit trail.
enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference String

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status PurchaseOrderStatus @default(DRAFT)

  /// What this order is for, copied from the request/RFQ rather than looked up
  /// through them: an order outlives the documents that produced it, and the
  /// bill created from it needs a category regardless of whether the PR is
  /// still around.
  category PurchaseCategory
  currency String           @default("KES")

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  orderDate        DateTime  @default(now())
  /// Promised delivery, used to derive "overdue" on read rather than storing a
  /// flag that would rot while the supplier is quiet.
  expectedDelivery DateTime?

  deliveryAddress String? @db.Text
  terms           String? @db.Text
  notes           String? @db.Text

  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   RfqQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  /// The bill finance raised against this order. The doc's task list asks for PO
  /// completion to create a `SupplierBill`; master doc issue 70 warned against
  /// adding a speculative `billId` before deciding the direction, and this is
  /// that decision — the *bill* records the order (so a paid bill can always
  /// say which order it settles), and the order points back at its latest bill
  /// for convenience. A supplier may invoice in instalments, so this is not
  /// unique.
  supplierBillId String?
  supplierBill   SupplierBill? @relation("PurchaseOrderBill", fields: [supplierBillId], references: [id], onDelete: SetNull)

  sentAt             DateTime?
  acceptedAt         DateTime?
  receivedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  raisedById String?
  raisedBy   User?   @relation("UserRaisedPurchaseOrders", fields: [raisedById], references: [id], onDelete: SetNull)

  lines      PurchaseOrderLine[]
  deliveries GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([rfqId])
  @@index([purchaseRequestId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  description   String
  specification String? @db.Text

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  /// Derived from the goods receipts, never decremented — a reversal or a
  /// short delivery must not be able to make a line look unreceived.
  receivedQuantity Decimal @default(0) @db.Decimal(10, 2)

  sortOrder Int @default(0)

  receiptLines GoodsReceiptLine[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

/// One delivery of goods against an order. Kept as rows rather than a boolean on
/// the line because goods arrive in instalments and a partial delivery that
/// overwrote the line would lose the history of what came when.
model GoodsReceipt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receivedAt DateTime @default(now())

  /// The supplier's delivery note or waybill number.
  deliveryNote String?

  conditionNote String? @db.Text

  receivedById String?
  receivedBy   User?   @relation("UserReceivedPurchaseOrders", fields: [receivedById], references: [id], onDelete: SetNull)

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  quantity Decimal @db.Decimal(10, 2)

  /// Module 11 — Inventory. Filled in by `InventoryService.bookGoodsReceipt`
  /// when the received goods are booked into a warehouse, and it is the reason
  /// `pendingStockIn` can name exactly what is still waiting. Null means "the
  /// goods arrived but nobody has decided what store they went into" — which is
  /// a genuine state, not a failure: a laptop bought for the office has no
  /// shelf. See master doc issue 70 for why this was left null rather than
  /// given a speculative link before the table existed.
  inventoryItemId   String?
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  stockInRecordedAt DateTime?

  /// The stock movement this receipt line became, when it was booked in.
  /// `StockMovement.goodsReceiptLineId` is the unique side; one receipt line
  /// becomes at most one movement.
  stockMovement StockMovement?

  @@index([organizationId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([inventoryItemId])
  @@map("goods_receipt_lines")
}

// ═══════════════════════════════════════════════════════════════════════════
// Module 11 — Inventory
// ═══════════════════════════════════════════════════════════════════════════
//
// The one rule this domain is built around: **a stock level is the sum of the
// movements, never a stored counter.** Every other module in this schema that
// has a "quantity" already learned that lesson — `Invoice.paidAmount`,
// `PurchaseOrderLine.receivedQuantity`, `OwnerStatement` — because a derived
// number can always be recomputed from the rows that justify it, while a
// counter has to be kept in step by every writer and drifts the first time one
// of them forgets. So `InventoryItem` has no `quantityOnHand` column, and
// `GET /inventory/items` groups the movements and adds them up.

/// What a thing is bought and tracked as. Free text would be useless here: the
/// whole point of the category is the question "what do we spend on plumbing a
/// year", and that question needs a bucket rather than a string anybody typed.
enum InventoryCategory {
  PAINT
  PLUMBING
  ELECTRICAL
  TILES_FLOORING
  BUILDING_MATERIALS
  HARDWARE
  CLEANING
  SAFETY
  GARDENING
  FURNITURE
  APPLIANCES
  OTHER
}

/// Why stock moved. Not free text, because the *reason* decides three things:
/// whether the movement needs a reference (a receipt, a work order), whether it
/// may make stock negative, and what a stock-take variance is allowed to be.
enum StockMovementType {
  /// Goods booked in against a purchase order's goods receipt. Always has a
  /// `goodsReceiptLineId`, and always `IN`.
  GOODS_RECEIPT

  /// Consumed by a maintenance work order. Always has a `workOrderId`, and
  /// always `OUT`.
  WORK_ORDER_ISSUE

  /// A correction after counting the shelf. The only type that may move stock in
  /// either direction and the only one that may leave it negative, because a
  /// count that disagrees with the books is precisely the case where the books
  /// are wrong and the count is right.
  ADJUSTMENT

  /// Opening balance for an item that was already on the shelf before this
  /// module existed. Always `IN`.
  OPENING

  /// Moved between two warehouses: **two rows**, an `OUT` from the source and an
  /// `IN` at the destination, paired by a shared `transferGroup`. One row with
  /// two warehouses would make the movement belong to both and neither, and a
  /// warehouse's balance would stop being derivable.
  TRANSFER

  /// Went back to a supplier, or came back off a job. May be either direction.
  RETURN
}

/// A stock item: the thing that is counted.
///
/// Note what is absent. There is no quantity, no `currentStock`, no
/// `lastStockedAt` — all of that is the sum of `StockMovement`s, computed on
/// read. `unitCost` is the *last known* price, kept for the reorder suggestion's
/// estimate and as the fallback valuation when a movement has no cost of its own;
/// the authoritative valuation walks the movement history.
model InventoryItem {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Unique per organization, not globally: two companies both stocking "PTR-20"
  /// is normal, and a globally unique SKU makes the second company unable to
  /// create the item that already exists in their world.
  sku String

  name        String
  description String?           @db.Text
  category    InventoryCategory @default(OTHER)

  /// The unit the quantity is counted in — "litre", "roll", "box", "metre". The
  /// label rather than a conversion table on purpose: a property manager buying
  /// paint does not think in millilitres, and a conversion-factor engine is a
  /// second source of truth nobody will maintain.
  unitOfMeasure String @default("unit")

  /// Last known buying price per unit, in the organization's default currency.
  /// Used to estimate a reorder's cost and to value stock whose movements carry
  /// no cost; it is a *hint*, and `StockMovement.unitCost` is the real price.
  unitCost Decimal? @db.Decimal(14, 4)

  /// Below this the item needs ordering. Zero means "never reorder
  /// automatically" — a deliberate way to say this is tracked but not
  /// auto-alerted, which is right for a one-off bracket nobody reorders.
  reorderLevel Decimal @default(0) @db.Decimal(12, 2)

  /// How much to put on the order when it drops below `reorderLevel`. Null
  /// means "top up to twice the level", which is the only sensible default and
  /// the one a buyer would otherwise retype into every item.
  reorderQuantity Decimal? @db.Decimal(12, 2)

  /// The vendor this is normally bought from. Picked from the suppliers Module
  /// 10 already has, so the reorder suggestion can name one.
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("InventoryItemPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  notes String? @db.Text

  /// Retired rather than deleted: a movement that referenced a deleted item
  /// would leave the ledger un-summable, and "we stopped stocking this" is a
  /// fact worth keeping.
  isActive Boolean @default(true)

  movements         StockMovement[]
  goodsReceiptLines GoodsReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([category])
  @@map("inventory_items")
}

/// Somewhere stock is kept. A main store, a site store for one estate, a van.
model Warehouse {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Short code so a delivery note can say "MAIN" instead of the full name.
  code String
  name String

  address String? @db.Text
  phone   String?

  /// The store stock lands in when a receipt or an issue does not say where.
  /// At most one is honoured per organization (`warehouses.service` demotes the
  /// others) because "which one is the default?" is otherwise a question every
  /// screen has to answer.
  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  notes String? @db.Text

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

/// One movement of stock, in or out, at one warehouse.
///
/// The ledger itself. `quantity` is signed — positive in, negative out — so a
/// balance is `sum(quantity)` and nothing else; that is the whole derivation,
/// and it is why there is no balance column anywhere in this domain.
///
/// Costs are **snapshotted per movement** rather than looked up on the item.
/// Valuation is then a function of history: a bucket of paint bought at 1,200
/// and a bucket bought at 1,450 must value differently, and reading today's
/// `InventoryItem.unitCost` for a movement made last year values both at the
/// current price and quietly inflates or deflates stock on the books.
model StockMovement {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// Signed: positive brought stock in, negative took it out.
  quantity Decimal @db.Decimal(12, 2)

  type StockMovementType

  /// What this movement cost per unit at the time. Null on an `OUT`, where the
  /// cost is the one that came *in* — an issue does not create a new price.
  unitCost Decimal? @db.Decimal(14, 4)

  /// Set for `GOODS_RECEIPT`. The idempotency key is the unique index on it:
  /// booking the same receipt line in twice raises the same constraint error
  /// that `dedupeKey` raises for a reminder, which is the reason the column
  /// exists rather than a boolean the caller could set twice.
  goodsReceiptLineId String?           @unique
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)

  /// Set for `WORK_ORDER_ISSUE`.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  /// Pairs the two halves of a transfer. Both rows share one value, so "show me
  /// the moves from the site store to the main store" is a single equality
  /// filter rather than a join on sign.
  transferGroup String?

  /// Why it moved, in words. Required for `ADJUSTMENT` (the count disagreed and
  /// a person has to say by how much and why) and optional elsewhere.
  reason String? @db.Text

  notes String? @db.Text

  createdById String?
  createdBy   User?   @relation("UserRecordedStockMovements", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([itemId, warehouseId])
  @@index([workOrderId])
  @@index([type])
  @@map("stock_movements")
}

// ═══════════════════════════════════════════════════════════════════════════
// Module 12 — HR & Payroll
// ═══════════════════════════════════════════════════════════════════════════
//
// This domain is **country-agnostic by construction**, and that is a requirement
// rather than a nicety: the same code has to pay a Nairobi cleaner and a Berlin
// engineer, in their own currencies, under two different statutory regimes.
//
// So nothing below names a country, a currency, or a rate. Every number that
// differs between jurisdictions is a **row**, reached through the same resolution
// path Module 7 uses for `TaxRule`:
//
//   Organization.payrollCountryCode / payrollRegionCode  → the jurisdiction
//   PayrollRule.countryCode / regionCode / organizationId → candidate rules
//   PayrollRuleService.specificity()                     → the closest match wins
//
// Two consequences, and both are the point:
//
// 1. **A statutory rate change is data.** A new `PayrollRule` row with a later
//    `validFrom`, not an edit. A payslip dated inside the old window keeps the old
//    rate forever, which is what makes a payroll defensible in an audit two years
//    later.
// 2. **A jurisdiction nobody has configured is a visible gap, not a silent
//    zero.** No rules resolves to no deduction and a warning on the run, never a
//    quietly wrong payslip.
//
// Kenya, Brazil, Germany and the UK are shipped as *seeded sample configuration*
// marked as a dated snapshot — so the feature demonstrably works out of the box
// while remaining obvious that a real deployment must check the figures against
// current law. Nothing in the code knows those figures exist.

/// What shape the rule's arithmetic takes.
///
/// Three is enough for every statutory scheme in common use, and the alternative
/// — a general expression language on the row — is a formula-injection surface
/// with a payroll attached, so it is not offered.
enum PayrollRuleType {
  /// Progressive ladder: `bands` = `[{ upTo, ratePercent }]`, each slice taxed
  /// at its own rate. Income tax in most countries.
  PROGRESSIVE_BANDS

  /// Flat percentage of a chosen base, with an optional floor and cap. Social
  /// security, health funds, housing levies, union dues.
  PERCENTAGE

  /// A fixed amount per period, optionally banded by the same base. A fixed
  /// deduction, a fixed allowance.
  FIXED
}

/// What the rule's percentage is applied to.
///
/// The distinction is not cosmetic. "Taxable pay" is a statutory concept that is
/// frequently **not** gross pay — in several jurisdictions a housing benefit or a
/// vehicle allowance is taxed but not pensionable, or the reverse — so a rule that
/// only knew about GROSS could not be correct in those places.
enum PayrollCalculationBase {
  /// Everything the employee is paid before any deduction.
  GROSS

  /// The employee's contracted base salary only, excluding allowances.
  BASIC

  /// GROSS minus a jurisdiction's list of non-taxable components. Resolved from
  /// the payslip's own earning lines, so which lines qualify is data on the
  /// component, not a hardcoded list here.
  TAXABLE
}

/// Which side of the payroll the money comes off.
///
/// Not a percentage split, because that is the wrong shape: PAYE is withheld from
/// the employee and never touches the employer, while a social fund is typically
/// matched on both sides and a housing levy is often employer-only. `BOTH` means
/// the rule's rate applies twice, once to each side.
enum PayrollBearer {
  /// Withheld from the employee. Reduces what they are paid.
  EMPLOYEE

  /// The employer's own cost. Never reduces what the employee is paid, and does
  /// belong in the employer's salary expense.
  EMPLOYER

  /// Matched: the same rate on each side. Two figures, one rule, which is how
  /// the legislation actually expresses it.
  BOTH
}

/// Whether the rule sees one period or an annualised base.
///
/// This is the difference between a *correct* progressive income tax and a wrong
/// one. Almost every country computes income tax on annual income and then divides
/// by the number of periods, because bands are set annually. Walking the bands
/// once per month on monthly pay over-charges a low earner and under-charges a
/// high one — the month-by-month order of the slices is not the year-by-year
/// order — so a naive implementation is not a differently-rounded answer, it is
/// the wrong answer. `PERIOD` exists for the genuine monthly schemes (social
/// contributions, usually), and for them it is the correct mode.
enum PayrollPeriodMode {
  /// Apply the rule to the period's own figures, as they stand.
  PERIOD

  /// Annualise the base by `periodsPerYear`, apply the rule, divide the result.
  ANNUALISED
}

/// What kind of deduction this is.
///
/// The split matters for reporting and for the ledger: statutory deductions are
/// money the company holds on someone else's behalf and owes to an authority,
/// while a company deduction is a benefit the employer chose to provide. Blending
/// them is how a "statutory liability" total ends up containing parking charges.
enum PayrollDeductionKind {
  STATUTORY
  COMPANY
  OTHER
}

/// One configured statutory or company rule.
///
/// A deliberate near-twin of `TaxRule`: same jurisdiction columns, same effective
/// window, same identity constraint. Payroll rules change on the same kind of
/// cycle and for the same reason, and a second shape for the same idea would be a
/// second thing to learn.
model PayrollRule {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String? @db.Text

  /// Free-text and never translated by the application. A Brazilian
  /// administrator names the INSS rule "INSS Trabalhista" and a French one
  /// "Cotisations salariales" — the system stores what was typed. Anything that
  /// tried to machine-translate a statutory name would produce a document that
  /// misnames the law it is complying with.
  countryCode String? @db.Char(2)
  regionCode  String?

  type   PayrollRuleType        @default(PERCENTAGE)
  base   PayrollCalculationBase @default(GROSS)
  bearer PayrollBearer          @default(EMPLOYEE)

  /// Stored as a percentage, not a fraction: 1.5 means 1.5%. Four decimals so a
  /// 0.2475% contribution is exact rather than 0.25%.
  ratePercent Decimal? @db.Decimal(7, 4)

  /// The flat amount a `FIXED` rule charges per period. Null on every other type.
  amount Decimal? @db.Decimal(14, 2)

  /// Statutory floor and cap on the **base**, not on the result. A social fund
  /// with a minimum contribution is really a minimum *contributory wage*: below it
  /// everyone pays the same minimum, which is why expressing this as a base floor
  /// reproduces the legislation rather than approximating it.
  minimumBaseAmount Decimal? @db.Decimal(14, 2)
  maximumBaseAmount Decimal? @db.Decimal(14, 2)

  /// The ladder, for `PROGRESSIVE_BANDS` and banded `FIXED`:
  /// `[{ "upTo": 6000, "ratePercent": 0 }, { "upTo": 16000, "ratePercent": 10 }]`.
  ///
  /// A list, so no column shape would improve on it. `upTo` is cumulative and the
  /// last entry has `upTo: null`, meaning "and everything above the one before".
  bands Json?

periodMode     PayrollPeriodMode @default(PERIOD)
  periodsPerYear Int                @default(12)

  /// Order the lines appear on a payslip, which is the order a person reads them
  /// in. Income tax belongs above the social contributions on almost every
  /// payslip layout in the world, and "above" is a number on the rule rather than
  /// a hardcoded list the engine would have to be taught to override.
  sortOrder Int @default(100)

  /// Exempt below this amount of base — some schemes have a threshold below which
  /// nobody contributes at all, which is different from a minimum contribution.
  exemptBelowBaseAmount Decimal? @db.Decimal(14, 2)

  /// Where the withheld money lands in the ledger. Without it every rule would
  /// post to one account and the liabilities would silently merge, which is the
  /// same failure `TaxRule.ledgerAccountCode` already guards against.
  ledgerAccountCode String?

  /// What the employer bears also lands in the employer's salary expense. This
  /// names that expense account so a rule cannot invent one.
  expenseAccountCode String? @default("5090")

  validFrom DateTime  @default(now())
  validTo   DateTime?

  isActive Boolean @default(true)

  /// Null = a jurisdiction-wide template anybody operating there inherits.
  /// Set = this organization's own override, which always wins over a template.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  payslipLines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code, countryCode, regionCode, validFrom])
  @@index([organizationId])
  @@index([countryCode])
  @@index([code])
  @@map("payroll_rules")
}

/// An allowance or deduction component an employee can carry.
///
/// A payslip line is not a hardcoded list of a few things. A country has its own
/// mandatory components, an industry has its own, and an individual employment
/// contract has its own — so what counts as a non-taxable transport benefit or an
/// obligatory pension contribution has to be data, and `isTaxable` /
/// `isPensionable` are per jurisdiction and per component rather than global
/// truth.
model PayComponent {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String? @db.Text

  kind PayrollDeductionKind @default(STATUTORY)

  /// Shown as an addition to gross (`house`, `transport`, `medical`) or taken off
  /// it (`pension`, `union`, `garnishee`). Defaults to a deduction because the
  /// component table exists mostly for the things that come off a payslip.
  direction PayrollLineDirection @default(EMPLOYEE_DEDUCTION)

  /// Whether this component is part of taxable pay, of contributable pay, or of
  /// neither, in the jurisdiction this row belongs to. The three answers genuinely
  /// differ — a housing benefit is commonly taxable but not contributable — which
  /// is why one boolean cannot express it.
  isTaxable     Boolean @default(true)
  isPensionable Boolean @default(true)

  countryCode String? @db.Char(2)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees    EmployeeComponent[]
  payslipLines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code, countryCode])
  @@index([organizationId])
  @@map("pay_components")
}

/// Which side of the payslip a line sits on.
enum PayrollLineDirection {
  /// Adds to gross (an allowance).
  EARNING

  /// Taken off gross, borne by the employee (PAYE, a pension contribution).
  EMPLOYEE_DEDUCTION

  /// The employer's own cost. Never affects net pay — it appears on the payslip
  /// because employees are entitled to see the total cost of employing them, and
  /// because it is what the journal entry debits.
  EMPLOYER_CONTRIBUTION
}

/// An employment record, and optionally the person who logs in.
///
/// `userId` is optional and the relation is one-to-one, which handles the two
/// cases the model has to survive: a caretaker on the payroll with no login at
/// all, and a property manager who is both an employee and holds a role granting
/// far more than self-service.
model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Unique per organization, and human-quotable — it goes on a payslip.
  employeeNumber String

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName       String
  lastName        String
  /// What they actually go by. Printed on a payslip instead of a legal name that
  /// they do not use, because a payslip is read by the person it pays.
  preferredName   String?
  preferredLocale String? @db.VarChar(35)

  /// Free text, exactly like `PurchaseRequest.department`: there is no
  /// departments table and inventing one for a label is a second org-wide concept
  /// for no reporting gain. Free-text reporting across departments is a reporting
  /// problem with a real answer, and it is not a schema problem.
  department String?
  jobTitle   String?

  employmentType  EmploymentType @default(FULL_TIME)
  hireDate        DateTime
  /// Set rather than deleting on departure, for the same reason inventory items are
  /// retired: payslips and leave history reference this row, and "no longer
  /// employed here" is a fact worth keeping.
  terminationDate DateTime?

  // ── Compensation ────────────────────────────────────────────────────────
  //
  // The most sensitive fields in this schema. Read them only under
  // `employees.compensation`, never under the plain `employees.view` that a
  // directory listing needs, and never include them in an export that a
  // lower-privileged role can request. A salary leak is not recoverable by
  // apologising.
  basicSalary    Decimal @db.Decimal(14, 2)
  /// ISO-4217. Per employee, not per organization, because a Nairobi group paying
  /// a remote contractor in euros needs it and a single org currency would force
  /// one of the two to be wrong.
  salaryCurrency String  @default("KES")

  payFrequency   PayFrequency @default(MONTHLY)
  /// How many pay periods a year. Overridden by the rule when the rule is
  /// ANNUALISED, so a weekly-paid employee on annual income tax is taxed on
  /// 52 weeks, not 12 months — the two are materially different amounts.
  periodsPerYear Int          @default(12)

  // ── Statutory identifiers ───────────────────────────────────────────────
  //
  // Jurisdiction-specific and therefore free-text. "National ID", "NIN", "SIN",
  // "National Insurance Number" and "CPF" are the same field with five names, and
  // a two-letter enum of them would mean a migration every time the company hires
  /// in a new country.
  nationalId           String?
  taxNumber            String?
  socialSecurityNumber String?

  bankAccount String?
  bankName    String?
  bankBranch  String?
  bankCode    String?

  address String? @db.Text
  phone   String?
  email   String?

  leavePolicyId String?
  leavePolicy   LeavePolicy? @relation(fields: [leavePolicyId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  components    EmployeeComponent[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([department])
  @@index([userId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum PayFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// One employee's standing amount for one component.
///
/// An employee's pension contribution is 5% *of their own salary* but the
/// employer's 10% is capped at a statutory ceiling, and neither rate is
/// universal — so the standing arrangement is a row per employee per component,
/// not a column on `Employee`. An employee with no row for a component is simply
/// not on that component.
model EmployeeComponent {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payComponentId String
  payComponent   PayComponent @relation(fields: [payComponentId], references: [id], onDelete: Cascade)

  /// Percent of the base for a percentage component, or the amount for a fixed
  /// one. Null means "whatever the component's default is", which keeps the
  /// common case to one row per component.
  percentage Decimal? @db.Decimal(7, 4)
  amount     Decimal? @db.Decimal(14, 2)

  currency String @default("KES")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, payComponentId, effectiveFrom])
  @@index([employeeId])
  @@map("employee_components")
}

/// How much leave somebody gets, and the rules around using it.
///
/// Statutory entitlement varies enormously between countries — some have no
/// federal minimum at all, some mandate 20 days, one East African country
/// mandates 21 and rises to 28 after five years — so it is configuration reached
/// by jurisdiction, with an organization override. Hardcoding 21 would be
/// hardcoding one country into a product that is explicitly not about one country.
model LeavePolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code String
  name String

  countryCode String? @db.Char(2)
  regionCode  String?

  /// Working days per year. Fractional so an employer granting 22.5 covers the
  /// half-day that half the workforce will take.
  annualEntitlementDays Decimal @db.Decimal(5, 2)

  /// How much unused entitlement may carry into next year. Statutory caps are
  /// usually lower than the entitlement and sometimes zero, and a policy that
  /// models one without the other lets leave accumulate without limit.
  carryoverLimitDays Decimal? @db.Decimal(5, 2)

  /// Notice required in working days, and whether it is waived for short absence.
  minNoticeDays       Int @default(0)
  minNoticeWaivedDays Int @default(1)

  /// Whether an absence may be taken as unpaid. Most jurisdictions distinguish
  /// this, and refusing unpaid leave outright is not something an employer
  /// decides for itself.
  unpaidAllowed Boolean @default(true)

  /// Whether a request longer than this needs a different approval. Null = no
  /// longer-request rule.
  maxConsecutiveDays Int?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([countryCode])
  @@map("leave_policies")
}

/// A public holiday for a jurisdiction, or an organization's own closure.
model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null = an organization's own day (a founder's funeral, a shutdown).
  /// Set = the public holidays of a jurisdiction, inherited by everybody operating
  /// there — which is why the same row serves many organizations and why an
  /// organization's own entry can override it by matching the date.
  countryCode String? @db.Char(2)
  regionCode  String? @db.VarChar(10)

  date DateTime
  name String

  /// Whether it repeats on the same day each year. A country's New Year does; a
  /// one-off public holiday does not, and treating the recurring kind as recurring
  /// is why "public holidays" tables go wrong two years in.
  isRecurring Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([date])
  @@index([countryCode])
  @@map("holidays")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  ADOPTION
  BEREAVEMENT
  COMPENSATORY
  OFFICIAL

  /// Time owed to the employee for work done outside normal hours. A distinct
  /// type because it is earned rather than granted, and it is frequently
  /// time-limited by law.
  OFF_DUTY
}

/// A request to be away.
///
/// `workingDays` is **derived**, never stored as a number the caller typed: it is
/// the working days between the two dates given the organization's weekend days
/// and the public holidays in force, and a hand-typed 5 that disagrees with the
/// dates is a rejected request with no obvious reason.
model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @default(ANNUAL)

  startDate DateTime
  endDate   DateTime

  reason String? @db.Text

  status       LeaveStatus @default(PENDING)
  /// The employee may withdraw their own request; only an approver can reject it.
  /// "Cancelled" and "Rejected" are different facts and the audit trail has to be
  /// able to tell them apart.
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?     @db.Text

  /// Set when approval ran through Module 18's engine, so the approval history is
  /// the engine's record and not a second copy of it here.
  workflowInstanceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// One payroll run: a group of payslips for one period, one approval and one
/// journal entry.
///
/// The run exists because a payroll is approved and posted as a unit. Calculating
/// twelve payslips that can then be approved one at a time is how a company ends
/// up paying a quarter of its staff and not the rest.
model PayrollRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A stable human reference like `PR-2026-03`, so a payslip in a dispute can be
  /// quoted without exposing an id.
  reference String

  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime

  currency String @default("KES")

  status PayrollRunStatus @default(DRAFT)

  /// Snapshotted at calculation time so a payslip explains itself years later
  /// without re-running a rule that has since been superseded.
  rulesApplied Json?

  /// The journal entry this run posted, so it can be reversed by reference.
  journalEntryId String?

  calculatedAt   DateTime?
  calculatedById String?
  approvedAt     DateTime?
  approvedById   String?
  paidAt         DateTime?
  paidById       String?

  /// Why a run was voided. A voided run keeps its payslips: it happened, it was
  /// wrong, and replacing it silently would make the two indistinguishable.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?   @db.Text

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([status])
  @@map("payroll_runs")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID

  /// Superseded before payment, or after. Not deletable — see `voidReason`.
  VOID
}

/// One employee's payslip within a run.
///
/// **The gross, deduction and net figures are not columns.** They are the sum of
/// this payslip's own `PayslipLine` rows, computed on read by
/// `payroll-calc.ts`, for the same reason Module 11 stores no stock level: a stored
/// net that can disagree with gross minus deductions is precisely the bug, and it
/// is the one nobody catches until a tax audit.
///
/// What *is* stored is the evidence — the input salary and the frozen line rows —
/// and `rulesApplied` on the run records which rules produced it, so a payslip
/// three years old still explains itself without re-running a rule that has since
/// been replaced.
model Payslip {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime

  currency String @default("KES")

  /// The contractual base for the period, before anything else. An input, not a
  /// total.
  basicSalary Decimal @db.Decimal(14, 2)

  /// The jurisdiction's rules in force when this was calculated, and the locale
  /// the payslip was rendered in. The locale is snapshotted because a payslip is a
  /// document and its format has to stay the format it was issued in.
  rulesApplied Json?
  locale       String? @db.VarChar(35)

  lines PayslipLine[]

  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([organizationId])
  @@index([employeeId])
  @@map("payslips")
}

/// One line of a payslip: an earning, an employee deduction, or an employer cost.
///
/// Rows, not a single `deductions` figure. A payslip that says "gross 100,000,
/// deductions 25,000, net 75,000" cannot be explained to the employee who asks
/// why, cannot be split into statutory and voluntary for the ledger, and cannot
/// be reconciled against a remittance advice line by line.
model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  direction PayrollLineDirection

  code String
  name String

  amount Decimal @db.Decimal(14, 2)

  kind PayrollDeductionKind @default(STATUTORY)

  /// The rule that produced it, when a rule did. Null for a line that is simply
  /// the employee's salary or a hand-entered component.
  payrollRuleId String?
  payrollRule   PayrollRule? @relation(fields: [payrollRuleId], references: [id], onDelete: SetNull)

  payComponentId String?
  payComponent   PayComponent? @relation(fields: [payComponentId], references: [id], onDelete: SetNull)

  /// Where this line goes in the ledger. Copied from the rule at calculation time
  /// so the entry does not have to re-resolve rules that may since have changed.
  accountCode String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([payslipId])
  @@index([payrollRuleId])
  @@map("payslip_lines")
}


// ============================================
// FACILITIES (Module 13)
// ============================================

/// What a bookable thing *is*, for the screens that group and filter them.
///
/// An enum rather than the free text the module doc sketched
/// (`facilityName String // clubhouse, meeting room, parking slot`), because the
/// same problem `Property.type` had: free text cannot answer "show me every
/// bookable room on this estate", and a gym that gets typed as "Gym", "gymnasium"
/// and "fitness centre" is three facilities to the API and one to the person who
/// runs the place. `OTHER` is the honest escape hatch — a Japanese bath house is
/// still a facility, it just has no slot in this list yet.
enum FacilityKind {
  CLUBHOUSE
  MEETING_ROOM
  PARKING
  GYM
  POOL
  TENNIS_COURT
  LAUNDRY
  RECREATION
  OTHER
}

/// A bookable thing a property owns: the clubhouse, a meeting room, a parking bay.
///
/// The module doc put `facilityName String` on the booking. That is a booking with
/// a name typed into it and no facility behind it, which cannot answer "when is
/// the clubhouse free", cannot carry opening hours, and cannot refuse a booking
/// that overlaps one somebody else holds. So the facility is its own row and the
/// booking points at it — which is also what makes a *schedule* possible at all.
model Facility {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name String
  kind FacilityKind @default(OTHER)

  description String? @db.Text

  /// How many people it takes. Advisory rather than enforced on a resident's own
  /// booking — a swimming pool with a capacity of 8 would be refused by anybody
  /// bringing 9 people — but the booking screen shows it, because "the room seats
  /// 12" is the fact that stops the mistake.
  capacity Int?

  /// Opening hours as **minutes from local midnight**, not a timestamp.
  ///
  /// A facility is open at 08:00 on every day it exists; storing that as two
  /// `DateTime`s means storing today's date too, and then the row is wrong
  /// tomorrow. Minutes also mean a 24-hour facility (a car park) needs no
  /// overnight special case, which a `opensAt`/`closesAt` pair on a clock cannot
  /// express without one. The property's local time is the organization's
  /// `timezone`; no second timezone column, because two answers to "what time is
  /// it here" is worse than one.
  opensAtMinutes  Int @default(480)  // 08:00
  closesAtMinutes Int @default(1320) // 22:00

  /// The grid a booking snaps to. A 60-minute facility means "10:00 or 11:00", a
  /// 15-minute one means "10:00, 10:15, 10:30". This is a property of the
  /// facility rather than of each booking because it is the unit the *diary* is
  /// drawn in — a grid nobody agreed on produces a diary that is not bookable.
  slotMinutes Int @default(60)

  /// How far ahead a booking may be taken. Without it, "this Sunday at 3am" is a
  /// legitimate request against a facility that opens at 08:00, and the refusal
  /// has to come from somewhere.
  maxAdvanceDays Int @default(90)

  /// A resident's booking waits for somebody to say yes. Staff booking on behalf
  /// of somebody is confirmed immediately, because there is already a person in
  /// the decision rather than a queue behind one.
  requiresApproval Boolean @default(false)

  /// A facility nobody may book (a staff store, a plant room registered so its
  /// access cards have something to point at).
  isBookable Boolean @default(true)

  /// Charged per booking, and **recorded but not yet invoiced**.
  ///
  /// The figure is snapshotted onto the booking at creation, the same reason
  /// `OwnerStatement` freezes its lines: a facility whose fee changes next month
  /// must not retroactively change what last month's booking said it cost. What
  /// is deliberately absent is the invoice — see the module doc's open items;
  /// billing a fee through `InvoicesService` is a Finance change, and a facilities
  /// module that quietly wrote an invoice would put a money document behind a
  /// permission that has nothing to do with money.
  bookingFee        Decimal? @db.Decimal(12, 2)
  bookingFeeCurrency String?

  notes String? @db.Text

  isActive Boolean @default(true)

  bookings  FacilityBooking[]
  blackouts FacilityBlackout[]
  accessCards AccessCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique per property rather than per organization: two towers in one estate
  /// may each have a "Clubhouse", and they are not the same room.
  @@unique([propertyId, name])
  @@index([organizationId])
  @@index([propertyId])
  @@index([kind])
  @@map("facilities")
}

enum FacilityBookingStatus {
  /// Waiting for somebody to decide. Only reachable on a facility that requires
  /// approval, and only for a request that did not come from staff.
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  /// Confirmed, the slot has passed, and nobody turned up.
  ///
  /// There is deliberately no COMPLETED: a booking is not "completed" by an
  /// action, it is over when the clock says so, and a state somebody has to set
  /// by hand is a state that rots. "Has this already happened" is derived on read
  /// from `endsAt`. NO_SHOW is different because it *is* a decision — somebody has
  /// to look at an empty room and say so — and because it is the fact a repeat
  /// booking is judged on.
  NO_SHOW
}

/// One reserved slot on one facility.
model FacilityBooking {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// Human-quotable, printed on the day sheet. Sequential within the facility's
  /// property so the front desk can say "that's FB-0007" and mean one row.
  reference String

  // ── Who asked, and who the slot is for ───────────────────────────────────
  //
  // Two different people, and collapsing them is the mistake this shape avoids: a
  // property manager books the clubhouse *for* a resident, and a resident books it
  // for themselves. `bookedByUserId` is who pressed the button — always a staff
  // login, or null when a resident did it through the portal. The three subject
  // columns are who the room is for, and any of them may be null because the
  // answer is sometimes "a guest of the family at B4, and we do not have their
  // details", which is why `bookedForName` is required rather than derived.
  bookedByUserId String?
  bookedByUser   User?   @relation("UserMadeFacilityBookings", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation("ContactFacilityBookings", fields: [contactId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation("TenantFacilityBookings", fields: [tenantId], references: [id], onDelete: SetNull)

  /// What the day sheet says. Snapshotted from the contact or tenant when the
  /// caller did not supply one, so a later name change does not rewrite history.
  bookedForName  String
  bookedForPhone String?

  purpose       String?
  attendeeCount Int?

  // ── The slot ────────────────────────────────────────────────────────────
  //
  // Half-open, `[startsAt, endsAt)`: a booking that ends at 12:00 and one that
  // starts at 12:00 do not conflict. The alternative is a one-minute overlap
  // guard on every comparison, which is exactly the kind of thing that is right
  // in one code path and forgotten in another. `endsAt` is **derived** from
  // `startsAt` and the facility's slot grid rather than accepted from the caller
  // — see `booking-slots.ts`.
  startsAt DateTime
  endsAt   DateTime

  status        FacilityBookingStatus @default(PENDING)
  decisionNote  String?

  decidedAt     DateTime?
  decidedByUserId String?
  decidedByUser   User?   @relation("UserDecidedFacilityBookings", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  cancelledAt   DateTime?
  cancelReason  String?

  /// The fee this booking was accepted at. See `Facility.bookingFee`.
  fee         Decimal? @db.Decimal(12, 2)
  feeCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, reference])
  @@index([organizationId])
  @@index([facilityId, startsAt])
  @@index([status])
  @@map("facility_bookings")
}

/// A period in which a facility cannot be booked at all.
///
/// The counterpart to a booking, and the reason a booking cannot be made for that
/// period either. Without it, "the clubhouse is being repainted" lives in somebody's
/// head and the slot gets sold twice.
model FacilityBlackout {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// Required, and not merely good manners: a closure with no stated reason is
  /// indistinguishable from a mistake, and the next person to look at it cannot
  /// tell whether it is safe to lift.
  reason String

  startsAt DateTime
  endsAt   DateTime

  createdByUserId String?
  createdByUser   User?   @relation("UserFacilityBlackouts", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([facilityId, startsAt])
  @@map("facility_blackouts")
}

/// What an access card opens.
enum AccessCardType {
  BUILDING
  UNIT
  PARKING
  FACILITY
  GATE
}

/// Who is holding the card.
///
/// Separate from the three nullable holder columns on purpose: `holderType` says
/// which of them is the one that matters, so a query for "every card a resident
/// holds" is a filter rather than an OR across three nullable FKs — and so a card
/// with no holder at all is a legitimate state (a spare, kept at the gate) rather
/// than a data error.
enum AccessCardHolder {
  STAFF
  TENANT
  CONTACT
  VISITOR
  NONE
}

enum AccessCardStatus {
  ACTIVE
  /// Temporarily off: a card reported in the wrong pocket, a dispute over a bill.
  /// Reactivable, and the only non-terminal state besides ACTIVE.
  SUSPENDED
  /// Reported lost. Not reactivated — a lost card is replaced by a new one, and
  /// silently reissuing the same number to a new holder is how a building ends up
  /// with two people who both hold "card 014".
  LOST
  /// Past `expiresAt`. Derived on read, and settable by hand for the contractor
  /// whose visa ran out before the card did.
  EXPIRED
  /// Deliberately ended by the organization. Terminal, and the reason must be
  /// recorded — this is the row somebody asks about after a dispute.
  REVOKED
}

/// An access card: a fob, a key card, a gate sticker.
///
/// **Data tracking only, no hardware.** The module doc left this as an explicit
/// v1 decision and it is the right one: every reader integration is vendor-
/// specific, and a table whose only job is to say who holds what and when it
/// stops being valid is useful on its own — it answers "who can get into B4 after
/// the contractor leaves on Friday", which is the question that is actually asked.
/// `lastSeenAt` exists so that when a reader *is* added, the column is already
/// there and does not need a migration in the middle of an integration.
model AccessCard {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Unique within the organization, not globally: card numbers come off a
  /// printer per estate and two estates legitimately both start at 0001.
  cardNumber String

  type     AccessCardType   @default(BUILDING)
  status   AccessCardStatus @default(ACTIVE)
  holder   AccessCardHolder @default(NONE)

  // ── What it opens ───────────────────────────────────────────────────────
  //
  // At least one of these, checked by the service. Which one is required depends
  // on `type` — a UNIT card with no unit opens nothing, which is a card that
  // looks valid in a list and fails at the gate.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // ── Who holds it ────────────────────────────────────────────────────────
  userId String?
  user   User?   @relation("UserAccessCards", fields: [userId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation("TenantAccessCards", fields: [tenantId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation("ContactAccessCards", fields: [contactId], references: [id], onDelete: SetNull)

  /// A temporary card handed to somebody who has no relationship with us — the
  /// reason `AccessCardHolder.VISITOR` exists as a value at all. Null for every
  /// other holder type; the service refuses a visitor card with no visitor,
  /// because a card that says VISITOR and names nobody is a card that cannot be
  /// withdrawn from anybody.
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)


  /// What the guard reads off the card. Snapshotted from the holder for the same
  /// reason `FacilityBooking.bookedForName` is: a card that says the name of the
  /// person who held it last term is a security problem, and a card with no name
  /// on it is refused at the gate.
  holderName String

  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  /// Set by hand today, populated by a reader when one exists. See the note above.
  lastSeenAt DateTime?

  suspendedAt       DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  replacementCardId String? // the card issued after this one was reported lost

  notes String? @db.Text

  visits VisitorVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cardNumber])
  @@index([organizationId])
  @@index([status])
  @@index([holder])
  @@index([unitId])
  @@map("access_cards")
}

/// A person who comes to the gate.
///
/// A table, not a free-text field on the visit, and the reason is the whole
/// purpose of a visitor log: a name typed onto yesterday's row cannot be
/// answered "have we had this person before" or "are they on the barred list".
/// Both of those are questions about a *person*, and a person with one row is
/// what makes them answerable.
model Visitor {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  phone String?
  email String?

  company String?

  /// What the gate actually checks. Deliberately one free-text `idType` and one
  /// free-text `idNumber` rather than an enum of national ID types: "National
  /// ID", "NIN", "SIN", "passport" and "CPF" are five names for a check that is
  /// the same shape in every country, and an enum of them would mean a migration
  /// every time the company hires a guard in a new one. The same reasoning as
  /// `Employee.nationalId`.
  idType   String?
  idNumber String?

  /// Link to the shared people directory when this visitor is somebody we already
  /// deal with — a contractor, a buyer's agent. A walk-in stays unlinked.
  contactId String?
  contact   Contact? @relation("VisitorContact", fields: [contactId], references: [id], onDelete: SetNull)


  /// Barred from the site.
  ///
  /// A flag rather than a separate list, because a barred person still visits in
  /// the sense that they are still turned away at the gate — and a separate list
  /// is a second place to forget. A bar requires a reason, for the same reason a
  /// blackout does: "do not admit" with nothing behind it is indistinguishable
  /// from an error, and it is the decision somebody will be asked to justify.
  isBlacklisted     Boolean @default(false)
  blacklistedAt     DateTime?
  blacklistReason   String?

  notes String? @db.Text

  isActive Boolean @default(true)

  visits      VisitorVisit[]
  accessCards AccessCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([phone])
  @@index([isBlacklisted])
  @@map("visitors")
}

/// One arrival.
///
/// State is **derived from the two timestamps** rather than stored as an enum:
/// `checkedInAt`/`checkedOutAt` is the fact, and "is this person still on site"
/// or "who overstayed" is a comparison against the clock. An enum would be a
/// fourth thing that can disagree with the two timestamps it was supposed to
/// describe — the exact failure this codebase has now fixed in six other places
/// (invoice money columns, stock levels, received quantities, owner statement
/// lines, received quantities, derived `overdue` on work orders).
model VisitorVisit {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Restrict)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // ── Who they are here to see ────────────────────────────────────────────
  //
  // `hostName` is required for the same reason `Visitor.holderName` is: the gate
  // log is read by somebody who needs a name, not a foreign key they would have
  // to resolve. Snapshotted from whichever host was given.
  tenantId String?
  tenant   Tenant? @relation("HostTenantVisits", fields: [tenantId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation("HostContactVisits", fields: [contactId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("HostUserVisits", fields: [userId], references: [id], onDelete: SetNull)

  hostName  String
  hostPhone String?

  purpose String?

  /// When they are due. Defaults to now, because the common case is a person at
  /// the gate rather than an appointment made yesterday.
  expectedAt DateTime @default(now())

  /// When they are due to leave. What "overstayed" is measured against; null
  /// means they are not expected to leave on their own.
  expectedOutAt DateTime?

  checkedInAt  DateTime?
  checkedOutAt DateTime?

  /// Pre-authorised before arrival — the contractor with a job this week, the
  /// family of a resident who called ahead. Recorded separately from
  /// `checkedInAt` because "was this expected" and "did they arrive" are
  /// different questions.
  preApprovedByUserId String?
  preApprovedByUser   User?   @relation("UserPreApprovedVisits", fields: [preApprovedByUserId], references: [id], onDelete: SetNull)

  /// A card handed over at the gate, if one was.
  accessCardId String?
  accessCard   AccessCard? @relation(fields: [accessCardId], references: [id], onDelete: SetNull)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

@@index([organizationId])
  @@index([visitorId])
  @@index([expectedAt])
  @@index([checkedOutAt])
  @@map("visitor_visits")
}

// ============================================
// UTILITIES (Module 14)
// ============================================

/// What a meter measures.
///
/// `WATER` / `ELECTRICITY` are the two the module doc named and the two Kenya
/// estates actually recover cost on. `GAS` is in the doc and is kept. `SEWAGE` is
/// added because on most Kenyan estates sewerage is charged separately from
/// water and is very often on a bulk meter - the tenant never sees a water
/// volume, only a fixed charge, which is exactly the case a `WATER` meter row
/// cannot represent honestly.
enum UtilityType {
  WATER
  ELECTRICITY
  GAS
  SEWAGE
}

/// Which unit a meter feeds, and for a bulk meter, how that feed is divided.
///
/// This enum exists because "has no `unitId`" is ambiguous. A meter with no unit
/// is either a *bulk* meter - the one Kenya Water or Kenya Power installed on
/// the riser that the estate then re-sells - or a meter that simply has not been
/// allocated to a unit yet. Those are different states with different
/// consequences, and a nullable foreign key cannot tell you which you have.
///
/// Splitting the water bill twenty ways is a *decision*, not a computation: area,
/// headcount, occupancy days and a negotiated fixed split are all defensible and
/// all produce different bills. So the method is stored as data and the module
/// refuses to bill a bulk meter until the estate has chosen one, rather than
/// picking a default and quietly overcharging somebody every month.
enum MeterScope {
  /// Serves exactly one unit. Consumption is that unit's bill, undivided.
  SUBMETER
  /// Serves many units through the estate. Must have an apportionment method.
  BULK
}

/// How a bulk meter's consumption is divided across the units it feeds.
enum ApportionmentMethod {
  /// By `Unit.areaSqFt`. A 90 sqm unit in a shared meter pays for 90 sqm.
  AREA
  /// Split evenly between the units fed, regardless of size.
  EQUAL
  /// By days of occupancy in the billing period, so a unit that moved in
  /// mid-month pays for the part of the month it was there.
  OCCUPANCY
  /// A negotiated split held in `UtilityMeter.apportionmentWeights`, keyed by
  /// unit id. The escape hatch when the other three are all unfair.
  MANUAL
}

/// A physical utility meter.
///
/// The module doc sketched `UtilityMeter` with `unitId` required and nothing
/// else, which models only the easy case: one meter, one unit, read it, bill
/// that unit. The pre-existing `UnitMeterNumber` table had the same blind spot -
/// a `meterNo` and a `readingSetup` string and no type, no property, no readings
/// and no rate - and it held zero rows, because a schema that cannot answer
/// "who paid for this water" gets no data.
///
/// So the table is reshaped rather than duplicated. Two "meter" tables is how an
/// estate ends up with two halves of the truth and no way to reconcile them -
/// the same failure the master doc records for `Supplier`.
///
/// The corrections that matter:
///
/// - `propertyId` is required, not `unitId`. A meter is a device bolted to a
///   building; that is where it lives even when it is a sub-meter inside a flat.
///   It is also what makes "every meter on this estate" answerable, and it is
///   how the module scopes a query at all - `Unit` carries no `organizationId`
///   (master doc issue 25), so a meter scoped only by unit would need a join
///   through `unit.property.organizationId` on every read.
/// - `unitId` is nullable and paired with `scope`, because bulk meters feed many
///   units and have no single one.
/// - `type` distinguishes the utilities that share a table but not a tariff.
/// - `digits` and `digitWrapAt` carry meter rollover (see `MeterReading`).
model UtilityMeter {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Set only for `SUBMETER`. Null for `BULK` by definition.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  type        UtilityType
  meterNumber String
  /// Serial/asset tag of the device, distinct from the number the utility
  /// company bills against.
  serialNumber String?

  /// How the reading is collected. `MANUAL` is v1 per the module doc; smart
  /// meter integration is a later phase, and `SMART` exists so those rows are
  /// distinguishable from day one rather than indistinguishable from manual ones
  /// once an integration lands.
  source MeterReadingSource @default(MANUAL)

  scope         MeterScope           @default(SUBMETER)
  /// Required when `scope = BULK`, null for a sub-meter. Enforced in the
  /// database - see the `utility_meters_bulk_needs_method` check constraint.
  apportionmentMethod ApportionmentMethod?
  /// `MANUAL` split, unit id -> weight. Only consulted when
  /// `apportionmentMethod = MANUAL`.
  apportionmentWeights Json?

  /// Digits on the meter's register, and the value the register returns to zero
  /// (i.e. `10 ** digits`). Null disables rollover handling, so the vast
  /// majority of meters - which are read as plain increasing numbers - need no
  /// special handling and cannot be mis-handled by it.
  digits       Int?
  digitWrapAt  Int?

  /// Last date this meter's figures were confirmed against the utility company's
  /// own bill. What tells you whether a suspicious consumption spike is a
  /// re-read or a leak.
  lastBilledThrough DateTime?

  status MeterStatus @default(ACTIVE)

  /// Carried over verbatim from the `UnitMeterNumber` table this replaces. It
  /// records how the reading is taken - direct, bulk-and-divided, estimated -
  /// which is the same idea as `apportionmentMethod` and predates it. Kept
  /// rather than dropped because it was somebody's deliberate signal about
  /// intended functionality.
  readingSetup String?

  readings  MeterReading[]
  rates     UtilityRate[]
  charges   UtilityCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A meter number is issued by the utility company and is unique per utility
  /// within an organization. Without this the estate can register the same
  /// physical meter twice and read both copies - the failure mode that makes a
  /// building's consumption look like double what it is.
  @@unique([organizationId, type, meterNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([type, status])
  @@map("utility_meters")
}

enum MeterStatus {
  ACTIVE
  /// Stopped reading (removed, failed, replaced). Kept, not deleted, so historic
  /// readings still explain the invoices that quoted them.
  RETIRED
}

/// How a reading was captured.
///
/// `SMART` is declared now for the integration the module doc defers to a later
/// phase. `ESTIMATED` exists because a genuine case has no honest reading: the
/// meter could not be read (access denied, sealed, tenant away). Estimating is
/// the standard industry response, and marking the row is what lets a later
/// audit tell an estimate from a real reading instead of silently guessing.
enum MeterReadingSource {
  MANUAL
  SMART
  ESTIMATED
}

/// The register value observed at a moment in time.
///
/// The module doc stored `previousReading` and `currentReading` and called the
/// difference "consumption". That stores a derived number and lets it drift:
/// correct one of the two readings and the delta silently disagrees. So a
/// reading stores the *index it showed* and nothing else; `previousReading` and
/// `consumption` are derived on read by pairing a reading with the one before
/// it. The doc's two columns are still what the API returns - they are a
/// presentation of the pair, not a stored fact.
model MeterReading {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  meterId String
  meter   UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  readingDate DateTime
  /// The value on the register at `readingDate`.
  reading     Decimal @db.Decimal(12, 2)

  source MeterReadingSource @default(MANUAL)
  note   String?

  recordedByUserId String?
  recordedBy       User?   @relation("UserMeterReadings", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  chargesAsOpening UtilityCharge[] @relation("ChargeOpeningReading")
  chargesAsClosing UtilityCharge[] @relation("ChargeClosingReading")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One reading per meter per day. Two readings of the same meter on the same
  /// day is either a correction - which is an `update`, not a second row - or a
  /// double entry that would double-bill the period. This is the reading-side
  /// twin of `utility_charges_no_double_bill`: the database refuses it, and the
  /// service names the conflict.
  @@unique([meterId, readingDate])
  @@index([organizationId])
  @@index([meterId, readingDate])
  @@index([readingDate])
  @@map("meter_readings")
}

/// What one unit of a utility costs, over a period of validity.
///
/// The module doc's formula is "reading delta x rate" and it names no table for
/// the rate, so the acceptance criterion cannot be met without one. Rates are
/// data with a validity window for the same reason `TaxRule` (Module 7) and
/// `PayrollRule` (Module 12) are: tariffs change, and a bill raised in March
/// must still be explicable after the tariff changes in April.
///
/// Specificity is most-specific-wins: a meter-specific rate beats a
/// property-wide rate, which beats the organization default. Resolution picks one
/// and snapshots it onto the charge, so a later tariff change cannot retroactively
/// reprice history.
model UtilityRate {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Most-specific-wins scope. All three null = the organization default.
  meterId    String?
  meter      UtilityMeter? @relation(fields: [meterId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type     UtilityType
  currency String @default("KES") // ISO 4217, e.g. KES, USD

  /// Price of one unit of consumption. `Decimal(12, 4)` because a tariff can be
  /// quoted to more than two decimals (a gas tariff per MMBtu, a water tariff per
  /// 1000 litres) and truncating to cents at the rate would quietly move money.
  ratePerUnit Decimal @db.Decimal(12, 4)
  /// Fixed component charged per billing period regardless of consumption. Zero
  /// for a pure usage tariff.
  standingCharge Decimal @default(0) @db.Decimal(12, 2)
  /// Whether `standingCharge` is prorated when a period is not a full month.
  prorateStandingCharge Boolean @default(false)

  /// ISO 4217 of the money the *utility company* bills in, distinct from the
  /// currency the resident is billed in.
  purchaseCurrency String? @default("KES")
  spotRate Decimal? @db.Decimal(12, 4)

  vatRate       Decimal? @db.Decimal(5, 2)
  incomeAccount String?
  /// `INCOME_ACCOUNTS` "3" - Utility Income. Free text, matching the rest of the
  /// ledger-facing classification in this schema.
  revenueExpenseItem String?

  validFrom DateTime
  /// Null = current. A tariff is superseded by closing the old row and opening a
  /// new one; the row is never edited in place, so an old invoice's rate is
  /// still readable.
  validTo DateTime?

  charges UtilityCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type, validFrom])
  @@index([meterId])
  @@index([propertyId])
  @@map("utility_rates")
}

/// One billable utility event: this unit consumed this much, at this rate, for
/// this period.
///
/// This row is the module's audit spine and its idempotency anchor. Consumption
/// is derived from the two readings it references, and the amount is derived from
/// consumption and the snapshotted rate - but the *inputs* (which readings,
/// which rate, which share of a bulk meter, which currency) are stored, because a
/// calculation you cannot reconstruct is not an audit trail.
///
/// `@@unique([meterId, unitId, billingPeriod])` is the load-bearing constraint of
/// the whole module: billing the same meter to the same unit for the same period
/// twice is the one error that hands a resident two bills for one month's water.
/// It is in the database rather than in a `findFirst` because two concurrent
/// requests both pass a `findFirst`.
model UtilityCharge {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  meterId String
  meter   UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  /// Who is billed. Equals `meter.unitId` for a sub-meter; for a bulk meter it is
  /// the unit this share of the meter belongs to.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// Rental agreement the invoice goes to. Null when the unit is vacant, which is
  /// a legitimate state for a bulk meter - nobody is there to pay for the water.
  rentalAgreementId String?
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  /// The two readings that bound the period. Consumption is the difference
  /// between them, derived - see `MeterReading`.
  fromReadingId String
  fromReading   MeterReading @relation("ChargeOpeningReading", fields: [fromReadingId], references: [id], onDelete: Restrict)
  toReadingId   String
  toReading     MeterReading @relation("ChargeClosingReading", fields: [toReadingId], references: [id], onDelete: Restrict)

  /// The rate in force for the period, snapshotted so repricing a tariff cannot
  /// rewrite history. Null when no rate could be resolved - which is refused at
  /// charge time, and so only reachable by hand-edited data.
  rateId String?
  rate   UtilityRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)
  ratePerUnit       Decimal @db.Decimal(12, 4)
  currency          String  @default("KES")
  spotRate          Decimal? @db.Decimal(12, 4)
  vatRate           Decimal? @db.Decimal(5, 2)
  incomeAccount     String?
  revenueExpenseItem String?

  /// The unit's share of the meter. `1` for a sub-meter; a fraction for a bulk
  /// meter apportioned by area, occupancy or manual weight. Stored because it is
  /// the one input that cannot be re-derived later: the units' areas and the
  /// occupancy dates they had at the time are not preserved.
  allocationShare Decimal @default(1) @db.Decimal(12, 6)
  /// `MANUAL` apportionment is a negotiated split; it is a business fact about
  /// who agreed to what, so it is preserved even though it is not a measurement.
  allocationBasis String?

  /// "2026-10" - the period this charge bills. Same `YYYY-MM` form as
  /// `Invoice.billingPeriod` so the two are comparable, but it is *not* written
  /// to the invoice: `invoices` carries
  /// `@@unique([rentalAgreementId, billingPeriod])` because a lease has one rent
  /// bill per month, and a utility invoice claiming that key would make the
  /// recurring rent run skip the month and the resident never get billed rent at
  /// all (recurring-billing.service.ts:45). So the utility bill is its own
  /// document, classified `transactionClass = 'UTILITY'`, the way the Sales
  /// module's invoices are classified `SALE`.
  billingPeriod String

  /// The invoice this charge was put on. One charge, one invoice - the FK
  /// points this way, not the reverse, because a lease's monthly bill collects
  /// several charges (water, electricity, a standing charge) on one document.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  status UtilityChargeStatus @default(PENDING)

  createdByUserId String?
  createdBy       User?   @relation("UserUtilityCharges", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Exactly-once billing per meter, per unit, per period.
  @@unique([meterId, unitId, billingPeriod])
  @@index([organizationId])
  @@index([billingPeriod])
  @@index([invoiceId])
  @@index([unitId])
  @@map("utility_charges")
}

enum UtilityChargeStatus {
  /// Consumption is priced but nothing has been billed yet.
  PENDING
  /// An invoice exists and carries this charge.
  INVOICED
  /// The charge was written off or reversed. The row stays, so the period still
  /// explains itself.
  VOID
}

