# Application
PORT=XXXX
NODE_ENV=development

# Comma-separated list of origins allowed to call the API via CORS.
# Example: CORS_ORIGINS=http://localhost:3007,https://app.tu-properties.co.ke
CORS_ORIGINS=

FRONTEND_URL="http://localhost:XXXX"

# How the session token reaches the browser: `cookie` (default) or `bearer`.
#
# `cookie` sets an httpOnly, SameSite=Strict cookie — the strongest option, but
# it only works when the frontend and this API are SAME-SITE (same registrable
# domain, e.g. properties.tuhame.co.ke + api-properties.tuhame.co.ke). A
# frontend on a different domain (a Vercel *.vercel.app deployment) is
# cross-site, and the browser will not send a Strict cookie across that
# boundary, so every authenticated request comes back 401.
#
# `bearer` returns the token in the login response instead; the client keeps it
# in localStorage and sends `Authorization: Bearer`. Works from any origin.
#
# Switch this when the deployment topology changes — no code change either way.
AUTH_MODE=cookie

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tu-properies?schema=public"

# JWT
JWT_SECRET="abcd1234wxyz"
JWT_EXPIRES_IN="7d"
# Module 3 CRM: shared secret for the unauthenticated lead-capture webhook
# (POST /crm/public/leads with header x-webhook-secret).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_ORGANIZATION_ID=
# Module 17 Notifications: key used to encrypt SMS provider credentials stored
# in the database (Twilio auth token, Africa's Talking API key). Set it once and
# keep it out of version control — losing it makes stored credentials
# unrecoverable, which is the point of encrypting them, and is why the admin
# panel lets a key be re-entered rather than only ever read back.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_CREDENTIALS_KEY=

# ── Demo data seed ────────────────────────────────────────────────────────────
# Read by `npm run db:seed:demo` and `npx prisma db seed` only. Leave every one
# of them unset and the seed behaves exactly as before.
#
# DEMO_COUNTRY — the *primary* market, by ISO-3166-1 alpha-2. It is the market
# that gets the two full demo organizations (Rohi with the whole dataset,
# Westhill as the starter). Every other market gets a market organization
# instead. Default: KE.
#
# DEMO_COUNTRIES — the markets to seed, comma-separated ISO-3166-1 alpha-2
# codes. Leave empty to seed every supported market:
#   KE ZA US GB CA AU DE FR IN CN JP KR BR MX AE
# (Africa is Kenya and South Africa only.) An unknown code fails the seed
# loudly rather than being silently skipped.
#
# DEMO_MODE=multi — additionally creates the "Global Properties International"
# organization with its London / New York / Nairobi / Dubai branches.
#
# DEMO_COUNTRY=KE
# DEMO_COUNTRIES=KE,ZA,US,GB,CA,AU,DE,FR,IN,CN,JP,KR,BR,MX,AE
# DEMO_MODE=
