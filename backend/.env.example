# Application
PORT=3003
NODE_ENV=development

FRONTEND_URL="http://localhost:3002"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tu-properies?schema=public"

# JWT
JWT_SECRET="abcd1234wxyz"
JWT_EXPIRES_IN="7d"
# Module 3 CRM: shared secret for the unauthenticated lead-capture webhook
# (POST /crm/public/leads with header x-webhook-secret).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_ORGANIZATION_ID=
# Module 17 Notifications: key used to encrypt SMS provider credentials stored
# in the database (Twilio auth token, Africa's Talking API key). Set it once and
# keep it out of version control — losing it makes stored credentials
# unrecoverable, which is the point of encrypting them, and is why the admin
# panel lets a key be re-entered rather than only ever read back.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_CREDENTIALS_KEY=
